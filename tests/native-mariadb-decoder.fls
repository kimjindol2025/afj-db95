;; AFJ-010 native COM_STMT_EXECUTE decoder unit.
(load "../src/mariadb-wire.fls")
(define payload
  (buf-concat [(buf-u8 23) (buf_u32le 1) (buf-u8 0)
               (buf-u8 0) (buf-u8 0) (buf-u8 0) (buf-u8 0)
               (buf-u8 0) (buf-u8 1)
               (buf-u8 3) (buf-u8 0)
               (buf-u8 7) (buf-u8 0) (buf-u8 0) (buf-u8 0)]))
(define types (mariadb-wire-read-types-at payload 12 0 1 []))
(define decoded (mariadb-wire-read-parameters-at payload 14 10 0 types []))
(define login-payload (buf-concat [(buf-u8 0) (buf-u8 2) (buf-u8 0) (buf-u8 0)]))
(define full-login-payload
  (buf-concat [login-payload
               (buf-u8 0) (buf-u8 0) (buf-u8 16) (buf-u8 0)
               (buf-u8 33)
               (buf-u8 0) (buf-u8 0) (buf-u8 0) (buf-u8 0) (buf-u8 0)
               (buf-u8 0) (buf-u8 0) (buf-u8 0) (buf-u8 0) (buf-u8 0)
               (buf-u8 0) (buf-u8 0) (buf-u8 0) (buf-u8 0) (buf-u8 0)
               (buf-u8 0) (buf-u8 0) (buf-u8 0) (buf-u8 0) (buf-u8 0)
               (buf-u8 0) (buf-u8 0) (buf-u8 0)]))
(define login-state (mariadb-wire-login-state full-login-payload))
(define auth-login-payload
  (buf-concat [full-login-payload
               (utf8-encode "root") (buf-u8 0) (buf-u8 20)
               (buf-u8 1) (buf-u8 2) (buf-u8 3) (buf-u8 4) (buf-u8 5)
               (buf-u8 6) (buf-u8 7) (buf-u8 8) (buf-u8 9) (buf-u8 10)
               (buf-u8 11) (buf-u8 12) (buf-u8 13) (buf-u8 14) (buf-u8 15)
               (buf-u8 16) (buf-u8 17) (buf-u8 18) (buf-u8 19) (buf-u8 20)]))
(define auth-login-state (mariadb-wire-login-state auth-login-payload))
(if (and (= (mariadb-wire-placeholder-count "SELECT * FROM t WHERE id=?") 1)
         (mariadb-wire-capability? 512 mariadb-client-protocol-41)
         (= (mariadb-wire-login-capabilities login-payload) 512)
         (= (get login-state "negotiated-capabilities") 512)
         (= (get login-state "max-packet-size") 1048576)
         (= (get login-state "charset") 33)
         (= (get auth-login-state "username") "root")
         (= (get auth-login-state "auth-response-length") 20)
         (= (mariadb-wire-bind "SELECT * FROM t WHERE id=?" [7])
            "SELECT * FROM t WHERE id=7")
         (= (get (get decoded "values") 0) 7))
  (println "afj-db95 native MariaDB decoder PASS")
  (throw "NATIVE_MARIADB_DECODER_FAILED"))
