;; Native product name LIKE COUNT fixture agreed in msg_e8e07f56a55f.
;; Both original products remain seeded; server COUNT bind %Gadget% must return one text0 row.
(load "../src/sha1.fls")
(define countlikegadget-control (env-get "AFJ_NATIVE_SHOP_PRODUCTS_COUNT_LIKE_GADGET_CONTROL"))
(define countlikegadget-connection (atom nil))
(define countlikegadget-buffer (atom ""))
(define countlikegadget-stage (atom "handshake"))
(define countlikegadget-sequence (atom 0))
(define countlikegadget-columns (atom []))
(define countlikegadget-rows (atom []))
(define countlikegadget-error (atom nil))
(define countlikegadget-done (atom false))
(define countlikegadget-statement (atom nil))

(defn countlikegadget-check [condition message]
  (if (= condition true) true (throw message)))

(defn countlikegadget-u32 [value]
  (buf-concat [(buf-u8 (rem value 256))
               (buf-u8 (rem (floor (/ value 256)) 256))
               (buf-u8 (rem (floor (/ value 65536)) 256))
               (buf-u8 (rem (floor (/ value 16777216)) 256))]))

(defn countlikegadget-read-u32 [bytes offset]
  (+ (buf-read-u8 bytes offset)
     (* 256 (buf-read-u8 bytes (+ offset 1)))
     (* 65536 (buf-read-u8 bytes (+ offset 2)))
     (* 16777216 (buf-read-u8 bytes (+ offset 3)))))

(defn countlikegadget-send [payload sequence next-stage response-sequence]
  (let [length (buf-len payload)
        frame (buf-concat [(buf-slice (countlikegadget-u32 length) 0 3)
                           (buf-u8 sequence) payload])]
    (reset! countlikegadget-stage next-stage)
    (reset! countlikegadget-sequence response-sequence)
    (countlikegadget-check (= (tcp-write (deref countlikegadget-connection) (buf-to-binary frame)) "ok")
                 "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_GADGET_PACKET_WRITE")))

(defn countlikegadget-command [code text next-stage]
  (countlikegadget-send (buf-concat [(buf-u8 code) (buf-str text)])
              0 next-stage 1))

(defn countlikegadget-text [bytes offset]
  (countlikegadget-check (< offset (buf-len bytes)) "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_GADGET_TEXT_PREFIX")
  (let [length (buf-read-u8 bytes offset) next (+ offset 1 length)]
    (countlikegadget-check (and (< length 251) (<= next (buf-len bytes)))
                 "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_GADGET_TEXT_LENGTH")
    {"value" (buf-read-str bytes (+ offset 1) length)
     "next" next}))

(defn countlikegadget-column-name [bytes]
  (loop [index 0 offset 0]
    (let [field (countlikegadget-text bytes offset)]
      (if (= index 4) (get field "value")
        (recur (+ index 1) (get field "next"))))))

(defn countlikegadget-login [bytes]
  (countlikegadget-check (= (buf-read-u8 bytes 0) 10) "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_GADGET_HANDSHAKE_VERSION")
  (let [version-end
          (loop [offset 1]
            (do
              (countlikegadget-check (< offset (buf-len bytes)) "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_GADGET_HANDSHAKE_LENGTH")
              (if (= (buf-read-u8 bytes offset) 0) offset (recur (+ offset 1)))))
        first-offset (+ version-end 5)
        second-offset (+ first-offset 27)]
    (countlikegadget-check (<= (+ second-offset 12) (buf-len bytes))
                 "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_GADGET_SCRAMBLE_LENGTH")
    (let [scramble (buf-concat [(buf-slice bytes first-offset 8)
                                (buf-slice bytes second-offset 12)])
          token (sha1-mysql-native-token "development-only" scramble)
          login (buf-concat [(countlikegadget-u32 172545) (countlikegadget-u32 1048576)
                             (buf-u8 33) (sha1-zero-bytes 23)
                             (buf-str "root") (buf-u8 0)
                             (buf-u8 20) token])]
      (countlikegadget-check (= (buf-len token) 20) "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_GADGET_TOKEN_LENGTH")
      (countlikegadget-send login 1 "login" 2))))

(defn countlikegadget-frame [bytes sequence]
  (countlikegadget-check (> (buf-len bytes) 0) "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_GADGET_EMPTY_PACKET")
  (countlikegadget-check (= sequence (deref countlikegadget-sequence)) "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_GADGET_PACKET_SEQUENCE")
  (swap! countlikegadget-sequence + 1)
  (let [stage (deref countlikegadget-stage) first-byte (buf-read-u8 bytes 0)]
    (if (= first-byte 255)
      (if (>= (buf-len bytes) 9)
        (throw (str "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_GADGET_SERVER_ERROR_" stage " code="
                    (+ (buf-read-u8 bytes 1) (* 256 (buf-read-u8 bytes 2)))
                    " message=" (buf-read-str bytes 9 (- (buf-len bytes) 9))))
        (throw (str "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_GADGET_SHORT_SERVER_ERROR_" stage)))
      nil)
    (cond
      (= stage "handshake") (countlikegadget-login bytes)
      (= stage "login")
        (do
          (countlikegadget-check (= first-byte 0) "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_GADGET_LOGIN_ACK")
          (countlikegadget-command 3 "CREATE TABLE shop_products (id INT PRIMARY KEY, sku TEXT, name TEXT, price INT, visible INT)"
                           "create"))
      (= stage "create")
        (do
          (countlikegadget-check (= first-byte 0) "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_GADGET_CREATE_ACK")
          (countlikegadget-command 3 "INSERT INTO shop_products (id, sku, name, price, visible) VALUES (1, 'SKU-1', 'Demo Widget', 1500, 1)"
                           "seed"))
      (= stage "seed")
        (do
          (countlikegadget-check (= first-byte 0) "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_GADGET_FIRST_SEED_ACK")
          (countlikegadget-command 3 "INSERT INTO shop_products (id, sku, name, price, visible) VALUES (2, 'SKU-2', 'Demo Gadget', 2200, 1)"
                            "second-seed"))
      (= stage "second-seed")
        (do
          (countlikegadget-check (= first-byte 0) "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_GADGET_SECOND_PRODUCT_SEED_ACK")
          (countlikegadget-command 3 "CREATE TABLE shop_cart (id INT PRIMARY KEY, user_id INT, product_id INT, qty INT)" "cart-create"))
      (= stage "cart-create")
        (do
          (countlikegadget-check (= first-byte 0) "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_GADGET_CART_CREATE_ACK")
          (countlikegadget-command 3 "INSERT INTO shop_cart (id, user_id, product_id, qty) VALUES (2, 20, 2, 1)" "second-cart-seed"))
      (= stage "second-cart-seed")
        (do
          (countlikegadget-check (= first-byte 0) "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_GADGET_SINGLE_CART_SEED_ACK")
          (countlikegadget-command 22 "SELECT COUNT(*) FROM shop_products WHERE name LIKE ?" "prepare"))
      (= stage "prepare")
        (do
          (countlikegadget-check (and (= first-byte 0) (>= (buf-len bytes) 12))
                       "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_GADGET_PREPARE_ACK")
          (countlikegadget-check (and (= (buf-read-u8 bytes 7) 1)
                            (= (buf-read-u8 bytes 8) 0))
                       "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_GADGET_PREPARE_ONE_PARAMETER")
          (reset! countlikegadget-statement (countlikegadget-read-u32 bytes 1))
          (let [execute (buf-concat [(buf-u8 23) (countlikegadget-u32 (deref countlikegadget-statement))
                                     (buf-u8 0) (countlikegadget-u32 1)
                                     (buf-u8 0) (buf-u8 1) (buf-u8 253) (buf-u8 0)
                                     (buf-u8 8) (buf-str "%Gadget%")])]
            (countlikegadget-send execute 0 "select" 1)))
      (= stage "select")
        (do
          (countlikegadget-check (and (= first-byte 1) (= (buf-len bytes) 1))
                       "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_GADGET_SELECT_ONE_COLUMN")
          (reset! countlikegadget-stage "columns"))
      (= stage "columns")
        (do
          (swap! countlikegadget-columns conj (countlikegadget-column-name bytes))
          (if (= (count (deref countlikegadget-columns)) 1)
            (reset! countlikegadget-stage "columns-end") nil))
      (= stage "columns-end")
        (do
          (countlikegadget-check (and (= first-byte 254) (= (buf-len bytes) 5))
                       "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_GADGET_COLUMN_EOF")
          (countlikegadget-check (> (count (get (deref countlikegadget-columns) 0)) 0)
                         "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_GADGET_EXPRESSION_COLUMN")
          (reset! countlikegadget-stage "rows"))
      (= stage "rows")
        (if (and (= first-byte 254) (= (buf-len bytes) 5))
          (do
            (countlikegadget-check (= (count (deref countlikegadget-rows)) 1)
                           "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_GADGET_EXACTLY_ONE_ROW")
            (countlikegadget-check (= (get (deref countlikegadget-rows) 0) "1")
                           "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_GADGET_COUNT_ZERO")
            (reset! countlikegadget-stage "done")
            (reset! countlikegadget-done true))
          (do
            (countlikegadget-check (< (count (deref countlikegadget-rows)) 1)
                           "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_GADGET_EXTRA_ROW")
            (let [field (countlikegadget-text bytes 0)]
              (countlikegadget-check (= (get field "next") (buf-len bytes))
                             "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_GADGET_ROW_TRAILING_BYTES")
              (swap! countlikegadget-rows conj (get field "value")))))
      :else (throw "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_GADGET_UNEXPECTED_STAGE"))))

(defn countlikegadget-drain []
  (if (>= (buf-len (deref countlikegadget-buffer)) 4)
    (let [bytes (deref countlikegadget-buffer)
          length (+ (buf-read-u8 bytes 0) (* 256 (buf-read-u8 bytes 1))
                     (* 65536 (buf-read-u8 bytes 2)))]
      (countlikegadget-check (<= length 65536) "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_GADGET_PACKET_LIMIT")
      (if (>= (buf-len bytes) (+ 4 length))
        (do
          (reset! countlikegadget-buffer (buf-slice bytes (+ 4 length)
                                         (- (buf-len bytes) (+ 4 length))))
          (countlikegadget-frame (buf-slice bytes 4 length) (buf-read-u8 bytes 3))
          (countlikegadget-drain))
        nil))
    nil))

(defn native-shop-products-name-like-gadget-count-handler [event connection payload peer]
  (try
    (cond
      (or (= event "connect") (= event "accept"))
        (do (countlikegadget-check (nil? (deref countlikegadget-connection)) "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_GADGET_SINGLE_CONNECTION")
            (reset! countlikegadget-connection connection))
      (= event "data")
        (do (reset! countlikegadget-buffer
              (buf-concat [(deref countlikegadget-buffer) (buf-from-binary payload)]))
            (countlikegadget-drain))
      (= event "close")
        (countlikegadget-check (deref countlikegadget-done) "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_GADGET_PREMATURE_CLOSE")
      :else nil)
    (catch [error]
      (reset! countlikegadget-error (error_message error))
      (reset! countlikegadget-done true))))

(countlikegadget-check (not (nil? countlikegadget-control)) "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_GADGET_HOST_ENV_REQUIRED")
(countlikegadget-check (not (file_exists (str countlikegadget-control "/ports.ready")))
             "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_GADGET_CONTROL_NOT_FRESH")
(let [bridge-port (tcp-client-free-port) daemon-port (tcp-client-free-port)]
  (countlikegadget-check (and (number? bridge-port) (number? daemon-port)
                    (not (= bridge-port daemon-port))) "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_GADGET_DISTINCT_PORTS")
  (countlikegadget-check (= (tcp-server-raw bridge-port "native-shop-products-name-like-gadget-count-handler" "127.0.0.1") "ok")
               "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_GADGET_LISTENER_START")
  (try
    (do
      (file_write (str countlikegadget-control "/ports.json")
                  (json_str {"bridge" bridge-port "daemon" daemon-port}))
      (file_write (str countlikegadget-control "/ports.ready") "ready")
      (let [deadline (+ (now-ms) 30000)]
        (while (and (< (now-ms) deadline) (not (deref countlikegadget-done))) (fl-yield 10)))
      (countlikegadget-check (deref countlikegadget-done) "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_GADGET_CONTRACT_TIMEOUT")
      (if (nil? (deref countlikegadget-error)) nil (throw (deref countlikegadget-error)))
      (countlikegadget-check (= (deref countlikegadget-stage) "done") "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_GADGET_CONTRACT_INCOMPLETE")
      (countlikegadget-check (= (buf-len (deref countlikegadget-buffer)) 0) "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_GADGET_TRAILING_PACKET_BYTES"))
    (finally (tcp-server-stop bridge-port))))
(println (str "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_GADGET_RESULT "
  (json_str {"ok" true "prepared_parameters" 1
             "query" "SELECT COUNT(*) FROM shop_products WHERE name LIKE ?"
             "bind" ["%Gadget%"] "select_executions" 1 "rows" 1
             "columns" (deref countlikegadget-columns) "data" (deref countlikegadget-rows)
             "exact_count" true "client_computes_count" false})))
(println "afj-db95 Native shop COUNT LIKE miss prepared SELECT PASS")
