;; Native shop cart fixture agreed in msg_40a3b4e2d516.
;; Product seed, exact spaced cart PREPARE INSERT and PREPARE SELECT.
;; Reuses accepted Native transport; SQL core and protocol remain untouched.
(load "../src/sha1.fls")
(define cart-control (env-get "AFJ_NATIVE_SHOP_CART_CONTROL"))
(define cart-connection (atom nil))
(define cart-buffer (atom ""))
(define cart-stage (atom "handshake"))
(define cart-sequence (atom 0))
(define cart-columns (atom []))
(define cart-row (atom nil))
(define cart-error (atom nil))
(define cart-done (atom false))
(define cart-statement (atom nil))

(defn cart-check [condition message]
  (if (= condition true) true (throw message)))

(defn cart-u32 [value]
  (buf-concat [(buf-u8 (rem value 256))
               (buf-u8 (rem (floor (/ value 256)) 256))
               (buf-u8 (rem (floor (/ value 65536)) 256))
               (buf-u8 (rem (floor (/ value 16777216)) 256))]))

(defn cart-read-u32 [bytes offset]
  (+ (buf-read-u8 bytes offset)
     (* 256 (buf-read-u8 bytes (+ offset 1)))
     (* 65536 (buf-read-u8 bytes (+ offset 2)))
     (* 16777216 (buf-read-u8 bytes (+ offset 3)))))

(defn cart-send [payload sequence next-stage response-sequence]
  (let [length (buf-len payload)
        frame (buf-concat [(buf-slice (cart-u32 length) 0 3)
                           (buf-u8 sequence) payload])]
    (reset! cart-stage next-stage)
    (reset! cart-sequence response-sequence)
    (cart-check (= (tcp-write (deref cart-connection) (buf-to-binary frame)) "ok")
                 "NATIVE_SHOP_CART_PACKET_WRITE")))

(defn cart-command [code text next-stage]
  (cart-send (buf-concat [(buf-u8 code) (buf-str text)])
              0 next-stage 1))

(defn cart-text [bytes offset]
  (cart-check (< offset (buf-len bytes)) "NATIVE_SHOP_CART_TEXT_PREFIX")
  (let [length (buf-read-u8 bytes offset) next (+ offset 1 length)]
    (cart-check (and (< length 251) (<= next (buf-len bytes)))
                 "NATIVE_SHOP_CART_TEXT_LENGTH")
    {"value" (buf-read-str bytes (+ offset 1) length)
     "next" next}))

(defn cart-column-name [bytes]
  (loop [index 0 offset 0]
    (let [field (cart-text bytes offset)]
      (if (= index 4) (get field "value")
        (recur (+ index 1) (get field "next"))))))

(defn cart-row-map [bytes]
  (loop [index 0 offset 0 result {}]
    (if (= index 3)
      (do
        (cart-check (= offset (buf-len bytes)) "NATIVE_SHOP_CART_ROW_TRAILING_BYTES")
        result)
      (let [field (cart-text bytes offset)]
        (recur (+ index 1) (get field "next")
               (assoc result (get (deref cart-columns) index)
                             (get field "value")))))))

(defn cart-login [bytes]
  (cart-check (= (buf-read-u8 bytes 0) 10) "NATIVE_SHOP_CART_HANDSHAKE_VERSION")
  (let [version-end
          (loop [offset 1]
            (do
              (cart-check (< offset (buf-len bytes)) "NATIVE_SHOP_CART_HANDSHAKE_LENGTH")
              (if (= (buf-read-u8 bytes offset) 0) offset (recur (+ offset 1)))))
        first-offset (+ version-end 5)
        second-offset (+ first-offset 27)]
    (cart-check (<= (+ second-offset 12) (buf-len bytes))
                 "NATIVE_SHOP_CART_SCRAMBLE_LENGTH")
    (let [scramble (buf-concat [(buf-slice bytes first-offset 8)
                                (buf-slice bytes second-offset 12)])
          token (sha1-mysql-native-token "development-only" scramble)
          login (buf-concat [(cart-u32 172545) (cart-u32 1048576)
                             (buf-u8 33) (sha1-zero-bytes 23)
                             (buf-str "root") (buf-u8 0)
                             (buf-u8 20) token])]
      (cart-check (= (buf-len token) 20) "NATIVE_SHOP_CART_TOKEN_LENGTH")
      (cart-send login 1 "login" 2))))

(defn cart-frame [bytes sequence]
  (cart-check (> (buf-len bytes) 0) "NATIVE_SHOP_CART_EMPTY_PACKET")
  (cart-check (= sequence (deref cart-sequence)) "NATIVE_SHOP_CART_PACKET_SEQUENCE")
  (swap! cart-sequence + 1)
  (let [stage (deref cart-stage) first-byte (buf-read-u8 bytes 0)]
    (if (= first-byte 255)
      (if (>= (buf-len bytes) 9)
        (throw (str "NATIVE_SHOP_CART_SERVER_ERROR_" stage " code="
                    (+ (buf-read-u8 bytes 1) (* 256 (buf-read-u8 bytes 2)))
                    " message=" (buf-read-str bytes 9 (- (buf-len bytes) 9))))
        (throw (str "NATIVE_SHOP_CART_SHORT_SERVER_ERROR_" stage)))
      nil)
    (cond
      (= stage "handshake") (cart-login bytes)
      (= stage "login")
        (do
          (cart-check (= first-byte 0) "NATIVE_SHOP_CART_LOGIN_ACK")
          (cart-command 3 "CREATE TABLE shop_products (id INT PRIMARY KEY, sku TEXT, name TEXT, price INT)"
                           "products-create"))
      (= stage "products-create")
        (do
          (cart-check (= first-byte 0) "NATIVE_SHOP_CART_PRODUCTS_CREATE_ACK")
          (cart-command 3 "INSERT INTO shop_products (id,sku,name,price) VALUES (1,'SKU-1','Demo Widget',1500)"
                           "products-seed"))
      (= stage "products-seed")
        (do
          (cart-check (= first-byte 0) "NATIVE_SHOP_CART_PRODUCTS_SEED_ACK")
          (cart-command 3 "CREATE TABLE shop_cart (id INT PRIMARY KEY, product_id INT, qty INT)"
                           "cart-create"))
      (= stage "cart-create")
        (do
          (cart-check (= first-byte 0) "NATIVE_SHOP_CART_CART_CREATE_ACK")
          (cart-command 22 "INSERT INTO shop_cart (id, product_id, qty) VALUES (?, ?, ?)"
                            "insert-prepare"))
      (= stage "insert-prepare")
        (do
          (cart-check (and (= first-byte 0) (>= (buf-len bytes) 12))
                       "NATIVE_SHOP_CART_INSERT_PREPARE_ACK")
          (cart-check (and (= (buf-read-u8 bytes 7) 3)
                            (= (buf-read-u8 bytes 8) 0))
                       "NATIVE_SHOP_CART_INSERT_THREE_PARAMETERS")
          (reset! cart-statement (cart-read-u32 bytes 1))
          (let [execute (buf-concat [(buf-u8 23) (cart-u32 (deref cart-statement))
                                     (buf-u8 0) (cart-u32 1)
                                     (buf-u8 0) (buf-u8 1)
                                     (buf-u8 3) (buf-u8 0)
                                     (buf-u8 3) (buf-u8 0)
                                     (buf-u8 3) (buf-u8 0)
                                     (cart-u32 1) (cart-u32 1) (cart-u32 2)])]
            (cart-send execute 0 "insert-execute" 1)))
      (= stage "insert-execute")
        (do
          (cart-check (= first-byte 0) "NATIVE_SHOP_CART_INSERT_EXECUTE_ACK")
          (cart-command 22 "SELECT id, product_id, qty FROM shop_cart WHERE id=?"
                            "select-prepare"))
      (= stage "select-prepare")
        (do
          (cart-check (and (= first-byte 0) (>= (buf-len bytes) 12))
                       "NATIVE_SHOP_CART_SELECT_PREPARE_ACK")
          (cart-check (and (= (buf-read-u8 bytes 7) 1)
                            (= (buf-read-u8 bytes 8) 0))
                       "NATIVE_SHOP_CART_SELECT_ONE_PARAMETER")
          (reset! cart-statement (cart-read-u32 bytes 1))
          (let [execute (buf-concat [(buf-u8 23) (cart-u32 (deref cart-statement))
                                     (buf-u8 0) (cart-u32 1)
                                     (buf-u8 0) (buf-u8 1)
                                     (buf-u8 3) (buf-u8 0) (cart-u32 1)])]
            (cart-send execute 0 "select" 1)))
      (= stage "select")
        (do
          (cart-check (and (= first-byte 3) (= (buf-len bytes) 1))
                       "NATIVE_SHOP_CART_SELECT_THREE_COLUMNS")
          (reset! cart-stage "columns"))
      (= stage "columns")
        (do
          (swap! cart-columns conj (cart-column-name bytes))
          (if (= (count (deref cart-columns)) 3)
            (reset! cart-stage "columns-end") nil))
      (= stage "columns-end")
        (do
          (cart-check (and (= first-byte 254) (= (buf-len bytes) 5))
                       "NATIVE_SHOP_CART_COLUMN_EOF")
          (cart-check (and (= (get (deref cart-columns) 0) "id")
                            (= (get (deref cart-columns) 1) "product_id")
                            (= (get (deref cart-columns) 2) "qty"))
                       "NATIVE_SHOP_CART_CART_SCHEMA")
          (reset! cart-stage "row"))
      (= stage "row")
        (do (reset! cart-row (cart-row-map bytes))
            (reset! cart-stage "row-end"))
      (= stage "row-end")
        (do
          (cart-check (and (= first-byte 254) (= (buf-len bytes) 5))
                       "NATIVE_SHOP_CART_EXACTLY_ONE_ROW")
          (cart-check (and (= (count (keys (deref cart-row))) 3)
                            (= (get (deref cart-row) "id") "1")
                            (= (get (deref cart-row) "product_id") "1")
                            (= (get (deref cart-row) "qty") "2"))
                       "NATIVE_SHOP_CART_EXACT_CART_ROW")
          (reset! cart-stage "done")
          (reset! cart-done true))
      :else (throw "NATIVE_SHOP_CART_UNEXPECTED_STAGE"))))

(defn cart-drain []
  (if (>= (buf-len (deref cart-buffer)) 4)
    (let [bytes (deref cart-buffer)
          length (+ (buf-read-u8 bytes 0) (* 256 (buf-read-u8 bytes 1))
                     (* 65536 (buf-read-u8 bytes 2)))]
      (cart-check (<= length 65536) "NATIVE_SHOP_CART_PACKET_LIMIT")
      (if (>= (buf-len bytes) (+ 4 length))
        (do
          (reset! cart-buffer (buf-slice bytes (+ 4 length)
                                         (- (buf-len bytes) (+ 4 length))))
          (cart-frame (buf-slice bytes 4 length) (buf-read-u8 bytes 3))
          (cart-drain))
        nil))
    nil))

(defn native-shop-cart-handler [event connection payload peer]
  (try
    (cond
      (or (= event "connect") (= event "accept"))
        (do (cart-check (nil? (deref cart-connection)) "NATIVE_SHOP_CART_SINGLE_CONNECTION")
            (reset! cart-connection connection))
      (= event "data")
        (do (reset! cart-buffer
              (buf-concat [(deref cart-buffer) (buf-from-binary payload)]))
            (cart-drain))
      (= event "close")
        (cart-check (deref cart-done) "NATIVE_SHOP_CART_PREMATURE_CLOSE")
      :else nil)
    (catch [error]
      (reset! cart-error (error_message error))
      (reset! cart-done true))))

(cart-check (not (nil? cart-control)) "NATIVE_SHOP_CART_HOST_ENV_REQUIRED")
(cart-check (not (file_exists (str cart-control "/ports.ready")))
             "NATIVE_SHOP_CART_CONTROL_NOT_FRESH")
(let [bridge-port (tcp-client-free-port) daemon-port (tcp-client-free-port)]
  (cart-check (and (number? bridge-port) (number? daemon-port)
                    (not (= bridge-port daemon-port))) "NATIVE_SHOP_CART_DISTINCT_PORTS")
  (cart-check (= (tcp-server-raw bridge-port "native-shop-cart-handler" "127.0.0.1") "ok")
               "NATIVE_SHOP_CART_LISTENER_START")
  (try
    (do
      (file_write (str cart-control "/ports.json")
                  (json_str {"bridge" bridge-port "daemon" daemon-port}))
      (file_write (str cart-control "/ports.ready") "ready")
      (let [deadline (+ (now-ms) 30000)]
        (while (and (< (now-ms) deadline) (not (deref cart-done))) (fl-yield 10)))
      (cart-check (deref cart-done) "NATIVE_SHOP_CART_CONTRACT_TIMEOUT")
      (if (nil? (deref cart-error)) nil (throw (deref cart-error)))
      (cart-check (= (deref cart-stage) "done") "NATIVE_SHOP_CART_CONTRACT_INCOMPLETE")
      (cart-check (= (buf-len (deref cart-buffer)) 0) "NATIVE_SHOP_CART_TRAILING_PACKET_BYTES"))
    (finally (tcp-server-stop bridge-port))))
(println (str "NATIVE_SHOP_CART_RESULT "
  (json_str {"ok" true "table" "shop_cart"
             "insert_sql" "INSERT INTO shop_cart (id, product_id, qty) VALUES (?, ?, ?)"
             "insert_bind" [1 1 2] "prepared_insert_executions" 1
             "select_sql" "SELECT id, product_id, qty FROM shop_cart WHERE id=?"
             "select_bind" [1] "prepared_select_executions" 1
             "rows" 1 "columns" (deref cart-columns) "row" (deref cart-row)
             "exact_select" true})))
(println "afj-db95 Native shop cart prepared INSERT SELECT PASS")
