;; Native same-product cart re-add fixture agreed in msg_bc1ad9445afe.
;; Seed qty=2; update by product_id to qty=3 and require one matching cart row.
;; Reuses accepted Native transport; SQL core and protocol remain untouched.
(load "../src/sha1.fls")
(define readd-control (env-get "AFJ_NATIVE_SHOP_CART_READD_CONTROL"))
(define readd-connection (atom nil))
(define readd-buffer (atom ""))
(define readd-stage (atom "handshake"))
(define readd-sequence (atom 0))
(define readd-columns (atom []))
(define readd-row (atom nil))
(define readd-error (atom nil))
(define readd-done (atom false))
(define readd-statement (atom nil))
(define readd-result-kind (atom "update"))
(define readd-update-received (atom false))

(defn readd-check [condition message]
  (if (= condition true) true (throw message)))

(defn readd-u32 [value]
  (buf-concat [(buf-u8 (rem value 256))
               (buf-u8 (rem (floor (/ value 256)) 256))
               (buf-u8 (rem (floor (/ value 65536)) 256))
               (buf-u8 (rem (floor (/ value 16777216)) 256))]))

(defn readd-read-u32 [bytes offset]
  (+ (buf-read-u8 bytes offset)
     (* 256 (buf-read-u8 bytes (+ offset 1)))
     (* 65536 (buf-read-u8 bytes (+ offset 2)))
     (* 16777216 (buf-read-u8 bytes (+ offset 3)))))

(defn readd-send [payload sequence next-stage response-sequence]
  (let [length (buf-len payload)
        frame (buf-concat [(buf-slice (readd-u32 length) 0 3)
                           (buf-u8 sequence) payload])]
    (reset! readd-stage next-stage)
    (reset! readd-sequence response-sequence)
    (readd-check (= (tcp-write (deref readd-connection) (buf-to-binary frame)) "ok")
                 "NATIVE_SHOP_CART_READD_PACKET_WRITE")))

(defn readd-command [code text next-stage]
  (readd-send (buf-concat [(buf-u8 code) (buf-str text)])
              0 next-stage 1))

(defn readd-text [bytes offset]
  (readd-check (< offset (buf-len bytes)) "NATIVE_SHOP_CART_READD_TEXT_PREFIX")
  (let [length (buf-read-u8 bytes offset) next (+ offset 1 length)]
    (readd-check (and (< length 251) (<= next (buf-len bytes)))
                 "NATIVE_SHOP_CART_READD_TEXT_LENGTH")
    {"value" (buf-read-str bytes (+ offset 1) length)
     "next" next}))

(defn readd-column-name [bytes]
  (loop [index 0 offset 0]
    (let [field (readd-text bytes offset)]
      (if (= index 4) (get field "value")
        (recur (+ index 1) (get field "next"))))))

(defn readd-row-map [bytes]
  (loop [index 0 offset 0 result {}]
    (if (= index 3)
      (do
        (readd-check (= offset (buf-len bytes)) "NATIVE_SHOP_CART_READD_ROW_TRAILING_BYTES")
        result)
      (let [field (readd-text bytes offset)]
        (recur (+ index 1) (get field "next")
               (assoc result (get (deref readd-columns) index)
                             (get field "value")))))))

(defn readd-login [bytes]
  (readd-check (= (buf-read-u8 bytes 0) 10) "NATIVE_SHOP_CART_READD_HANDSHAKE_VERSION")
  (let [version-end
          (loop [offset 1]
            (do
              (readd-check (< offset (buf-len bytes)) "NATIVE_SHOP_CART_READD_HANDSHAKE_LENGTH")
              (if (= (buf-read-u8 bytes offset) 0) offset (recur (+ offset 1)))))
        first-offset (+ version-end 5)
        second-offset (+ first-offset 27)]
    (readd-check (<= (+ second-offset 12) (buf-len bytes))
                 "NATIVE_SHOP_CART_READD_SCRAMBLE_LENGTH")
    (let [scramble (buf-concat [(buf-slice bytes first-offset 8)
                                (buf-slice bytes second-offset 12)])
          token (sha1-mysql-native-token "development-only" scramble)
          login (buf-concat [(readd-u32 172545) (readd-u32 1048576)
                             (buf-u8 33) (sha1-zero-bytes 23)
                             (buf-str "root") (buf-u8 0)
                             (buf-u8 20) token])]
      (readd-check (= (buf-len token) 20) "NATIVE_SHOP_CART_READD_TOKEN_LENGTH")
      (readd-send login 1 "login" 2))))

(defn readd-frame [bytes sequence]
  (readd-check (> (buf-len bytes) 0) "NATIVE_SHOP_CART_READD_EMPTY_PACKET")
  (readd-check (= sequence (deref readd-sequence)) "NATIVE_SHOP_CART_READD_PACKET_SEQUENCE")
  (swap! readd-sequence + 1)
  (let [stage (deref readd-stage) first-byte (buf-read-u8 bytes 0)]
    (if (= first-byte 255)
      (if (>= (buf-len bytes) 9)
        (throw (str "NATIVE_SHOP_CART_READD_SERVER_ERROR_" stage " code="
                    (+ (buf-read-u8 bytes 1) (* 256 (buf-read-u8 bytes 2)))
                    " message=" (buf-read-str bytes 9 (- (buf-len bytes) 9))))
        (throw (str "NATIVE_SHOP_CART_READD_SHORT_SERVER_ERROR_" stage)))
      nil)
    (cond
      (= stage "handshake") (readd-login bytes)
      (= stage "login")
        (do
          (readd-check (= first-byte 0) "NATIVE_SHOP_CART_READD_LOGIN_ACK")
          (readd-command 3 "CREATE TABLE shop_products (id INT PRIMARY KEY, sku TEXT, name TEXT, price INT)"
                           "products-create"))
      (= stage "products-create")
        (do
          (readd-check (= first-byte 0) "NATIVE_SHOP_CART_READD_PRODUCTS_CREATE_ACK")
          (readd-command 3 "INSERT INTO shop_products (id, sku, name, price) VALUES (1, 'SKU-1', 'Demo Widget', 1500)"
                           "products-seed"))
      (= stage "products-seed")
        (do
          (readd-check (= first-byte 0) "NATIVE_SHOP_CART_READD_PRODUCTS_SEED_ACK")
          (readd-command 3 "CREATE TABLE shop_cart (id INT PRIMARY KEY, product_id INT, qty INT)"
                           "cart-create"))
      (= stage "cart-create")
        (do
          (readd-check (= first-byte 0) "NATIVE_SHOP_CART_READD_CART_CREATE_ACK")
          (readd-command 3 "INSERT INTO shop_cart (id, product_id, qty) VALUES (1, 1, 2)"
                              "cart-seed"))
      (= stage "cart-seed")
        (do
          (readd-check (= first-byte 0) "NATIVE_SHOP_CART_READD_CART_SEED_ACK")
          (readd-command 22 "UPDATE shop_cart SET qty=? WHERE product_id=?" "update-prepare"))
      (= stage "update-prepare")
        (do
          (readd-check (and (= first-byte 0) (>= (buf-len bytes) 12))
                          "NATIVE_SHOP_CART_READD_UPDATE_PREPARE_ACK")
          (readd-check (and (= (buf-read-u8 bytes 7) 2)
                              (= (buf-read-u8 bytes 8) 0))
                          "NATIVE_SHOP_CART_READD_UPDATE_TWO_PARAMETERS")
          (reset! readd-statement (readd-read-u32 bytes 1))
          (let [execute (buf-concat [(buf-u8 23) (readd-u32 (deref readd-statement))
                                    (buf-u8 0) (readd-u32 1)
                                    (buf-u8 0) (buf-u8 1)
                                    (buf-u8 3) (buf-u8 0) (buf-u8 3) (buf-u8 0)
                                    (readd-u32 3) (readd-u32 1)])]
            (readd-send execute 0 "select" 1)))
      (= stage "select-prepare")
        (do
          (readd-check (and (= first-byte 0) (>= (buf-len bytes) 12))
                       "NATIVE_SHOP_CART_READD_SELECT_PREPARE_ACK")
          (readd-check (and (= (buf-read-u8 bytes 7) 1)
                            (= (buf-read-u8 bytes 8) 0))
                       "NATIVE_SHOP_CART_READD_SELECT_ONE_PARAMETER")
          (reset! readd-statement (readd-read-u32 bytes 1))
          (let [execute (buf-concat [(buf-u8 23) (readd-u32 (deref readd-statement))
                                     (buf-u8 0) (readd-u32 1)
                                     (buf-u8 0) (buf-u8 1)
                                     (buf-u8 3) (buf-u8 0) (readd-u32 1)])]
            (readd-send execute 0 "select" 1)))
      (= stage "select")
        (do
          (readd-check (and (= first-byte 3) (= (buf-len bytes) 1))
                       "NATIVE_SHOP_CART_READD_SELECT_THREE_COLUMNS")
          (reset! readd-stage "columns"))
      (= stage "columns")
        (do
          (swap! readd-columns conj (readd-column-name bytes))
          (if (= (count (deref readd-columns)) 3)
            (reset! readd-stage "columns-end") nil))
      (= stage "columns-end")
        (do
          (readd-check (and (= first-byte 254) (= (buf-len bytes) 5))
                       "NATIVE_SHOP_CART_READD_COLUMN_EOF")
          (readd-check (and (= (get (deref readd-columns) 0) "id")
                            (= (get (deref readd-columns) 1) "product_id")
                            (= (get (deref readd-columns) 2) "qty"))
                       "NATIVE_SHOP_CART_READD_CART_SCHEMA")
          (reset! readd-stage "row"))
      (= stage "row")
        (do (reset! readd-row (readd-row-map bytes))
            (reset! readd-stage "row-end"))
      (= stage "row-end")
        (do
          (readd-check (and (= first-byte 254) (= (buf-len bytes) 5))
                       "NATIVE_SHOP_CART_READD_EXACTLY_ONE_ROW")
          (readd-check (and (= (count (keys (deref readd-row))) 3)
                            (= (get (deref readd-row) "id") "1")
                            (= (get (deref readd-row) "product_id") "1")
                            (= (get (deref readd-row) "qty") "3"))
                       "NATIVE_SHOP_CART_READD_EXACT_CART_ROW")
          (if (= (deref readd-result-kind) "update")
            (do
              (reset! readd-update-received true)
              (reset! readd-result-kind "select")
              (reset! readd-columns [])
              (reset! readd-row nil)
              (readd-command 22 "SELECT id, product_id, qty FROM shop_cart WHERE product_id=?"
                                  "select-prepare"))
            (do
              (reset! readd-stage "done")
              (reset! readd-done true))))
      :else (throw "NATIVE_SHOP_CART_READD_UNEXPECTED_STAGE"))))

(defn readd-drain []
  (if (>= (buf-len (deref readd-buffer)) 4)
    (let [bytes (deref readd-buffer)
          length (+ (buf-read-u8 bytes 0) (* 256 (buf-read-u8 bytes 1))
                     (* 65536 (buf-read-u8 bytes 2)))]
      (readd-check (<= length 65536) "NATIVE_SHOP_CART_READD_PACKET_LIMIT")
      (if (>= (buf-len bytes) (+ 4 length))
        (do
          (reset! readd-buffer (buf-slice bytes (+ 4 length)
                                         (- (buf-len bytes) (+ 4 length))))
          (readd-frame (buf-slice bytes 4 length) (buf-read-u8 bytes 3))
          (readd-drain))
        nil))
    nil))

(defn native-shop-cart-readd-handler [event connection payload peer]
  (try
    (cond
      (or (= event "connect") (= event "accept"))
        (do (readd-check (nil? (deref readd-connection)) "NATIVE_SHOP_CART_READD_SINGLE_CONNECTION")
            (reset! readd-connection connection))
      (= event "data")
        (do (reset! readd-buffer
              (buf-concat [(deref readd-buffer) (buf-from-binary payload)]))
            (readd-drain))
      (= event "close")
        (readd-check (deref readd-done) "NATIVE_SHOP_CART_READD_PREMATURE_CLOSE")
      :else nil)
    (catch [error]
      (reset! readd-error (error_message error))
      (reset! readd-done true))))

(readd-check (not (nil? readd-control)) "NATIVE_SHOP_CART_READD_HOST_ENV_REQUIRED")
(readd-check (not (file_exists (str readd-control "/ports.ready")))
             "NATIVE_SHOP_CART_READD_CONTROL_NOT_FRESH")
(let [bridge-port (tcp-client-free-port) daemon-port (tcp-client-free-port)]
  (readd-check (and (number? bridge-port) (number? daemon-port)
                    (not (= bridge-port daemon-port))) "NATIVE_SHOP_CART_READD_DISTINCT_PORTS")
  (readd-check (= (tcp-server-raw bridge-port "native-shop-cart-readd-handler" "127.0.0.1") "ok")
               "NATIVE_SHOP_CART_READD_LISTENER_START")
  (try
    (do
      (file_write (str readd-control "/ports.json")
                  (json_str {"bridge" bridge-port "daemon" daemon-port}))
      (file_write (str readd-control "/ports.ready") "ready")
      (let [deadline (+ (now-ms) 30000)]
        (while (and (< (now-ms) deadline) (not (deref readd-done))) (fl-yield 10)))
      (readd-check (deref readd-done) "NATIVE_SHOP_CART_READD_CONTRACT_TIMEOUT")
      (if (nil? (deref readd-error)) nil (throw (deref readd-error)))
      (readd-check (= (deref readd-stage) "done") "NATIVE_SHOP_CART_READD_CONTRACT_INCOMPLETE")
      (readd-check (deref readd-update-received) "NATIVE_SHOP_CART_READD_UPDATE_RESULT_MISSING")
      (readd-check (= (buf-len (deref readd-buffer)) 0) "NATIVE_SHOP_CART_READD_TRAILING_PACKET_BYTES"))
    (finally (tcp-server-stop bridge-port))))
(println (str "NATIVE_SHOP_CART_READD_RESULT "
  (json_str {"ok" true "table" "shop_cart" "initial_qty" 2
             "update_sql" "UPDATE shop_cart SET qty=? WHERE product_id=?"
             "update_bind" [3 1] "prepared_update_executions" 1
             "update_result_received" (deref readd-update-received)
             "select_sql" "SELECT id, product_id, qty FROM shop_cart WHERE product_id=?"
             "select_bind" [1] "prepared_select_executions" 1
             "rows" 1 "columns" (deref readd-columns) "row" (deref readd-row)
             "exact_select" true "no_duplicate_row" true})))
(println "afj-db95 Native shop cart readd prepared UPDATE SELECT PASS")
