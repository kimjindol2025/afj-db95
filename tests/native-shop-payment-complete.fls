;; Native shop payment-completion DB fixture agreed in msg_10457213da72.
;; Seed product/cart/order, prepared cart deletion, empty cart and retained order.
;; Reuses accepted Native transport; SQL core and protocol remain untouched.
(load "../src/sha1.fls")
(define payment-control (env-get "AFJ_NATIVE_SHOP_PAYMENT_COMPLETE_CONTROL"))
(define payment-connection (atom nil))
(define payment-buffer (atom ""))
(define payment-stage (atom "handshake"))
(define payment-sequence (atom 0))
(define payment-columns (atom []))
(define payment-row (atom nil))
(define payment-error (atom nil))
(define payment-done (atom false))
(define payment-statement (atom nil))
(define payment-cart-empty (atom false))

(defn payment-check [condition message]
  (if (= condition true) true (throw message)))

(defn payment-u32 [value]
  (buf-concat [(buf-u8 (rem value 256))
               (buf-u8 (rem (floor (/ value 256)) 256))
               (buf-u8 (rem (floor (/ value 65536)) 256))
               (buf-u8 (rem (floor (/ value 16777216)) 256))]))

(defn payment-read-u32 [bytes offset]
  (+ (buf-read-u8 bytes offset)
     (* 256 (buf-read-u8 bytes (+ offset 1)))
     (* 65536 (buf-read-u8 bytes (+ offset 2)))
     (* 16777216 (buf-read-u8 bytes (+ offset 3)))))

(defn payment-send [payload sequence next-stage response-sequence]
  (let [length (buf-len payload)
        frame (buf-concat [(buf-slice (payment-u32 length) 0 3)
                           (buf-u8 sequence) payload])]
    (reset! payment-stage next-stage)
    (reset! payment-sequence response-sequence)
    (payment-check (= (tcp-write (deref payment-connection) (buf-to-binary frame)) "ok")
                 "NATIVE_SHOP_PAYMENT_COMPLETE_PACKET_WRITE")))

(defn payment-command [code text next-stage]
  (payment-send (buf-concat [(buf-u8 code) (buf-str text)])
              0 next-stage 1))

(defn payment-execute-id [bytes label next-stage]
  (payment-check (and (= (buf-read-u8 bytes 0) 0) (>= (buf-len bytes) 12))
                 (str "NATIVE_SHOP_PAYMENT_COMPLETE_" label "_PREPARE_ACK"))
  (payment-check (and (= (buf-read-u8 bytes 7) 1)
                     (= (buf-read-u8 bytes 8) 0))
                 (str "NATIVE_SHOP_PAYMENT_COMPLETE_" label "_ONE_PARAMETER"))
  (reset! payment-statement (payment-read-u32 bytes 1))
  (let [execute (buf-concat [(buf-u8 23) (payment-u32 (deref payment-statement))
                             (buf-u8 0) (payment-u32 1)
                             (buf-u8 0) (buf-u8 1)
                             (buf-u8 3) (buf-u8 0) (payment-u32 1)])]
    (payment-send execute 0 next-stage 1)))

(defn payment-text [bytes offset]
  (payment-check (< offset (buf-len bytes)) "NATIVE_SHOP_PAYMENT_COMPLETE_TEXT_PREFIX")
  (let [length (buf-read-u8 bytes offset) next (+ offset 1 length)]
    (payment-check (and (< length 251) (<= next (buf-len bytes)))
                 "NATIVE_SHOP_PAYMENT_COMPLETE_TEXT_LENGTH")
    {"value" (buf-read-str bytes (+ offset 1) length)
     "next" next}))

(defn payment-column-name [bytes]
  (loop [index 0 offset 0]
    (let [field (payment-text bytes offset)]
      (if (= index 4) (get field "value")
        (recur (+ index 1) (get field "next"))))))

(defn payment-row-map [bytes]
  (loop [index 0 offset 0 result {}]
    (if (= index 4)
      (do
        (payment-check (= offset (buf-len bytes)) "NATIVE_SHOP_PAYMENT_COMPLETE_ROW_TRAILING_BYTES")
        result)
      (let [field (payment-text bytes offset)]
        (recur (+ index 1) (get field "next")
               (assoc result (get (deref payment-columns) index)
                             (get field "value")))))))

(defn payment-login [bytes]
  (payment-check (= (buf-read-u8 bytes 0) 10) "NATIVE_SHOP_PAYMENT_COMPLETE_HANDSHAKE_VERSION")
  (let [version-end
          (loop [offset 1]
            (do
              (payment-check (< offset (buf-len bytes)) "NATIVE_SHOP_PAYMENT_COMPLETE_HANDSHAKE_LENGTH")
              (if (= (buf-read-u8 bytes offset) 0) offset (recur (+ offset 1)))))
        first-offset (+ version-end 5)
        second-offset (+ first-offset 27)]
    (payment-check (<= (+ second-offset 12) (buf-len bytes))
                 "NATIVE_SHOP_PAYMENT_COMPLETE_SCRAMBLE_LENGTH")
    (let [scramble (buf-concat [(buf-slice bytes first-offset 8)
                                (buf-slice bytes second-offset 12)])
          token (sha1-mysql-native-token "development-only" scramble)
          login (buf-concat [(payment-u32 172545) (payment-u32 1048576)
                             (buf-u8 33) (sha1-zero-bytes 23)
                             (buf-str "root") (buf-u8 0)
                             (buf-u8 20) token])]
      (payment-check (= (buf-len token) 20) "NATIVE_SHOP_PAYMENT_COMPLETE_TOKEN_LENGTH")
      (payment-send login 1 "login" 2))))

(defn payment-frame [bytes sequence]
  (payment-check (> (buf-len bytes) 0) "NATIVE_SHOP_PAYMENT_COMPLETE_EMPTY_PACKET")
  (payment-check (= sequence (deref payment-sequence)) "NATIVE_SHOP_PAYMENT_COMPLETE_PACKET_SEQUENCE")
  (swap! payment-sequence + 1)
  (let [stage (deref payment-stage) first-byte (buf-read-u8 bytes 0)]
    (if (= first-byte 255)
      (if (>= (buf-len bytes) 9)
        (throw (str "NATIVE_SHOP_PAYMENT_COMPLETE_SERVER_ERROR_" stage " code="
                    (+ (buf-read-u8 bytes 1) (* 256 (buf-read-u8 bytes 2)))
                    " message=" (buf-read-str bytes 9 (- (buf-len bytes) 9))))
        (throw (str "NATIVE_SHOP_PAYMENT_COMPLETE_SHORT_SERVER_ERROR_" stage)))
      nil)
    (cond
      (= stage "handshake") (payment-login bytes)
      (= stage "login")
        (do
          (payment-check (= first-byte 0) "NATIVE_SHOP_PAYMENT_COMPLETE_LOGIN_ACK")
          (payment-command 3 "CREATE TABLE shop_products (id INT PRIMARY KEY, sku TEXT, name TEXT, price INT)"
                           "products-create"))
      (= stage "products-create")
        (do
          (payment-check (= first-byte 0) "NATIVE_SHOP_PAYMENT_COMPLETE_PRODUCTS_CREATE_ACK")
          (payment-command 3 "INSERT INTO shop_products (id, sku, name, price) VALUES (1, 'SKU-1', 'Demo Widget', 1500)"
                           "products-seed"))
      (= stage "products-seed")
        (do
          (payment-check (= first-byte 0) "NATIVE_SHOP_PAYMENT_COMPLETE_PRODUCTS_SEED_ACK")
          (payment-command 3 "CREATE TABLE shop_cart (id INT PRIMARY KEY, product_id INT, qty INT)"
                           "cart-create"))
      (= stage "cart-create")
        (do
          (payment-check (= first-byte 0) "NATIVE_SHOP_PAYMENT_COMPLETE_CART_CREATE_ACK")
          (payment-command 3 "INSERT INTO shop_cart (id, product_id, qty) VALUES (1, 1, 2)"
                            "cart-seed"))
      (= stage "cart-seed")
        (do
          (payment-check (= first-byte 0) "NATIVE_SHOP_PAYMENT_COMPLETE_CART_SEED_ACK")
          (payment-command 3 "CREATE TABLE shop_orders (id INT PRIMARY KEY, product_id INT, qty INT, total INT)"
                            "orders-create"))
      (= stage "orders-create")
        (do
          (payment-check (= first-byte 0) "NATIVE_SHOP_PAYMENT_COMPLETE_ORDERS_CREATE_ACK")
          (payment-command 22 "INSERT INTO shop_orders (id, product_id, qty, total) VALUES (?, ?, ?, ?)"
                            "insert-prepare"))
      (= stage "insert-prepare")
        (do
          (payment-check (and (= first-byte 0) (>= (buf-len bytes) 12))
                       "NATIVE_SHOP_PAYMENT_COMPLETE_INSERT_PREPARE_ACK")
          (payment-check (and (= (buf-read-u8 bytes 7) 4)
                            (= (buf-read-u8 bytes 8) 0))
                       "NATIVE_SHOP_PAYMENT_COMPLETE_INSERT_FOUR_PARAMETERS")
          (reset! payment-statement (payment-read-u32 bytes 1))
          (let [execute (buf-concat [(buf-u8 23) (payment-u32 (deref payment-statement))
                                     (buf-u8 0) (payment-u32 1)
                                     (buf-u8 0) (buf-u8 1)
                                     (buf-u8 3) (buf-u8 0)
                                     (buf-u8 3) (buf-u8 0)
                                     (buf-u8 3) (buf-u8 0)
                                     (buf-u8 3) (buf-u8 0)
                                     (payment-u32 1) (payment-u32 1) (payment-u32 2)
                                     (payment-u32 3000)])]
            (payment-send execute 0 "insert-execute" 1)))
      (= stage "insert-execute")
        (do
          (payment-check (= first-byte 0) "NATIVE_SHOP_PAYMENT_COMPLETE_INSERT_EXECUTE_ACK")
          (payment-command 22 "DELETE FROM shop_cart WHERE id=?" "delete-prepare"))
      (= stage "delete-prepare")
        (payment-execute-id bytes "CART_DELETE" "delete-execute")
      (= stage "delete-execute")
        (do
          (payment-check (and (= first-byte 1) (= (buf-len bytes) 1))
                         "NATIVE_SHOP_PAYMENT_COMPLETE_DELETE_RESULT_HEADER")
          (reset! payment-stage "delete-column"))
      (= stage "delete-column")
        (do
          (payment-check (= (payment-column-name bytes) "result")
                         "NATIVE_SHOP_PAYMENT_COMPLETE_DELETE_RESULT_COLUMN")
          (reset! payment-stage "delete-column-end"))
      (= stage "delete-column-end")
        (do
          (payment-check (and (= first-byte 254) (= (buf-len bytes) 5))
                         "NATIVE_SHOP_PAYMENT_COMPLETE_DELETE_COLUMN_EOF")
          (reset! payment-stage "delete-result-end"))
      (= stage "delete-result-end")
        (do
          (payment-check (and (= first-byte 254) (= (buf-len bytes) 5))
                         "NATIVE_SHOP_PAYMENT_COMPLETE_DELETE_RESULT_EOF")
          (payment-command 22 "SELECT id FROM shop_cart WHERE id=?" "cart-select-prepare"))
      (= stage "cart-select-prepare")
        (payment-execute-id bytes "CART_SELECT" "cart-select")
      (= stage "cart-select")
        (do
          (payment-check (and (= first-byte 1) (= (buf-len bytes) 1))
                         "NATIVE_SHOP_PAYMENT_COMPLETE_CART_ONE_COLUMN")
          (reset! payment-stage "cart-column"))
      (= stage "cart-column")
        (do
          (payment-column-name bytes)
          (reset! payment-stage "cart-column-end"))
      (= stage "cart-column-end")
        (do
          (payment-check (and (= first-byte 254) (= (buf-len bytes) 5))
                         "NATIVE_SHOP_PAYMENT_COMPLETE_CART_COLUMN_EOF")
          (reset! payment-stage "cart-empty"))
      (= stage "cart-empty")
        (do
          (payment-check (and (= first-byte 254) (= (buf-len bytes) 5))
                         "NATIVE_SHOP_PAYMENT_COMPLETE_CART_NOT_EMPTY")
          (reset! payment-cart-empty true)
          (payment-command 22 "SELECT id, product_id, qty, total FROM shop_orders WHERE id=?"
                            "select-prepare"))
      (= stage "select-prepare")
        (payment-execute-id bytes "ORDER_SELECT" "select")
      (= stage "select")
        (do
          (payment-check (and (= first-byte 4) (= (buf-len bytes) 1))
                       "NATIVE_SHOP_PAYMENT_COMPLETE_SELECT_FOUR_COLUMNS")
          (reset! payment-stage "columns"))
      (= stage "columns")
        (do
          (swap! payment-columns conj (payment-column-name bytes))
          (if (= (count (deref payment-columns)) 4)
            (reset! payment-stage "columns-end") nil))
      (= stage "columns-end")
        (do
          (payment-check (and (= first-byte 254) (= (buf-len bytes) 5))
                       "NATIVE_SHOP_PAYMENT_COMPLETE_COLUMN_EOF")
          (payment-check (and (= (get (deref payment-columns) 0) "id")
                            (= (get (deref payment-columns) 1) "product_id")
                            (= (get (deref payment-columns) 2) "qty")
                            (= (get (deref payment-columns) 3) "total"))
                       "NATIVE_SHOP_PAYMENT_COMPLETE_ORDER_SCHEMA")
          (reset! payment-stage "row"))
      (= stage "row")
        (do (reset! payment-row (payment-row-map bytes))
            (reset! payment-stage "row-end"))
      (= stage "row-end")
        (do
          (payment-check (and (= first-byte 254) (= (buf-len bytes) 5))
                       "NATIVE_SHOP_PAYMENT_COMPLETE_EXACTLY_ONE_ROW")
          (payment-check (and (= (count (keys (deref payment-row))) 4)
                            (= (get (deref payment-row) "id") "1")
                            (= (get (deref payment-row) "product_id") "1")
                            (= (get (deref payment-row) "qty") "2")
                            (= (get (deref payment-row) "total") "3000"))
                       "NATIVE_SHOP_PAYMENT_COMPLETE_EXACT_ORDER_ROW")
          (reset! payment-stage "done")
          (reset! payment-done true))
      :else (throw "NATIVE_SHOP_PAYMENT_COMPLETE_UNEXPECTED_STAGE"))))

(defn payment-drain []
  (if (>= (buf-len (deref payment-buffer)) 4)
    (let [bytes (deref payment-buffer)
          length (+ (buf-read-u8 bytes 0) (* 256 (buf-read-u8 bytes 1))
                     (* 65536 (buf-read-u8 bytes 2)))]
      (payment-check (<= length 65536) "NATIVE_SHOP_PAYMENT_COMPLETE_PACKET_LIMIT")
      (if (>= (buf-len bytes) (+ 4 length))
        (do
          (reset! payment-buffer (buf-slice bytes (+ 4 length)
                                         (- (buf-len bytes) (+ 4 length))))
          (payment-frame (buf-slice bytes 4 length) (buf-read-u8 bytes 3))
          (payment-drain))
        nil))
    nil))

(defn native-shop-payment-complete-handler [event connection payload peer]
  (try
    (cond
      (or (= event "connect") (= event "accept"))
        (do (payment-check (nil? (deref payment-connection)) "NATIVE_SHOP_PAYMENT_COMPLETE_SINGLE_CONNECTION")
            (reset! payment-connection connection))
      (= event "data")
        (do (reset! payment-buffer
              (buf-concat [(deref payment-buffer) (buf-from-binary payload)]))
            (payment-drain))
      (= event "close")
        (payment-check (deref payment-done) "NATIVE_SHOP_PAYMENT_COMPLETE_PREMATURE_CLOSE")
      :else nil)
    (catch [error]
      (reset! payment-error (error_message error))
      (reset! payment-done true))))

(payment-check (not (nil? payment-control)) "NATIVE_SHOP_PAYMENT_COMPLETE_HOST_ENV_REQUIRED")
(payment-check (not (file_exists (str payment-control "/ports.ready")))
             "NATIVE_SHOP_PAYMENT_COMPLETE_CONTROL_NOT_FRESH")
(let [bridge-port (tcp-client-free-port) daemon-port (tcp-client-free-port)]
  (payment-check (and (number? bridge-port) (number? daemon-port)
                    (not (= bridge-port daemon-port))) "NATIVE_SHOP_PAYMENT_COMPLETE_DISTINCT_PORTS")
  (payment-check (= (tcp-server-raw bridge-port "native-shop-payment-complete-handler" "127.0.0.1") "ok")
               "NATIVE_SHOP_PAYMENT_COMPLETE_LISTENER_START")
  (try
    (do
      (file_write (str payment-control "/ports.json")
                  (json_str {"bridge" bridge-port "daemon" daemon-port}))
      (file_write (str payment-control "/ports.ready") "ready")
      (let [deadline (+ (now-ms) 30000)]
        (while (and (< (now-ms) deadline) (not (deref payment-done))) (fl-yield 10)))
      (payment-check (deref payment-done) "NATIVE_SHOP_PAYMENT_COMPLETE_CONTRACT_TIMEOUT")
      (if (nil? (deref payment-error)) nil (throw (deref payment-error)))
      (payment-check (= (deref payment-stage) "done") "NATIVE_SHOP_PAYMENT_COMPLETE_CONTRACT_INCOMPLETE")
      (payment-check (deref payment-cart-empty) "NATIVE_SHOP_PAYMENT_COMPLETE_CART_VERIFICATION_MISSING")
      (payment-check (= (buf-len (deref payment-buffer)) 0) "NATIVE_SHOP_PAYMENT_COMPLETE_TRAILING_PACKET_BYTES"))
    (finally (tcp-server-stop bridge-port))))
(println (str "NATIVE_SHOP_PAYMENT_COMPLETE_RESULT "
  (json_str {"ok" true "table" "shop_orders"
             "order_insert_sql" "INSERT INTO shop_orders (id, product_id, qty, total) VALUES (?, ?, ?, ?)"
             "order_insert_bind" [1 1 2 3000] "prepared_order_insert_executions" 1
             "cart_delete_sql" "DELETE FROM shop_cart WHERE id=?"
             "cart_delete_bind" [1] "prepared_cart_delete_executions" 1
             "cart_select_sql" "SELECT id FROM shop_cart WHERE id=?"
             "cart_select_bind" [1] "prepared_cart_select_executions" 1
             "cart_rows" 0 "cart_empty" (deref payment-cart-empty)
             "order_select_sql" "SELECT id, product_id, qty, total FROM shop_orders WHERE id=?"
             "order_select_bind" [1] "prepared_order_select_executions" 1
             "order_rows" 1 "order_columns" (deref payment-columns)
             "order_row" (deref payment-row) "exact_order_select" true})))
(println "afj-db95 Native shop payment completion prepared cart empty order retained PASS")
