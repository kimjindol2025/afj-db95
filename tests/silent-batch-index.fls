;; A batch that changes indexed values must leave the index equivalent to a scan.
(load "../src/tcp-server.fls")

(reset! engine-catalog {})
(reset! engine-indexes {})
(execute-ast
  {"type" "create-table" "table" "silent_index_users"
   "schema" {"columns" [{"name" "id" "type" "INTEGER"
                            "nullable" false "primary" true}
                           {"name" "name" "type" "TEXT" "nullable" true}
                           {"name" "marker" "type" "TEXT" "nullable" true}]
              "primary-key" "id" "unique-columns" ["name"]}})
(afj-tcp-commit-asts
  [{"type" "insert" "table" "silent_index_users"
    "row" {"id" 1 "name" "before-a" "marker" "a"}}
   {"type" "insert" "table" "silent_index_users"
    "row" {"id" 2 "name" "before-b" "marker" "b"}}])
(afj-tcp-commit-asts
  [{"type" "update" "table" "silent_index_users"
    "where" {"column" "id" "equals" 1}
    "changes" {"name" "after-a"}}
   {"type" "update" "table" "silent_index_users"
    "where" {"column" "id" "equals" 2}
    "changes" {"name" "after-b"}}])

(let [indexed (execute-ast
                {"type" "select" "table" "silent_index_users"
                 "where" {"column" "name" "equals" "after-a"}})
      scanned (execute-ast
                {"type" "select" "table" "silent_index_users"
                 "where" {"column" "marker" "equals" "a"}})
      index-rows (get indexed "rows")
      scan-rows (get scanned "rows")]
  (println (str "DB95_INDEX_BATCH index=" (count index-rows)
                " scan=" (count scan-rows)
                " index_hash=" (sha256 (json_str index-rows))
                " scan_hash=" (sha256 (json_str scan-rows))))
  (if (and (= (get indexed "plan") "index-scan")
           (= (get scanned "plan") "full-scan")
           (= (json_str index-rows) (json_str scan-rows)))
    (println "PASS silent-batch-index")
    (throw "INDEX_MISMATCH")))

;; Force B+Tree splits and change many secondary keys in one commit.
(afj-tcp-commit-asts
  (map (fn [id]
         {"type" "insert" "table" "silent_index_users"
          "row" {"id" (+ id 10)
                 "name" (str "old-" id)
                 "marker" (str "marker-" id)}})
       (range 0 80)))
(afj-tcp-commit-asts
  (map (fn [id]
         {"type" "update" "table" "silent_index_users"
          "where" {"column" "id" "equals" (+ id 10)}
          "changes" {"name" (str "new-" id)}})
       (range 0 80)))
(let [mismatches (atom 0)]
  (doseq [id (range 0 80)]
    (let [indexed (get (execute-ast
                         {"type" "select" "table" "silent_index_users"
                          "where" {"column" "name"
                                   "equals" (str "new-" id)}}) "rows")
          scanned (get (execute-ast
                         {"type" "select" "table" "silent_index_users"
                          "where" {"column" "marker"
                                   "equals" (str "marker-" id)}}) "rows")]
      (if (not (= (json_str indexed) (json_str scanned)))
        (swap! mismatches (fn [count] (+ count 1)))
        nil)))
  (println (str "DB95_INDEX_LARGE_BATCH mismatches=" (deref mismatches)))
  (if (= (deref mismatches) 0)
    (println "PASS silent-large-batch-index")
    (throw "INDEX_MISMATCH")))

;; A stale-revision merge starts from a page-backed table. Its old persisted
;; tree must not override the rebuilt index for the updated rows.
(let [table (engine-table "silent_index_users")]
  (reset! engine-catalog
    (assoc (deref engine-catalog) "silent_index_users"
      (assoc table "page-indexes" (afj-tcp-page-indexes-for-table table)))))
(execute-ast {"type" "create-table" "table" "silent_revision_bump"})
(reset! afj-tcp-sessions {"silent-tx" "root"})
(reset! afj-tcp-session-expiries {})
(afj-tcp-begin "silent-tx")
(afj-tcp-query {"token" "silent-tx"
                "statement" "SELECT * FROM silent_index_users WHERE id=1"})
(afj-tcp-query {"token" "silent-tx"
                "statement" "UPDATE silent_index_users SET name='merged-a' WHERE id=1"})
(afj-tcp-query {"token" "silent-tx"
                "statement" "UPDATE silent_index_users SET name='merged-b' WHERE id=2"})
(afj-tcp-commit-ast
  {"type" "insert" "table" "silent_revision_bump" "row" {"id" 1}})
(let [commit (afj-tcp-commit "silent-tx")
      indexed (execute-ast
                {"type" "select" "table" "silent_index_users"
                 "where" {"column" "name" "equals" "merged-a"}})
      scanned (execute-ast
                {"type" "select" "table" "silent_index_users"
                 "where" {"column" "marker" "equals" "a"}})
      index-rows (get indexed "rows")
      scan-rows (get scanned "rows")]
  (println (str "DB95_INDEX_MERGE commit=" (get commit "ok")
                " index=" (count index-rows)
                " scan=" (count scan-rows)
                " index_hash=" (sha256 (json_str index-rows))
                " scan_hash=" (sha256 (json_str scan-rows))))
  (if (and (get commit "ok")
           (= (json_str index-rows) (json_str scan-rows)))
    (println "PASS silent-merged-batch-index")
    (throw "INDEX_MISMATCH")))
