;; Native per-user cart SUM fixture agreed in msg_01bed72b575b.
;; Both users seeded; server SUM for user10 must be 3000 without client calculation.
(load "../src/sha1.fls")
(define usertotal-control (env-get "AFJ_NATIVE_SHOP_CART_USER_TOTAL_CONTROL"))
(define usertotal-connection (atom nil))
(define usertotal-buffer (atom ""))
(define usertotal-stage (atom "handshake"))
(define usertotal-sequence (atom 0))
(define usertotal-columns (atom []))
(define usertotal-rows (atom []))
(define usertotal-error (atom nil))
(define usertotal-done (atom false))
(define usertotal-statement (atom nil))

(defn usertotal-check [condition message]
  (if (= condition true) true (throw message)))

(defn usertotal-u32 [value]
  (buf-concat [(buf-u8 (rem value 256))
               (buf-u8 (rem (floor (/ value 256)) 256))
               (buf-u8 (rem (floor (/ value 65536)) 256))
               (buf-u8 (rem (floor (/ value 16777216)) 256))]))

(defn usertotal-read-u32 [bytes offset]
  (+ (buf-read-u8 bytes offset)
     (* 256 (buf-read-u8 bytes (+ offset 1)))
     (* 65536 (buf-read-u8 bytes (+ offset 2)))
     (* 16777216 (buf-read-u8 bytes (+ offset 3)))))

(defn usertotal-send [payload sequence next-stage response-sequence]
  (let [length (buf-len payload)
        frame (buf-concat [(buf-slice (usertotal-u32 length) 0 3)
                           (buf-u8 sequence) payload])]
    (reset! usertotal-stage next-stage)
    (reset! usertotal-sequence response-sequence)
    (usertotal-check (= (tcp-write (deref usertotal-connection) (buf-to-binary frame)) "ok")
                 "NATIVE_SHOP_CART_USER_TOTAL_PACKET_WRITE")))

(defn usertotal-command [code text next-stage]
  (usertotal-send (buf-concat [(buf-u8 code) (buf-str text)])
              0 next-stage 1))

(defn usertotal-text [bytes offset]
  (usertotal-check (< offset (buf-len bytes)) "NATIVE_SHOP_CART_USER_TOTAL_TEXT_PREFIX")
  (let [length (buf-read-u8 bytes offset) next (+ offset 1 length)]
    (usertotal-check (and (< length 251) (<= next (buf-len bytes)))
                 "NATIVE_SHOP_CART_USER_TOTAL_TEXT_LENGTH")
    {"value" (buf-read-str bytes (+ offset 1) length)
     "next" next}))

(defn usertotal-column-name [bytes]
  (loop [index 0 offset 0]
    (let [field (usertotal-text bytes offset)]
      (if (= index 4) (get field "value")
        (recur (+ index 1) (get field "next"))))))

(defn usertotal-login [bytes]
  (usertotal-check (= (buf-read-u8 bytes 0) 10) "NATIVE_SHOP_CART_USER_TOTAL_HANDSHAKE_VERSION")
  (let [version-end
          (loop [offset 1]
            (do
              (usertotal-check (< offset (buf-len bytes)) "NATIVE_SHOP_CART_USER_TOTAL_HANDSHAKE_LENGTH")
              (if (= (buf-read-u8 bytes offset) 0) offset (recur (+ offset 1)))))
        first-offset (+ version-end 5)
        second-offset (+ first-offset 27)]
    (usertotal-check (<= (+ second-offset 12) (buf-len bytes))
                 "NATIVE_SHOP_CART_USER_TOTAL_SCRAMBLE_LENGTH")
    (let [scramble (buf-concat [(buf-slice bytes first-offset 8)
                                (buf-slice bytes second-offset 12)])
          token (sha1-mysql-native-token "development-only" scramble)
          login (buf-concat [(usertotal-u32 172545) (usertotal-u32 1048576)
                             (buf-u8 33) (sha1-zero-bytes 23)
                             (buf-str "root") (buf-u8 0)
                             (buf-u8 20) token])]
      (usertotal-check (= (buf-len token) 20) "NATIVE_SHOP_CART_USER_TOTAL_TOKEN_LENGTH")
      (usertotal-send login 1 "login" 2))))

(defn usertotal-frame [bytes sequence]
  (usertotal-check (> (buf-len bytes) 0) "NATIVE_SHOP_CART_USER_TOTAL_EMPTY_PACKET")
  (usertotal-check (= sequence (deref usertotal-sequence)) "NATIVE_SHOP_CART_USER_TOTAL_PACKET_SEQUENCE")
  (swap! usertotal-sequence + 1)
  (let [stage (deref usertotal-stage) first-byte (buf-read-u8 bytes 0)]
    (if (= first-byte 255)
      (if (>= (buf-len bytes) 9)
        (throw (str "NATIVE_SHOP_CART_USER_TOTAL_SERVER_ERROR_" stage " code="
                    (+ (buf-read-u8 bytes 1) (* 256 (buf-read-u8 bytes 2)))
                    " message=" (buf-read-str bytes 9 (- (buf-len bytes) 9))))
        (throw (str "NATIVE_SHOP_CART_USER_TOTAL_SHORT_SERVER_ERROR_" stage)))
      nil)
    (cond
      (= stage "handshake") (usertotal-login bytes)
      (= stage "login")
        (do
          (usertotal-check (= first-byte 0) "NATIVE_SHOP_CART_USER_TOTAL_LOGIN_ACK")
          (usertotal-command 3 "CREATE TABLE shop_products (id INT PRIMARY KEY, sku TEXT, name TEXT, price INT)"
                           "create"))
      (= stage "create")
        (do
          (usertotal-check (= first-byte 0) "NATIVE_SHOP_CART_USER_TOTAL_CREATE_ACK")
          (usertotal-command 3 "INSERT INTO shop_products (id, sku, name, price) VALUES (1, 'SKU-1', 'Demo Widget', 1500)"
                           "seed"))
      (= stage "seed")
        (do
          (usertotal-check (= first-byte 0) "NATIVE_SHOP_CART_USER_TOTAL_FIRST_SEED_ACK")
          (usertotal-command 3 "INSERT INTO shop_products (id, sku, name, price) VALUES (2, 'SKU-2', 'Demo Gadget', 2200)"
                            "second-seed"))
      (= stage "second-seed")
        (do
          (usertotal-check (= first-byte 0) "NATIVE_SHOP_CART_USER_TOTAL_SECOND_PRODUCT_SEED_ACK")
          (usertotal-command 3 "CREATE TABLE shop_cart (id INT PRIMARY KEY, user_id INT, product_id INT, qty INT)" "cart-create"))
      (= stage "cart-create")
        (do
          (usertotal-check (= first-byte 0) "NATIVE_SHOP_CART_USER_TOTAL_CART_CREATE_ACK")
          (usertotal-command 3 "INSERT INTO shop_cart (id, user_id, product_id, qty) VALUES (1, 10, 1, 2)" "cart-seed"))
      (= stage "cart-seed")
        (do
          (usertotal-check (= first-byte 0) "NATIVE_SHOP_CART_USER_TOTAL_FIRST_CART_SEED_ACK")
          (usertotal-command 3 "INSERT INTO shop_cart (id, user_id, product_id, qty) VALUES (2, 20, 2, 1)" "second-cart-seed"))
      (= stage "second-cart-seed")
        (do
          (usertotal-check (= first-byte 0) "NATIVE_SHOP_CART_USER_TOTAL_SECOND_CART_SEED_ACK")
          (usertotal-command 22 "SELECT SUM(shop_cart.qty * shop_products.price) FROM shop_cart JOIN shop_products ON shop_cart.product_id = shop_products.id WHERE shop_cart.user_id=?" "prepare"))
      (= stage "prepare")
        (do
          (usertotal-check (and (= first-byte 0) (>= (buf-len bytes) 12))
                       "NATIVE_SHOP_CART_USER_TOTAL_PREPARE_ACK")
          (usertotal-check (and (= (buf-read-u8 bytes 7) 1)
                            (= (buf-read-u8 bytes 8) 0))
                       "NATIVE_SHOP_CART_USER_TOTAL_PREPARE_ONE_PARAMETER")
          (reset! usertotal-statement (usertotal-read-u32 bytes 1))
          (let [execute (buf-concat [(buf-u8 23) (usertotal-u32 (deref usertotal-statement))
                                     (buf-u8 0) (usertotal-u32 1)
                                     (buf-u8 0) (buf-u8 1) (buf-u8 3) (buf-u8 0)
                                     (usertotal-u32 10)])]
            (usertotal-send execute 0 "select" 1)))
      (= stage "select")
        (do
          (usertotal-check (and (= first-byte 1) (= (buf-len bytes) 1))
                       "NATIVE_SHOP_CART_USER_TOTAL_SELECT_ONE_COLUMN")
          (reset! usertotal-stage "columns"))
      (= stage "columns")
        (do
          (swap! usertotal-columns conj (usertotal-column-name bytes))
          (if (= (count (deref usertotal-columns)) 1)
            (reset! usertotal-stage "columns-end") nil))
      (= stage "columns-end")
        (do
          (usertotal-check (and (= first-byte 254) (= (buf-len bytes) 5))
                       "NATIVE_SHOP_CART_USER_TOTAL_COLUMN_EOF")
          (usertotal-check (> (count (get (deref usertotal-columns) 0)) 0)
                         "NATIVE_SHOP_CART_USER_TOTAL_EXPRESSION_COLUMN")
          (reset! usertotal-stage "rows"))
      (= stage "rows")
        (if (and (= first-byte 254) (= (buf-len bytes) 5))
          (do
            (usertotal-check (= (count (deref usertotal-rows)) 1)
                           "NATIVE_SHOP_CART_USER_TOTAL_EXACTLY_ONE_ROW")
            (usertotal-check (= (get (deref usertotal-rows) 0) "3000")
                           "NATIVE_SHOP_CART_USER_TOTAL_EXACT_SERVER_TOTAL")
            (reset! usertotal-stage "done")
            (reset! usertotal-done true))
          (do
            (usertotal-check (< (count (deref usertotal-rows)) 1)
                           "NATIVE_SHOP_CART_USER_TOTAL_EXTRA_ROW")
            (let [field (usertotal-text bytes 0)]
              (usertotal-check (= (get field "next") (buf-len bytes))
                             "NATIVE_SHOP_CART_USER_TOTAL_ROW_TRAILING_BYTES")
              (swap! usertotal-rows conj (get field "value")))))
      :else (throw "NATIVE_SHOP_CART_USER_TOTAL_UNEXPECTED_STAGE"))))

(defn usertotal-drain []
  (if (>= (buf-len (deref usertotal-buffer)) 4)
    (let [bytes (deref usertotal-buffer)
          length (+ (buf-read-u8 bytes 0) (* 256 (buf-read-u8 bytes 1))
                     (* 65536 (buf-read-u8 bytes 2)))]
      (usertotal-check (<= length 65536) "NATIVE_SHOP_CART_USER_TOTAL_PACKET_LIMIT")
      (if (>= (buf-len bytes) (+ 4 length))
        (do
          (reset! usertotal-buffer (buf-slice bytes (+ 4 length)
                                         (- (buf-len bytes) (+ 4 length))))
          (usertotal-frame (buf-slice bytes 4 length) (buf-read-u8 bytes 3))
          (usertotal-drain))
        nil))
    nil))

(defn native-shop-cart-user-total-handler [event connection payload peer]
  (try
    (cond
      (or (= event "connect") (= event "accept"))
        (do (usertotal-check (nil? (deref usertotal-connection)) "NATIVE_SHOP_CART_USER_TOTAL_SINGLE_CONNECTION")
            (reset! usertotal-connection connection))
      (= event "data")
        (do (reset! usertotal-buffer
              (buf-concat [(deref usertotal-buffer) (buf-from-binary payload)]))
            (usertotal-drain))
      (= event "close")
        (usertotal-check (deref usertotal-done) "NATIVE_SHOP_CART_USER_TOTAL_PREMATURE_CLOSE")
      :else nil)
    (catch [error]
      (reset! usertotal-error (error_message error))
      (reset! usertotal-done true))))

(usertotal-check (not (nil? usertotal-control)) "NATIVE_SHOP_CART_USER_TOTAL_HOST_ENV_REQUIRED")
(usertotal-check (not (file_exists (str usertotal-control "/ports.ready")))
             "NATIVE_SHOP_CART_USER_TOTAL_CONTROL_NOT_FRESH")
(let [bridge-port (tcp-client-free-port) daemon-port (tcp-client-free-port)]
  (usertotal-check (and (number? bridge-port) (number? daemon-port)
                    (not (= bridge-port daemon-port))) "NATIVE_SHOP_CART_USER_TOTAL_DISTINCT_PORTS")
  (usertotal-check (= (tcp-server-raw bridge-port "native-shop-cart-user-total-handler" "127.0.0.1") "ok")
               "NATIVE_SHOP_CART_USER_TOTAL_LISTENER_START")
  (try
    (do
      (file_write (str usertotal-control "/ports.json")
                  (json_str {"bridge" bridge-port "daemon" daemon-port}))
      (file_write (str usertotal-control "/ports.ready") "ready")
      (let [deadline (+ (now-ms) 30000)]
        (while (and (< (now-ms) deadline) (not (deref usertotal-done))) (fl-yield 10)))
      (usertotal-check (deref usertotal-done) "NATIVE_SHOP_CART_USER_TOTAL_CONTRACT_TIMEOUT")
      (if (nil? (deref usertotal-error)) nil (throw (deref usertotal-error)))
      (usertotal-check (= (deref usertotal-stage) "done") "NATIVE_SHOP_CART_USER_TOTAL_CONTRACT_INCOMPLETE")
      (usertotal-check (= (buf-len (deref usertotal-buffer)) 0) "NATIVE_SHOP_CART_USER_TOTAL_TRAILING_PACKET_BYTES"))
    (finally (tcp-server-stop bridge-port))))
(println (str "NATIVE_SHOP_CART_USER_TOTAL_RESULT "
  (json_str {"ok" true "prepared_parameters" 1
             "query" "SELECT SUM(shop_cart.qty * shop_products.price) FROM shop_cart JOIN shop_products ON shop_cart.product_id = shop_products.id WHERE shop_cart.user_id=?"
             "bind" [10] "select_executions" 1 "rows" 1
             "columns" (deref usertotal-columns) "data" (deref usertotal-rows)
             "exact_total" true "client_computes_total" false})))
(println "afj-db95 Native shop per-user cart total SUM prepared SELECT PASS")
