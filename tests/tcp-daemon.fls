;; Short-lived daemon harness used by the independent TCP integration test.
(load "../src/tcp-server.fls")

(let [started (start-afj-tcp)]
  (if (get started "ok")
    (do
      (println "afj-db95 TCP server STARTED")
      (set-timeout
        (fn []
          (do
            (stop-afj-tcp)
            (println "afj-db95 TCP server STOPPED")))
        60000))
    (throw "TCP daemon start failure")))
