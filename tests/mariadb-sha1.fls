;; AFJ-010 mysql_native_password digest vectors.
(load "../src/sha1.fls")
(load "../src/mariadb-wire.fls")

(let [empty (sha1-digest (afj-utf8-encode ""))
      abc (sha1-digest (afj-utf8-encode "abc"))
      long (sha1-digest (afj-utf8-encode (str-repeat "a" 80)))]
  (if (and (= empty "2jmj7l5rSw0yVb/vlWAYkK/YBwk=")
           (= abc "qZk+NkcGgWq6PiVxeFDCbJzQ2J0=")
           (= long "hvM2Uvz/1/oUQ+JG3TT+XQDiX/0="))
    (println "afj-db95 SHA-1 vectors PASS")
    (throw "SHA-1 vector mismatch")))

(let [scramble (mariadb-wire-new-scramble)
      other-scramble (mariadb-wire-new-scramble)
      token (sha1-mysql-native-token "development-only" scramble)
      wrong-token (sha1-mysql-native-token "wrong-password" scramble)]
  (if (and (= (buf-len scramble) 20)
           (not (= scramble other-scramble))
           (mariadb-wire-auth-valid? {"auth-response" token} scramble)
           (not (mariadb-wire-auth-valid? {"auth-response" wrong-token} scramble)))
    (println "afj-db95 MariaDB native token and random challenge PASS")
    (throw "MariaDB native token or random challenge mismatch")))
