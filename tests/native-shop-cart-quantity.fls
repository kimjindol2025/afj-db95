;; Native shop cart quantity fixture agreed in msg_68226856df04.
;; Seed qty=2; prepared UPDATE binds 5,1 then prepared SELECT verifies qty=5.
;; Reuses accepted Native transport; SQL core and protocol remain untouched.
(load "../src/sha1.fls")
(define quantity-control (env-get "AFJ_NATIVE_SHOP_CART_QUANTITY_CONTROL"))
(define quantity-connection (atom nil))
(define quantity-buffer (atom ""))
(define quantity-stage (atom "handshake"))
(define quantity-sequence (atom 0))
(define quantity-columns (atom []))
(define quantity-row (atom nil))
(define quantity-error (atom nil))
(define quantity-done (atom false))
(define quantity-statement (atom nil))
(define quantity-result-kind (atom "update"))
(define quantity-update-received (atom false))

(defn quantity-check [condition message]
  (if (= condition true) true (throw message)))

(defn quantity-u32 [value]
  (buf-concat [(buf-u8 (rem value 256))
               (buf-u8 (rem (floor (/ value 256)) 256))
               (buf-u8 (rem (floor (/ value 65536)) 256))
               (buf-u8 (rem (floor (/ value 16777216)) 256))]))

(defn quantity-read-u32 [bytes offset]
  (+ (buf-read-u8 bytes offset)
     (* 256 (buf-read-u8 bytes (+ offset 1)))
     (* 65536 (buf-read-u8 bytes (+ offset 2)))
     (* 16777216 (buf-read-u8 bytes (+ offset 3)))))

(defn quantity-send [payload sequence next-stage response-sequence]
  (let [length (buf-len payload)
        frame (buf-concat [(buf-slice (quantity-u32 length) 0 3)
                           (buf-u8 sequence) payload])]
    (reset! quantity-stage next-stage)
    (reset! quantity-sequence response-sequence)
    (quantity-check (= (tcp-write (deref quantity-connection) (buf-to-binary frame)) "ok")
                 "NATIVE_SHOP_CART_QUANTITY_PACKET_WRITE")))

(defn quantity-command [code text next-stage]
  (quantity-send (buf-concat [(buf-u8 code) (buf-str text)])
              0 next-stage 1))

(defn quantity-text [bytes offset]
  (quantity-check (< offset (buf-len bytes)) "NATIVE_SHOP_CART_QUANTITY_TEXT_PREFIX")
  (let [length (buf-read-u8 bytes offset) next (+ offset 1 length)]
    (quantity-check (and (< length 251) (<= next (buf-len bytes)))
                 "NATIVE_SHOP_CART_QUANTITY_TEXT_LENGTH")
    {"value" (buf-read-str bytes (+ offset 1) length)
     "next" next}))

(defn quantity-column-name [bytes]
  (loop [index 0 offset 0]
    (let [field (quantity-text bytes offset)]
      (if (= index 4) (get field "value")
        (recur (+ index 1) (get field "next"))))))

(defn quantity-row-map [bytes]
  (loop [index 0 offset 0 result {}]
    (if (= index 3)
      (do
        (quantity-check (= offset (buf-len bytes)) "NATIVE_SHOP_CART_QUANTITY_ROW_TRAILING_BYTES")
        result)
      (let [field (quantity-text bytes offset)]
        (recur (+ index 1) (get field "next")
               (assoc result (get (deref quantity-columns) index)
                             (get field "value")))))))

(defn quantity-login [bytes]
  (quantity-check (= (buf-read-u8 bytes 0) 10) "NATIVE_SHOP_CART_QUANTITY_HANDSHAKE_VERSION")
  (let [version-end
          (loop [offset 1]
            (do
              (quantity-check (< offset (buf-len bytes)) "NATIVE_SHOP_CART_QUANTITY_HANDSHAKE_LENGTH")
              (if (= (buf-read-u8 bytes offset) 0) offset (recur (+ offset 1)))))
        first-offset (+ version-end 5)
        second-offset (+ first-offset 27)]
    (quantity-check (<= (+ second-offset 12) (buf-len bytes))
                 "NATIVE_SHOP_CART_QUANTITY_SCRAMBLE_LENGTH")
    (let [scramble (buf-concat [(buf-slice bytes first-offset 8)
                                (buf-slice bytes second-offset 12)])
          token (sha1-mysql-native-token "development-only" scramble)
          login (buf-concat [(quantity-u32 172545) (quantity-u32 1048576)
                             (buf-u8 33) (sha1-zero-bytes 23)
                             (buf-str "root") (buf-u8 0)
                             (buf-u8 20) token])]
      (quantity-check (= (buf-len token) 20) "NATIVE_SHOP_CART_QUANTITY_TOKEN_LENGTH")
      (quantity-send login 1 "login" 2))))

(defn quantity-frame [bytes sequence]
  (quantity-check (> (buf-len bytes) 0) "NATIVE_SHOP_CART_QUANTITY_EMPTY_PACKET")
  (quantity-check (= sequence (deref quantity-sequence)) "NATIVE_SHOP_CART_QUANTITY_PACKET_SEQUENCE")
  (swap! quantity-sequence + 1)
  (let [stage (deref quantity-stage) first-byte (buf-read-u8 bytes 0)]
    (if (= first-byte 255)
      (if (>= (buf-len bytes) 9)
        (throw (str "NATIVE_SHOP_CART_QUANTITY_SERVER_ERROR_" stage " code="
                    (+ (buf-read-u8 bytes 1) (* 256 (buf-read-u8 bytes 2)))
                    " message=" (buf-read-str bytes 9 (- (buf-len bytes) 9))))
        (throw (str "NATIVE_SHOP_CART_QUANTITY_SHORT_SERVER_ERROR_" stage)))
      nil)
    (cond
      (= stage "handshake") (quantity-login bytes)
      (= stage "login")
        (do
          (quantity-check (= first-byte 0) "NATIVE_SHOP_CART_QUANTITY_LOGIN_ACK")
          (quantity-command 3 "CREATE TABLE shop_products (id INT PRIMARY KEY, sku TEXT, name TEXT, price INT)"
                           "products-create"))
      (= stage "products-create")
        (do
          (quantity-check (= first-byte 0) "NATIVE_SHOP_CART_QUANTITY_PRODUCTS_CREATE_ACK")
          (quantity-command 3 "INSERT INTO shop_products (id, sku, name, price) VALUES (1, 'SKU-1', 'Demo Widget', 1500)"
                           "products-seed"))
      (= stage "products-seed")
        (do
          (quantity-check (= first-byte 0) "NATIVE_SHOP_CART_QUANTITY_PRODUCTS_SEED_ACK")
          (quantity-command 3 "CREATE TABLE shop_cart (id INT PRIMARY KEY, product_id INT, qty INT)"
                           "cart-create"))
      (= stage "cart-create")
        (do
          (quantity-check (= first-byte 0) "NATIVE_SHOP_CART_QUANTITY_CART_CREATE_ACK")
          (quantity-command 3 "INSERT INTO shop_cart (id, product_id, qty) VALUES (1, 1, 2)"
                              "cart-seed"))
      (= stage "cart-seed")
        (do
          (quantity-check (= first-byte 0) "NATIVE_SHOP_CART_QUANTITY_CART_SEED_ACK")
          (quantity-command 22 "UPDATE shop_cart SET qty=? WHERE id=?" "update-prepare"))
      (= stage "update-prepare")
        (do
          (quantity-check (and (= first-byte 0) (>= (buf-len bytes) 12))
                          "NATIVE_SHOP_CART_QUANTITY_UPDATE_PREPARE_ACK")
          (quantity-check (and (= (buf-read-u8 bytes 7) 2)
                              (= (buf-read-u8 bytes 8) 0))
                          "NATIVE_SHOP_CART_QUANTITY_UPDATE_TWO_PARAMETERS")
          (reset! quantity-statement (quantity-read-u32 bytes 1))
          (let [execute (buf-concat [(buf-u8 23) (quantity-u32 (deref quantity-statement))
                                    (buf-u8 0) (quantity-u32 1)
                                    (buf-u8 0) (buf-u8 1)
                                    (buf-u8 3) (buf-u8 0) (buf-u8 3) (buf-u8 0)
                                    (quantity-u32 5) (quantity-u32 1)])]
            (quantity-send execute 0 "select" 1)))
      (= stage "select-prepare")
        (do
          (quantity-check (and (= first-byte 0) (>= (buf-len bytes) 12))
                       "NATIVE_SHOP_CART_QUANTITY_SELECT_PREPARE_ACK")
          (quantity-check (and (= (buf-read-u8 bytes 7) 1)
                            (= (buf-read-u8 bytes 8) 0))
                       "NATIVE_SHOP_CART_QUANTITY_SELECT_ONE_PARAMETER")
          (reset! quantity-statement (quantity-read-u32 bytes 1))
          (let [execute (buf-concat [(buf-u8 23) (quantity-u32 (deref quantity-statement))
                                     (buf-u8 0) (quantity-u32 1)
                                     (buf-u8 0) (buf-u8 1)
                                     (buf-u8 3) (buf-u8 0) (quantity-u32 1)])]
            (quantity-send execute 0 "select" 1)))
      (= stage "select")
        (do
          (quantity-check (and (= first-byte 3) (= (buf-len bytes) 1))
                       "NATIVE_SHOP_CART_QUANTITY_SELECT_THREE_COLUMNS")
          (reset! quantity-stage "columns"))
      (= stage "columns")
        (do
          (swap! quantity-columns conj (quantity-column-name bytes))
          (if (= (count (deref quantity-columns)) 3)
            (reset! quantity-stage "columns-end") nil))
      (= stage "columns-end")
        (do
          (quantity-check (and (= first-byte 254) (= (buf-len bytes) 5))
                       "NATIVE_SHOP_CART_QUANTITY_COLUMN_EOF")
          (quantity-check (and (= (get (deref quantity-columns) 0) "id")
                            (= (get (deref quantity-columns) 1) "product_id")
                            (= (get (deref quantity-columns) 2) "qty"))
                       "NATIVE_SHOP_CART_QUANTITY_CART_SCHEMA")
          (reset! quantity-stage "row"))
      (= stage "row")
        (do (reset! quantity-row (quantity-row-map bytes))
            (reset! quantity-stage "row-end"))
      (= stage "row-end")
        (do
          (quantity-check (and (= first-byte 254) (= (buf-len bytes) 5))
                       "NATIVE_SHOP_CART_QUANTITY_EXACTLY_ONE_ROW")
          (quantity-check (and (= (count (keys (deref quantity-row))) 3)
                            (= (get (deref quantity-row) "id") "1")
                            (= (get (deref quantity-row) "product_id") "1")
                            (= (get (deref quantity-row) "qty") "5"))
                       "NATIVE_SHOP_CART_QUANTITY_EXACT_CART_ROW")
          (if (= (deref quantity-result-kind) "update")
            (do
              (reset! quantity-update-received true)
              (reset! quantity-result-kind "select")
              (reset! quantity-columns [])
              (reset! quantity-row nil)
              (quantity-command 22 "SELECT id, product_id, qty FROM shop_cart WHERE id=?"
                                  "select-prepare"))
            (do
              (reset! quantity-stage "done")
              (reset! quantity-done true))))
      :else (throw "NATIVE_SHOP_CART_QUANTITY_UNEXPECTED_STAGE"))))

(defn quantity-drain []
  (if (>= (buf-len (deref quantity-buffer)) 4)
    (let [bytes (deref quantity-buffer)
          length (+ (buf-read-u8 bytes 0) (* 256 (buf-read-u8 bytes 1))
                     (* 65536 (buf-read-u8 bytes 2)))]
      (quantity-check (<= length 65536) "NATIVE_SHOP_CART_QUANTITY_PACKET_LIMIT")
      (if (>= (buf-len bytes) (+ 4 length))
        (do
          (reset! quantity-buffer (buf-slice bytes (+ 4 length)
                                         (- (buf-len bytes) (+ 4 length))))
          (quantity-frame (buf-slice bytes 4 length) (buf-read-u8 bytes 3))
          (quantity-drain))
        nil))
    nil))

(defn native-shop-cart-quantity-handler [event connection payload peer]
  (try
    (cond
      (or (= event "connect") (= event "accept"))
        (do (quantity-check (nil? (deref quantity-connection)) "NATIVE_SHOP_CART_QUANTITY_SINGLE_CONNECTION")
            (reset! quantity-connection connection))
      (= event "data")
        (do (reset! quantity-buffer
              (buf-concat [(deref quantity-buffer) (buf-from-binary payload)]))
            (quantity-drain))
      (= event "close")
        (quantity-check (deref quantity-done) "NATIVE_SHOP_CART_QUANTITY_PREMATURE_CLOSE")
      :else nil)
    (catch [error]
      (reset! quantity-error (error_message error))
      (reset! quantity-done true))))

(quantity-check (not (nil? quantity-control)) "NATIVE_SHOP_CART_QUANTITY_HOST_ENV_REQUIRED")
(quantity-check (not (file_exists (str quantity-control "/ports.ready")))
             "NATIVE_SHOP_CART_QUANTITY_CONTROL_NOT_FRESH")
(let [bridge-port (tcp-client-free-port) daemon-port (tcp-client-free-port)]
  (quantity-check (and (number? bridge-port) (number? daemon-port)
                    (not (= bridge-port daemon-port))) "NATIVE_SHOP_CART_QUANTITY_DISTINCT_PORTS")
  (quantity-check (= (tcp-server-raw bridge-port "native-shop-cart-quantity-handler" "127.0.0.1") "ok")
               "NATIVE_SHOP_CART_QUANTITY_LISTENER_START")
  (try
    (do
      (file_write (str quantity-control "/ports.json")
                  (json_str {"bridge" bridge-port "daemon" daemon-port}))
      (file_write (str quantity-control "/ports.ready") "ready")
      (let [deadline (+ (now-ms) 30000)]
        (while (and (< (now-ms) deadline) (not (deref quantity-done))) (fl-yield 10)))
      (quantity-check (deref quantity-done) "NATIVE_SHOP_CART_QUANTITY_CONTRACT_TIMEOUT")
      (if (nil? (deref quantity-error)) nil (throw (deref quantity-error)))
      (quantity-check (= (deref quantity-stage) "done") "NATIVE_SHOP_CART_QUANTITY_CONTRACT_INCOMPLETE")
      (quantity-check (deref quantity-update-received) "NATIVE_SHOP_CART_QUANTITY_UPDATE_RESULT_MISSING")
      (quantity-check (= (buf-len (deref quantity-buffer)) 0) "NATIVE_SHOP_CART_QUANTITY_TRAILING_PACKET_BYTES"))
    (finally (tcp-server-stop bridge-port))))
(println (str "NATIVE_SHOP_CART_QUANTITY_RESULT "
  (json_str {"ok" true "table" "shop_cart" "initial_qty" 2
             "update_sql" "UPDATE shop_cart SET qty=? WHERE id=?"
             "update_bind" [5 1] "prepared_update_executions" 1
             "update_result_received" (deref quantity-update-received)
             "select_sql" "SELECT id, product_id, qty FROM shop_cart WHERE id=?"
             "select_bind" [1] "prepared_select_executions" 1
             "rows" 1 "columns" (deref quantity-columns) "row" (deref quantity-row)
             "exact_select" true})))
(println "afj-db95 Native shop cart quantity prepared UPDATE SELECT PASS")
