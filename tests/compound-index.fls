;; AFJ-013 compound UNIQUE key and index maintenance contract.
(load "/root/kilo-freelang/projects/afj-db95/src/engine.fls")
(load "/root/kilo-freelang/projects/afj-db95/src/sql-core.fls")

(let [left (engine-composite-key-token {"tenant" "a|b" "email" "c"}
                                       ["tenant" "email"])
      right (engine-composite-key-token {"tenant" "a" "email" "b|c"}
                                        ["tenant" "email"])
      number (engine-composite-key-token {"tenant" 1 "email" "x"}
                                         ["tenant" "email"])
      text (engine-composite-key-token {"tenant" "1" "email" "x"}
                                       ["tenant" "email"])]
  (if (and (not (= left right))
           (= (engine-composite-key-part left 0) "a|b")
           (= (engine-composite-key-part right 1) "b|c")
           (not (= number text)))
    (println "afj-db95 composite key encoding edge cases PASS")
    (throw "composite key encoding collision")))

(reset! engine-catalog {})
(reset! engine-indexes {})
(let [create (parse-sql
               "CREATE TABLE compound_users (tenant TEXT, email TEXT, UNIQUE (tenant,email))")]
  (execute-ast create))
(execute-ast {"type" "insert" "table" "compound_users"
             "row" {"tenant" "a" "email" "same@example.test"}})
(execute-ast {"type" "insert" "table" "compound_users"
             "row" {"tenant" "b" "email" "same@example.test"}})
(let [query (execute-ast
              (parse-sql
                "SELECT * FROM compound_users WHERE tenant = 'a' AND email = 'same@example.test'"))]
  (if (and (= (get query "plan") "index-scan")
           (= (count (get query "rows")) 1)
           (= (get (first (get query "rows")) "tenant") "a"))
    (println "afj-db95 compound index lookup PASS")
    (throw "compound index lookup failed")))
(let [duplicate (try
                  (do
                    (execute-ast {"type" "insert" "table" "compound_users"
                                  "row" {"tenant" "a" "email" "same@example.test"}})
                    nil)
                  (catch [error] error))
      index (get (deref engine-indexes) "compound_users.tenant|email")
      bucket (get (get index "buckets")
               (engine-composite-key-token
                 {"tenant" "a" "email" "same@example.test"}
                 ["tenant" "email"]))]
  (if (and (regex_match_i (error_message duplicate) ".*UNIQUE_VIOLATION.*")
           (= (count bucket) 1)
           (= (count (get (get (get (deref engine-catalog) "compound_users")
                                 "schema") "unique-groups")) 1))
    (println "afj-db95 compound unique index PASS")
    (throw "compound unique index failure")))
