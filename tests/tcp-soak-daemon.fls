;; Long-soak daemon with a shutdown window longer than the workload.
(load "../src/tcp-server.fls")
(let [soak-raw (env-get "AFJ_SOAK_MS")
      soak-ms (if (nil? soak-raw) 60000 (str-to-num soak-raw))
      started (start-afj-tcp)]
  (if (get started "ok")
    (do
      (println "afj-db95 TCP soak server STARTED")
      (set-timeout (fn [] (stop-afj-tcp)) (+ soak-ms 60000)))
    (throw "TCP soak daemon start failure")))
