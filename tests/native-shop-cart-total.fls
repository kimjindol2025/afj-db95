;; Native cart SUM fixture agreed in msg_f9225cf4690c.
;; Same two product/cart seeds; read one server SUM value 5200 without client addition.
;; Reuses case71 Native transport; fixed host supplies owned process lifetimes.
(load "../src/sha1.fls")
(define listing-control (env-get "AFJ_NATIVE_SHOP_CART_TOTAL_CONTROL"))
(define listing-connection (atom nil))
(define listing-buffer (atom ""))
(define listing-stage (atom "handshake"))
(define listing-sequence (atom 0))
(define listing-columns (atom []))
(define listing-rows (atom []))
(define listing-error (atom nil))
(define listing-done (atom false))
(define listing-statement (atom nil))

(defn listing-check [condition message]
  (if (= condition true) true (throw message)))

(defn listing-u32 [value]
  (buf-concat [(buf-u8 (rem value 256))
               (buf-u8 (rem (floor (/ value 256)) 256))
               (buf-u8 (rem (floor (/ value 65536)) 256))
               (buf-u8 (rem (floor (/ value 16777216)) 256))]))

(defn listing-read-u32 [bytes offset]
  (+ (buf-read-u8 bytes offset)
     (* 256 (buf-read-u8 bytes (+ offset 1)))
     (* 65536 (buf-read-u8 bytes (+ offset 2)))
     (* 16777216 (buf-read-u8 bytes (+ offset 3)))))

(defn listing-send [payload sequence next-stage response-sequence]
  (let [length (buf-len payload)
        frame (buf-concat [(buf-slice (listing-u32 length) 0 3)
                           (buf-u8 sequence) payload])]
    (reset! listing-stage next-stage)
    (reset! listing-sequence response-sequence)
    (listing-check (= (tcp-write (deref listing-connection) (buf-to-binary frame)) "ok")
                 "NATIVE_SHOP_CART_TOTAL_PACKET_WRITE")))

(defn listing-command [code text next-stage]
  (listing-send (buf-concat [(buf-u8 code) (buf-str text)])
              0 next-stage 1))

(defn listing-text [bytes offset]
  (listing-check (< offset (buf-len bytes)) "NATIVE_SHOP_CART_TOTAL_TEXT_PREFIX")
  (let [length (buf-read-u8 bytes offset) next (+ offset 1 length)]
    (listing-check (and (< length 251) (<= next (buf-len bytes)))
                 "NATIVE_SHOP_CART_TOTAL_TEXT_LENGTH")
    {"value" (buf-read-str bytes (+ offset 1) length)
     "next" next}))

(defn listing-column-name [bytes]
  (loop [index 0 offset 0]
    (let [field (listing-text bytes offset)]
      (if (= index 4) (get field "value")
        (recur (+ index 1) (get field "next"))))))

(defn listing-login [bytes]
  (listing-check (= (buf-read-u8 bytes 0) 10) "NATIVE_SHOP_CART_TOTAL_HANDSHAKE_VERSION")
  (let [version-end
          (loop [offset 1]
            (do
              (listing-check (< offset (buf-len bytes)) "NATIVE_SHOP_CART_TOTAL_HANDSHAKE_LENGTH")
              (if (= (buf-read-u8 bytes offset) 0) offset (recur (+ offset 1)))))
        first-offset (+ version-end 5)
        second-offset (+ first-offset 27)]
    (listing-check (<= (+ second-offset 12) (buf-len bytes))
                 "NATIVE_SHOP_CART_TOTAL_SCRAMBLE_LENGTH")
    (let [scramble (buf-concat [(buf-slice bytes first-offset 8)
                                (buf-slice bytes second-offset 12)])
          token (sha1-mysql-native-token "development-only" scramble)
          login (buf-concat [(listing-u32 172545) (listing-u32 1048576)
                             (buf-u8 33) (sha1-zero-bytes 23)
                             (buf-str "root") (buf-u8 0)
                             (buf-u8 20) token])]
      (listing-check (= (buf-len token) 20) "NATIVE_SHOP_CART_TOTAL_TOKEN_LENGTH")
      (listing-send login 1 "login" 2))))

(defn listing-frame [bytes sequence]
  (listing-check (> (buf-len bytes) 0) "NATIVE_SHOP_CART_TOTAL_EMPTY_PACKET")
  (listing-check (= sequence (deref listing-sequence)) "NATIVE_SHOP_CART_TOTAL_PACKET_SEQUENCE")
  (swap! listing-sequence + 1)
  (let [stage (deref listing-stage) first-byte (buf-read-u8 bytes 0)]
    (if (= first-byte 255)
      (if (>= (buf-len bytes) 9)
        (throw (str "NATIVE_SHOP_CART_TOTAL_SERVER_ERROR_" stage " code="
                    (+ (buf-read-u8 bytes 1) (* 256 (buf-read-u8 bytes 2)))
                    " message=" (buf-read-str bytes 9 (- (buf-len bytes) 9))))
        (throw (str "NATIVE_SHOP_CART_TOTAL_SHORT_SERVER_ERROR_" stage)))
      nil)
    (cond
      (= stage "handshake") (listing-login bytes)
      (= stage "login")
        (do
          (listing-check (= first-byte 0) "NATIVE_SHOP_CART_TOTAL_LOGIN_ACK")
          (listing-command 3 "CREATE TABLE shop_products (id INT PRIMARY KEY, sku TEXT, name TEXT, price INT)"
                           "create"))
      (= stage "create")
        (do
          (listing-check (= first-byte 0) "NATIVE_SHOP_CART_TOTAL_CREATE_ACK")
          (listing-command 3 "INSERT INTO shop_products (id, sku, name, price) VALUES (1, 'SKU-1', 'Demo Widget', 1500)"
                           "seed"))
      (= stage "seed")
        (do
          (listing-check (= first-byte 0) "NATIVE_SHOP_CART_TOTAL_FIRST_SEED_ACK")
          (listing-command 3 "INSERT INTO shop_products (id, sku, name, price) VALUES (2, 'SKU-2', 'Demo Gadget', 2200)"
                            "second-seed"))
      (= stage "second-seed")
        (do
          (listing-check (= first-byte 0) "NATIVE_SHOP_CART_TOTAL_SECOND_PRODUCT_SEED_ACK")
          (listing-command 3 "CREATE TABLE shop_cart (id INT PRIMARY KEY, product_id INT, qty INT)" "cart-create"))
      (= stage "cart-create")
        (do
          (listing-check (= first-byte 0) "NATIVE_SHOP_CART_TOTAL_CART_CREATE_ACK")
          (listing-command 3 "INSERT INTO shop_cart (id, product_id, qty) VALUES (1, 1, 2)" "cart-seed"))
      (= stage "cart-seed")
        (do
          (listing-check (= first-byte 0) "NATIVE_SHOP_CART_TOTAL_FIRST_CART_SEED_ACK")
          (listing-command 3 "INSERT INTO shop_cart (id, product_id, qty) VALUES (2, 2, 1)" "second-cart-seed"))
      (= stage "second-cart-seed")
        (do
          (listing-check (= first-byte 0) "NATIVE_SHOP_CART_TOTAL_SECOND_CART_SEED_ACK")
          (listing-command 22 "SELECT SUM(shop_cart.qty * shop_products.price) FROM shop_cart JOIN shop_products ON shop_cart.product_id = shop_products.id" "prepare"))
      (= stage "prepare")
        (do
          (listing-check (and (= first-byte 0) (>= (buf-len bytes) 12))
                       "NATIVE_SHOP_CART_TOTAL_PREPARE_ACK")
          (listing-check (and (= (buf-read-u8 bytes 7) 0)
                            (= (buf-read-u8 bytes 8) 0))
                       "NATIVE_SHOP_CART_TOTAL_PREPARE_ZERO_PARAMETERS")
          (reset! listing-statement (listing-read-u32 bytes 1))
          (let [execute (buf-concat [(buf-u8 23) (listing-u32 (deref listing-statement))
                                     (buf-u8 0) (listing-u32 1)])]
            (listing-send execute 0 "select" 1)))
      (= stage "select")
        (do
          (listing-check (and (= first-byte 1) (= (buf-len bytes) 1))
                       "NATIVE_SHOP_CART_TOTAL_SELECT_ONE_COLUMN")
          (reset! listing-stage "columns"))
      (= stage "columns")
        (do
          (swap! listing-columns conj (listing-column-name bytes))
          (if (= (count (deref listing-columns)) 1)
            (reset! listing-stage "columns-end") nil))
      (= stage "columns-end")
        (do
          (listing-check (and (= first-byte 254) (= (buf-len bytes) 5))
                       "NATIVE_SHOP_CART_TOTAL_COLUMN_EOF")
          (listing-check (> (count (get (deref listing-columns) 0)) 0)
                         "NATIVE_SHOP_CART_TOTAL_EXPRESSION_COLUMN")
          (reset! listing-stage "rows"))
      (= stage "rows")
        (if (and (= first-byte 254) (= (buf-len bytes) 5))
          (do
            (listing-check (= (count (deref listing-rows)) 1)
                           "NATIVE_SHOP_CART_TOTAL_EXACTLY_ONE_ROW")
            (listing-check (= (get (deref listing-rows) 0) "5200")
                           "NATIVE_SHOP_CART_TOTAL_EXACT_SERVER_TOTAL")
            (reset! listing-stage "done")
            (reset! listing-done true))
          (do
            (listing-check (< (count (deref listing-rows)) 1)
                           "NATIVE_SHOP_CART_TOTAL_EXTRA_ROW")
            (let [field (listing-text bytes 0)]
              (listing-check (= (get field "next") (buf-len bytes))
                             "NATIVE_SHOP_CART_TOTAL_ROW_TRAILING_BYTES")
              (swap! listing-rows conj (get field "value")))))
      :else (throw "NATIVE_SHOP_CART_TOTAL_UNEXPECTED_STAGE"))))

(defn listing-drain []
  (if (>= (buf-len (deref listing-buffer)) 4)
    (let [bytes (deref listing-buffer)
          length (+ (buf-read-u8 bytes 0) (* 256 (buf-read-u8 bytes 1))
                     (* 65536 (buf-read-u8 bytes 2)))]
      (listing-check (<= length 65536) "NATIVE_SHOP_CART_TOTAL_PACKET_LIMIT")
      (if (>= (buf-len bytes) (+ 4 length))
        (do
          (reset! listing-buffer (buf-slice bytes (+ 4 length)
                                         (- (buf-len bytes) (+ 4 length))))
          (listing-frame (buf-slice bytes 4 length) (buf-read-u8 bytes 3))
          (listing-drain))
        nil))
    nil))

(defn native-shop-cart-total-handler [event connection payload peer]
  (try
    (cond
      (or (= event "connect") (= event "accept"))
        (do (listing-check (nil? (deref listing-connection)) "NATIVE_SHOP_CART_TOTAL_SINGLE_CONNECTION")
            (reset! listing-connection connection))
      (= event "data")
        (do (reset! listing-buffer
              (buf-concat [(deref listing-buffer) (buf-from-binary payload)]))
            (listing-drain))
      (= event "close")
        (listing-check (deref listing-done) "NATIVE_SHOP_CART_TOTAL_PREMATURE_CLOSE")
      :else nil)
    (catch [error]
      (reset! listing-error (error_message error))
      (reset! listing-done true))))

(listing-check (not (nil? listing-control)) "NATIVE_SHOP_CART_TOTAL_HOST_ENV_REQUIRED")
(listing-check (not (file_exists (str listing-control "/ports.ready")))
             "NATIVE_SHOP_CART_TOTAL_CONTROL_NOT_FRESH")
(let [bridge-port (tcp-client-free-port) daemon-port (tcp-client-free-port)]
  (listing-check (and (number? bridge-port) (number? daemon-port)
                    (not (= bridge-port daemon-port))) "NATIVE_SHOP_CART_TOTAL_DISTINCT_PORTS")
  (listing-check (= (tcp-server-raw bridge-port "native-shop-cart-total-handler" "127.0.0.1") "ok")
               "NATIVE_SHOP_CART_TOTAL_LISTENER_START")
  (try
    (do
      (file_write (str listing-control "/ports.json")
                  (json_str {"bridge" bridge-port "daemon" daemon-port}))
      (file_write (str listing-control "/ports.ready") "ready")
      (let [deadline (+ (now-ms) 30000)]
        (while (and (< (now-ms) deadline) (not (deref listing-done))) (fl-yield 10)))
      (listing-check (deref listing-done) "NATIVE_SHOP_CART_TOTAL_CONTRACT_TIMEOUT")
      (if (nil? (deref listing-error)) nil (throw (deref listing-error)))
      (listing-check (= (deref listing-stage) "done") "NATIVE_SHOP_CART_TOTAL_CONTRACT_INCOMPLETE")
      (listing-check (= (buf-len (deref listing-buffer)) 0) "NATIVE_SHOP_CART_TOTAL_TRAILING_PACKET_BYTES"))
    (finally (tcp-server-stop bridge-port))))
(println (str "NATIVE_SHOP_CART_TOTAL_RESULT "
  (json_str {"ok" true "prepared_parameters" 0
             "query" "SELECT SUM(shop_cart.qty * shop_products.price) FROM shop_cart JOIN shop_products ON shop_cart.product_id = shop_products.id"
             "bind" [] "select_executions" 1 "rows" 1
             "columns" (deref listing-columns) "data" (deref listing-rows)
             "exact_total" true "client_computes_total" false})))
(println "afj-db95 Native shop cart total SUM prepared SELECT PASS")
