;; Native shop order fixture agreed in msg_6b76a26f83c3.
;; Product/cart seed and exact spaced order PREPARE INSERT and SELECT.
;; Reuses accepted Native transport; SQL core and protocol remain untouched.
(load "../src/sha1.fls")
(define orders-control (env-get "AFJ_NATIVE_SHOP_ORDERS_CONTROL"))
(define orders-connection (atom nil))
(define orders-buffer (atom ""))
(define orders-stage (atom "handshake"))
(define orders-sequence (atom 0))
(define orders-columns (atom []))
(define orders-row (atom nil))
(define orders-error (atom nil))
(define orders-done (atom false))
(define orders-statement (atom nil))

(defn orders-check [condition message]
  (if (= condition true) true (throw message)))

(defn orders-u32 [value]
  (buf-concat [(buf-u8 (rem value 256))
               (buf-u8 (rem (floor (/ value 256)) 256))
               (buf-u8 (rem (floor (/ value 65536)) 256))
               (buf-u8 (rem (floor (/ value 16777216)) 256))]))

(defn orders-read-u32 [bytes offset]
  (+ (buf-read-u8 bytes offset)
     (* 256 (buf-read-u8 bytes (+ offset 1)))
     (* 65536 (buf-read-u8 bytes (+ offset 2)))
     (* 16777216 (buf-read-u8 bytes (+ offset 3)))))

(defn orders-send [payload sequence next-stage response-sequence]
  (let [length (buf-len payload)
        frame (buf-concat [(buf-slice (orders-u32 length) 0 3)
                           (buf-u8 sequence) payload])]
    (reset! orders-stage next-stage)
    (reset! orders-sequence response-sequence)
    (orders-check (= (tcp-write (deref orders-connection) (buf-to-binary frame)) "ok")
                 "NATIVE_SHOP_ORDERS_PACKET_WRITE")))

(defn orders-command [code text next-stage]
  (orders-send (buf-concat [(buf-u8 code) (buf-str text)])
              0 next-stage 1))

(defn orders-text [bytes offset]
  (orders-check (< offset (buf-len bytes)) "NATIVE_SHOP_ORDERS_TEXT_PREFIX")
  (let [length (buf-read-u8 bytes offset) next (+ offset 1 length)]
    (orders-check (and (< length 251) (<= next (buf-len bytes)))
                 "NATIVE_SHOP_ORDERS_TEXT_LENGTH")
    {"value" (buf-read-str bytes (+ offset 1) length)
     "next" next}))

(defn orders-column-name [bytes]
  (loop [index 0 offset 0]
    (let [field (orders-text bytes offset)]
      (if (= index 4) (get field "value")
        (recur (+ index 1) (get field "next"))))))

(defn orders-row-map [bytes]
  (loop [index 0 offset 0 result {}]
    (if (= index 4)
      (do
        (orders-check (= offset (buf-len bytes)) "NATIVE_SHOP_ORDERS_ROW_TRAILING_BYTES")
        result)
      (let [field (orders-text bytes offset)]
        (recur (+ index 1) (get field "next")
               (assoc result (get (deref orders-columns) index)
                             (get field "value")))))))

(defn orders-login [bytes]
  (orders-check (= (buf-read-u8 bytes 0) 10) "NATIVE_SHOP_ORDERS_HANDSHAKE_VERSION")
  (let [version-end
          (loop [offset 1]
            (do
              (orders-check (< offset (buf-len bytes)) "NATIVE_SHOP_ORDERS_HANDSHAKE_LENGTH")
              (if (= (buf-read-u8 bytes offset) 0) offset (recur (+ offset 1)))))
        first-offset (+ version-end 5)
        second-offset (+ first-offset 27)]
    (orders-check (<= (+ second-offset 12) (buf-len bytes))
                 "NATIVE_SHOP_ORDERS_SCRAMBLE_LENGTH")
    (let [scramble (buf-concat [(buf-slice bytes first-offset 8)
                                (buf-slice bytes second-offset 12)])
          token (sha1-mysql-native-token "development-only" scramble)
          login (buf-concat [(orders-u32 172545) (orders-u32 1048576)
                             (buf-u8 33) (sha1-zero-bytes 23)
                             (buf-str "root") (buf-u8 0)
                             (buf-u8 20) token])]
      (orders-check (= (buf-len token) 20) "NATIVE_SHOP_ORDERS_TOKEN_LENGTH")
      (orders-send login 1 "login" 2))))

(defn orders-frame [bytes sequence]
  (orders-check (> (buf-len bytes) 0) "NATIVE_SHOP_ORDERS_EMPTY_PACKET")
  (orders-check (= sequence (deref orders-sequence)) "NATIVE_SHOP_ORDERS_PACKET_SEQUENCE")
  (swap! orders-sequence + 1)
  (let [stage (deref orders-stage) first-byte (buf-read-u8 bytes 0)]
    (if (= first-byte 255)
      (if (>= (buf-len bytes) 9)
        (throw (str "NATIVE_SHOP_ORDERS_SERVER_ERROR_" stage " code="
                    (+ (buf-read-u8 bytes 1) (* 256 (buf-read-u8 bytes 2)))
                    " message=" (buf-read-str bytes 9 (- (buf-len bytes) 9))))
        (throw (str "NATIVE_SHOP_ORDERS_SHORT_SERVER_ERROR_" stage)))
      nil)
    (cond
      (= stage "handshake") (orders-login bytes)
      (= stage "login")
        (do
          (orders-check (= first-byte 0) "NATIVE_SHOP_ORDERS_LOGIN_ACK")
          (orders-command 3 "CREATE TABLE shop_products (id INT PRIMARY KEY, sku TEXT, name TEXT, price INT)"
                           "products-create"))
      (= stage "products-create")
        (do
          (orders-check (= first-byte 0) "NATIVE_SHOP_ORDERS_PRODUCTS_CREATE_ACK")
          (orders-command 3 "INSERT INTO shop_products (id, sku, name, price) VALUES (1, 'SKU-1', 'Demo Widget', 1500)"
                           "products-seed"))
      (= stage "products-seed")
        (do
          (orders-check (= first-byte 0) "NATIVE_SHOP_ORDERS_PRODUCTS_SEED_ACK")
          (orders-command 3 "CREATE TABLE shop_cart (id INT PRIMARY KEY, product_id INT, qty INT)"
                           "cart-create"))
      (= stage "cart-create")
        (do
          (orders-check (= first-byte 0) "NATIVE_SHOP_ORDERS_CART_CREATE_ACK")
          (orders-command 3 "INSERT INTO shop_cart (id, product_id, qty) VALUES (1, 1, 2)"
                            "cart-seed"))
      (= stage "cart-seed")
        (do
          (orders-check (= first-byte 0) "NATIVE_SHOP_ORDERS_CART_SEED_ACK")
          (orders-command 3 "CREATE TABLE shop_orders (id INT PRIMARY KEY, product_id INT, qty INT, total INT)"
                            "orders-create"))
      (= stage "orders-create")
        (do
          (orders-check (= first-byte 0) "NATIVE_SHOP_ORDERS_ORDERS_CREATE_ACK")
          (orders-command 22 "INSERT INTO shop_orders (id, product_id, qty, total) VALUES (?, ?, ?, ?)"
                            "insert-prepare"))
      (= stage "insert-prepare")
        (do
          (orders-check (and (= first-byte 0) (>= (buf-len bytes) 12))
                       "NATIVE_SHOP_ORDERS_INSERT_PREPARE_ACK")
          (orders-check (and (= (buf-read-u8 bytes 7) 4)
                            (= (buf-read-u8 bytes 8) 0))
                       "NATIVE_SHOP_ORDERS_INSERT_FOUR_PARAMETERS")
          (reset! orders-statement (orders-read-u32 bytes 1))
          (let [execute (buf-concat [(buf-u8 23) (orders-u32 (deref orders-statement))
                                     (buf-u8 0) (orders-u32 1)
                                     (buf-u8 0) (buf-u8 1)
                                     (buf-u8 3) (buf-u8 0)
                                     (buf-u8 3) (buf-u8 0)
                                     (buf-u8 3) (buf-u8 0)
                                     (buf-u8 3) (buf-u8 0)
                                     (orders-u32 1) (orders-u32 1) (orders-u32 2)
                                     (orders-u32 3000)])]
            (orders-send execute 0 "insert-execute" 1)))
      (= stage "insert-execute")
        (do
          (orders-check (= first-byte 0) "NATIVE_SHOP_ORDERS_INSERT_EXECUTE_ACK")
          (orders-command 22 "SELECT id, product_id, qty, total FROM shop_orders WHERE id=?"
                            "select-prepare"))
      (= stage "select-prepare")
        (do
          (orders-check (and (= first-byte 0) (>= (buf-len bytes) 12))
                       "NATIVE_SHOP_ORDERS_SELECT_PREPARE_ACK")
          (orders-check (and (= (buf-read-u8 bytes 7) 1)
                            (= (buf-read-u8 bytes 8) 0))
                       "NATIVE_SHOP_ORDERS_SELECT_ONE_PARAMETER")
          (reset! orders-statement (orders-read-u32 bytes 1))
          (let [execute (buf-concat [(buf-u8 23) (orders-u32 (deref orders-statement))
                                     (buf-u8 0) (orders-u32 1)
                                     (buf-u8 0) (buf-u8 1)
                                     (buf-u8 3) (buf-u8 0) (orders-u32 1)])]
            (orders-send execute 0 "select" 1)))
      (= stage "select")
        (do
          (orders-check (and (= first-byte 4) (= (buf-len bytes) 1))
                       "NATIVE_SHOP_ORDERS_SELECT_FOUR_COLUMNS")
          (reset! orders-stage "columns"))
      (= stage "columns")
        (do
          (swap! orders-columns conj (orders-column-name bytes))
          (if (= (count (deref orders-columns)) 4)
            (reset! orders-stage "columns-end") nil))
      (= stage "columns-end")
        (do
          (orders-check (and (= first-byte 254) (= (buf-len bytes) 5))
                       "NATIVE_SHOP_ORDERS_COLUMN_EOF")
          (orders-check (and (= (get (deref orders-columns) 0) "id")
                            (= (get (deref orders-columns) 1) "product_id")
                            (= (get (deref orders-columns) 2) "qty")
                            (= (get (deref orders-columns) 3) "total"))
                       "NATIVE_SHOP_ORDERS_ORDER_SCHEMA")
          (reset! orders-stage "row"))
      (= stage "row")
        (do (reset! orders-row (orders-row-map bytes))
            (reset! orders-stage "row-end"))
      (= stage "row-end")
        (do
          (orders-check (and (= first-byte 254) (= (buf-len bytes) 5))
                       "NATIVE_SHOP_ORDERS_EXACTLY_ONE_ROW")
          (orders-check (and (= (count (keys (deref orders-row))) 4)
                            (= (get (deref orders-row) "id") "1")
                            (= (get (deref orders-row) "product_id") "1")
                            (= (get (deref orders-row) "qty") "2")
                            (= (get (deref orders-row) "total") "3000"))
                       "NATIVE_SHOP_ORDERS_EXACT_ORDER_ROW")
          (reset! orders-stage "done")
          (reset! orders-done true))
      :else (throw "NATIVE_SHOP_ORDERS_UNEXPECTED_STAGE"))))

(defn orders-drain []
  (if (>= (buf-len (deref orders-buffer)) 4)
    (let [bytes (deref orders-buffer)
          length (+ (buf-read-u8 bytes 0) (* 256 (buf-read-u8 bytes 1))
                     (* 65536 (buf-read-u8 bytes 2)))]
      (orders-check (<= length 65536) "NATIVE_SHOP_ORDERS_PACKET_LIMIT")
      (if (>= (buf-len bytes) (+ 4 length))
        (do
          (reset! orders-buffer (buf-slice bytes (+ 4 length)
                                         (- (buf-len bytes) (+ 4 length))))
          (orders-frame (buf-slice bytes 4 length) (buf-read-u8 bytes 3))
          (orders-drain))
        nil))
    nil))

(defn native-shop-orders-handler [event connection payload peer]
  (try
    (cond
      (or (= event "connect") (= event "accept"))
        (do (orders-check (nil? (deref orders-connection)) "NATIVE_SHOP_ORDERS_SINGLE_CONNECTION")
            (reset! orders-connection connection))
      (= event "data")
        (do (reset! orders-buffer
              (buf-concat [(deref orders-buffer) (buf-from-binary payload)]))
            (orders-drain))
      (= event "close")
        (orders-check (deref orders-done) "NATIVE_SHOP_ORDERS_PREMATURE_CLOSE")
      :else nil)
    (catch [error]
      (reset! orders-error (error_message error))
      (reset! orders-done true))))

(orders-check (not (nil? orders-control)) "NATIVE_SHOP_ORDERS_HOST_ENV_REQUIRED")
(orders-check (not (file_exists (str orders-control "/ports.ready")))
             "NATIVE_SHOP_ORDERS_CONTROL_NOT_FRESH")
(let [bridge-port (tcp-client-free-port) daemon-port (tcp-client-free-port)]
  (orders-check (and (number? bridge-port) (number? daemon-port)
                    (not (= bridge-port daemon-port))) "NATIVE_SHOP_ORDERS_DISTINCT_PORTS")
  (orders-check (= (tcp-server-raw bridge-port "native-shop-orders-handler" "127.0.0.1") "ok")
               "NATIVE_SHOP_ORDERS_LISTENER_START")
  (try
    (do
      (file_write (str orders-control "/ports.json")
                  (json_str {"bridge" bridge-port "daemon" daemon-port}))
      (file_write (str orders-control "/ports.ready") "ready")
      (let [deadline (+ (now-ms) 30000)]
        (while (and (< (now-ms) deadline) (not (deref orders-done))) (fl-yield 10)))
      (orders-check (deref orders-done) "NATIVE_SHOP_ORDERS_CONTRACT_TIMEOUT")
      (if (nil? (deref orders-error)) nil (throw (deref orders-error)))
      (orders-check (= (deref orders-stage) "done") "NATIVE_SHOP_ORDERS_CONTRACT_INCOMPLETE")
      (orders-check (= (buf-len (deref orders-buffer)) 0) "NATIVE_SHOP_ORDERS_TRAILING_PACKET_BYTES"))
    (finally (tcp-server-stop bridge-port))))
(println (str "NATIVE_SHOP_ORDERS_RESULT "
  (json_str {"ok" true "table" "shop_orders"
             "insert_sql" "INSERT INTO shop_orders (id, product_id, qty, total) VALUES (?, ?, ?, ?)"
             "insert_bind" [1 1 2 3000] "prepared_insert_executions" 1
             "select_sql" "SELECT id, product_id, qty, total FROM shop_orders WHERE id=?"
             "select_bind" [1] "prepared_select_executions" 1
             "rows" 1 "columns" (deref orders-columns) "row" (deref orders-row)
             "exact_select" true})))
(println "afj-db95 Native shop orders prepared INSERT SELECT PASS")
