;; Native shop product lookup fixture agreed in msg_3efe7d1611ec.
;; Fresh shop_products schema/seed and exact four-column prepared SELECT.
;; Reuses case71 Native transport; fixed host supplies owned process lifetimes.
(load "../src/sha1.fls")
(define shop-control (env-get "AFJ_NATIVE_SHOP_PRODUCTS_CONTROL"))
(define shop-connection (atom nil))
(define shop-buffer (atom ""))
(define shop-stage (atom "handshake"))
(define shop-sequence (atom 0))
(define shop-columns (atom []))
(define shop-row (atom nil))
(define shop-error (atom nil))
(define shop-done (atom false))
(define shop-statement (atom nil))

(defn shop-check [condition message]
  (if (= condition true) true (throw message)))

(defn shop-u32 [value]
  (buf-concat [(buf-u8 (rem value 256))
               (buf-u8 (rem (floor (/ value 256)) 256))
               (buf-u8 (rem (floor (/ value 65536)) 256))
               (buf-u8 (rem (floor (/ value 16777216)) 256))]))

(defn shop-read-u32 [bytes offset]
  (+ (buf-read-u8 bytes offset)
     (* 256 (buf-read-u8 bytes (+ offset 1)))
     (* 65536 (buf-read-u8 bytes (+ offset 2)))
     (* 16777216 (buf-read-u8 bytes (+ offset 3)))))

(defn shop-send [payload sequence next-stage response-sequence]
  (let [length (buf-len payload)
        frame (buf-concat [(buf-slice (shop-u32 length) 0 3)
                           (buf-u8 sequence) payload])]
    (reset! shop-stage next-stage)
    (reset! shop-sequence response-sequence)
    (shop-check (= (tcp-write (deref shop-connection) (buf-to-binary frame)) "ok")
                 "NATIVE_SHOP_PRODUCTS_PACKET_WRITE")))

(defn shop-command [code text next-stage]
  (shop-send (buf-concat [(buf-u8 code) (buf-str text)])
              0 next-stage 1))

(defn shop-text [bytes offset]
  (shop-check (< offset (buf-len bytes)) "NATIVE_SHOP_PRODUCTS_TEXT_PREFIX")
  (let [length (buf-read-u8 bytes offset) next (+ offset 1 length)]
    (shop-check (and (< length 251) (<= next (buf-len bytes)))
                 "NATIVE_SHOP_PRODUCTS_TEXT_LENGTH")
    {"value" (buf-read-str bytes (+ offset 1) length)
     "next" next}))

(defn shop-column-name [bytes]
  (loop [index 0 offset 0]
    (let [field (shop-text bytes offset)]
      (if (= index 4) (get field "value")
        (recur (+ index 1) (get field "next"))))))

(defn shop-row-map [bytes]
  (loop [index 0 offset 0 result {}]
    (if (= index 4)
      (do
        (shop-check (= offset (buf-len bytes)) "NATIVE_SHOP_PRODUCTS_ROW_TRAILING_BYTES")
        result)
      (let [field (shop-text bytes offset)]
        (recur (+ index 1) (get field "next")
               (assoc result (get (deref shop-columns) index)
                             (get field "value")))))))

(defn shop-login [bytes]
  (shop-check (= (buf-read-u8 bytes 0) 10) "NATIVE_SHOP_PRODUCTS_HANDSHAKE_VERSION")
  (let [version-end
          (loop [offset 1]
            (do
              (shop-check (< offset (buf-len bytes)) "NATIVE_SHOP_PRODUCTS_HANDSHAKE_LENGTH")
              (if (= (buf-read-u8 bytes offset) 0) offset (recur (+ offset 1)))))
        first-offset (+ version-end 5)
        second-offset (+ first-offset 27)]
    (shop-check (<= (+ second-offset 12) (buf-len bytes))
                 "NATIVE_SHOP_PRODUCTS_SCRAMBLE_LENGTH")
    (let [scramble (buf-concat [(buf-slice bytes first-offset 8)
                                (buf-slice bytes second-offset 12)])
          token (sha1-mysql-native-token "development-only" scramble)
          login (buf-concat [(shop-u32 172545) (shop-u32 1048576)
                             (buf-u8 33) (sha1-zero-bytes 23)
                             (buf-str "root") (buf-u8 0)
                             (buf-u8 20) token])]
      (shop-check (= (buf-len token) 20) "NATIVE_SHOP_PRODUCTS_TOKEN_LENGTH")
      (shop-send login 1 "login" 2))))

(defn shop-frame [bytes sequence]
  (shop-check (> (buf-len bytes) 0) "NATIVE_SHOP_PRODUCTS_EMPTY_PACKET")
  (shop-check (= sequence (deref shop-sequence)) "NATIVE_SHOP_PRODUCTS_PACKET_SEQUENCE")
  (swap! shop-sequence + 1)
  (let [stage (deref shop-stage) first-byte (buf-read-u8 bytes 0)]
    (if (= first-byte 255)
      (if (>= (buf-len bytes) 9)
        (throw (str "NATIVE_SHOP_PRODUCTS_SERVER_ERROR_" stage " code="
                    (+ (buf-read-u8 bytes 1) (* 256 (buf-read-u8 bytes 2)))
                    " message=" (buf-read-str bytes 9 (- (buf-len bytes) 9))))
        (throw (str "NATIVE_SHOP_PRODUCTS_SHORT_SERVER_ERROR_" stage)))
      nil)
    (cond
      (= stage "handshake") (shop-login bytes)
      (= stage "login")
        (do
          (shop-check (= first-byte 0) "NATIVE_SHOP_PRODUCTS_LOGIN_ACK")
          (shop-command 3 "CREATE TABLE shop_products (id INT PRIMARY KEY, sku TEXT, name TEXT, price INT)"
                           "create"))
      (= stage "create")
        (do
          (shop-check (= first-byte 0) "NATIVE_SHOP_PRODUCTS_CREATE_ACK")
          (shop-command 3 "INSERT INTO shop_products (id,sku,name,price) VALUES (1,'SKU-1','Demo Widget',1500)"
                           "seed"))
      (= stage "seed")
        (do
          (shop-check (= first-byte 0) "NATIVE_SHOP_PRODUCTS_SEED_ACK")
          (shop-command 22 "SELECT id, sku, name, price FROM shop_products WHERE id=?"
                            "prepare"))
      (= stage "prepare")
        (do
          (shop-check (and (= first-byte 0) (>= (buf-len bytes) 12))
                       "NATIVE_SHOP_PRODUCTS_PREPARE_ACK")
          (shop-check (and (= (buf-read-u8 bytes 7) 1)
                            (= (buf-read-u8 bytes 8) 0))
                       "NATIVE_SHOP_PRODUCTS_PREPARE_ONE_PARAMETER")
          (reset! shop-statement (shop-read-u32 bytes 1))
          (let [execute (buf-concat [(buf-u8 23) (shop-u32 (deref shop-statement))
                                     (buf-u8 0) (shop-u32 1)
                                     (buf-u8 0) (buf-u8 1)
                                     (buf-u8 3) (buf-u8 0) (shop-u32 1)])]
            (shop-send execute 0 "select" 1)))
      (= stage "select")
        (do
          (shop-check (and (= first-byte 4) (= (buf-len bytes) 1))
                       "NATIVE_SHOP_PRODUCTS_SELECT_FOUR_COLUMNS")
          (reset! shop-stage "columns"))
      (= stage "columns")
        (do
          (swap! shop-columns conj (shop-column-name bytes))
          (if (= (count (deref shop-columns)) 4)
            (reset! shop-stage "columns-end") nil))
      (= stage "columns-end")
        (do
          (shop-check (and (= first-byte 254) (= (buf-len bytes) 5))
                       "NATIVE_SHOP_PRODUCTS_COLUMN_EOF")
          (shop-check (and (= (get (deref shop-columns) 0) "id")
                            (= (get (deref shop-columns) 1) "sku")
                            (= (get (deref shop-columns) 2) "name")
                            (= (get (deref shop-columns) 3) "price"))
                       "NATIVE_SHOP_PRODUCTS_PRODUCT_SCHEMA")
          (reset! shop-stage "row"))
      (= stage "row")
        (do (reset! shop-row (shop-row-map bytes))
            (reset! shop-stage "row-end"))
      (= stage "row-end")
        (do
          (shop-check (and (= first-byte 254) (= (buf-len bytes) 5))
                       "NATIVE_SHOP_PRODUCTS_EXACTLY_ONE_ROW")
          (shop-check (and (= (count (keys (deref shop-row))) 4)
                            (= (get (deref shop-row) "id") "1")
                            (= (get (deref shop-row) "sku") "SKU-1")
                            (= (get (deref shop-row) "name") "Demo Widget")
                            (= (get (deref shop-row) "price") "1500"))
                       "NATIVE_SHOP_PRODUCTS_EXACT_PRODUCT_ROW")
          (reset! shop-stage "done")
          (reset! shop-done true))
      :else (throw "NATIVE_SHOP_PRODUCTS_UNEXPECTED_STAGE"))))

(defn shop-drain []
  (if (>= (buf-len (deref shop-buffer)) 4)
    (let [bytes (deref shop-buffer)
          length (+ (buf-read-u8 bytes 0) (* 256 (buf-read-u8 bytes 1))
                     (* 65536 (buf-read-u8 bytes 2)))]
      (shop-check (<= length 65536) "NATIVE_SHOP_PRODUCTS_PACKET_LIMIT")
      (if (>= (buf-len bytes) (+ 4 length))
        (do
          (reset! shop-buffer (buf-slice bytes (+ 4 length)
                                         (- (buf-len bytes) (+ 4 length))))
          (shop-frame (buf-slice bytes 4 length) (buf-read-u8 bytes 3))
          (shop-drain))
        nil))
    nil))

(defn native-shop-products-handler [event connection payload peer]
  (try
    (cond
      (or (= event "connect") (= event "accept"))
        (do (shop-check (nil? (deref shop-connection)) "NATIVE_SHOP_PRODUCTS_SINGLE_CONNECTION")
            (reset! shop-connection connection))
      (= event "data")
        (do (reset! shop-buffer
              (buf-concat [(deref shop-buffer) (buf-from-binary payload)]))
            (shop-drain))
      (= event "close")
        (shop-check (deref shop-done) "NATIVE_SHOP_PRODUCTS_PREMATURE_CLOSE")
      :else nil)
    (catch [error]
      (reset! shop-error (error_message error))
      (reset! shop-done true))))

(shop-check (not (nil? shop-control)) "NATIVE_SHOP_PRODUCTS_HOST_ENV_REQUIRED")
(shop-check (not (file_exists (str shop-control "/ports.ready")))
             "NATIVE_SHOP_PRODUCTS_CONTROL_NOT_FRESH")
(let [bridge-port (tcp-client-free-port) daemon-port (tcp-client-free-port)]
  (shop-check (and (number? bridge-port) (number? daemon-port)
                    (not (= bridge-port daemon-port))) "NATIVE_SHOP_PRODUCTS_DISTINCT_PORTS")
  (shop-check (= (tcp-server-raw bridge-port "native-shop-products-handler" "127.0.0.1") "ok")
               "NATIVE_SHOP_PRODUCTS_LISTENER_START")
  (try
    (do
      (file_write (str shop-control "/ports.json")
                  (json_str {"bridge" bridge-port "daemon" daemon-port}))
      (file_write (str shop-control "/ports.ready") "ready")
      (let [deadline (+ (now-ms) 30000)]
        (while (and (< (now-ms) deadline) (not (deref shop-done))) (fl-yield 10)))
      (shop-check (deref shop-done) "NATIVE_SHOP_PRODUCTS_CONTRACT_TIMEOUT")
      (if (nil? (deref shop-error)) nil (throw (deref shop-error)))
      (shop-check (= (deref shop-stage) "done") "NATIVE_SHOP_PRODUCTS_CONTRACT_INCOMPLETE")
      (shop-check (= (buf-len (deref shop-buffer)) 0) "NATIVE_SHOP_PRODUCTS_TRAILING_PACKET_BYTES"))
    (finally (tcp-server-stop bridge-port))))
(println (str "NATIVE_SHOP_PRODUCTS_RESULT "
  (json_str {"ok" true "table" "shop_products" "prepared_parameters" 1
             "query" "SELECT id, sku, name, price FROM shop_products WHERE id=?"
             "bind" [1] "select_executions" 1 "rows" 1
             "columns" (deref shop-columns) "row" (deref shop-row)
             "exact_select" true})))
(println "afj-db95 Native shop products prepared SELECT PASS")
