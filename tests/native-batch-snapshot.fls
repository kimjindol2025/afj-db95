;; Frozen transaction semantics: roots are values, failed batches publish nothing.
(load "../src/native-store.fl")
(define passed (atom 0))
(defn check [id ok] (if ok (do (swap! passed (fn [n] (+ n 1))) (println (str "DB_B06_SNAPSHOT_" id "=PASS"))) (throw (str "DB_B06_SNAPSHOT_" id "=FAIL"))))
(defn select-rows [table column value] (get (execute-ast {"type" "select" "table" table "where" {"column" column "equals" value}}) "rows"))
(defn rejected? [asts] (try (do (afj-tcp-commit-asts asts) false) (catch [error] true)))
(defn wal-hash [] (get (file-sha256-result (env-get "AFJ_DB_WAL")) "data"))
(define post-schema {"columns" [{"name" "id" "type" "INTEGER" "nullable" false "primary" true} {"name" "tenant" "type" "INTEGER" "nullable" false} {"name" "slug" "type" "TEXT" "nullable" false} {"name" "value" "type" "TEXT" "nullable" false}] "primary-key" "id" "unique-columns" [] "unique-groups" [["tenant" "slug"]]})
(define meta-schema {"columns" [{"name" "id" "type" "INTEGER" "nullable" false "primary" true} {"name" "value" "type" "TEXT" "nullable" false}] "primary-key" "id" "unique-columns" [] "unique-groups" []})
(check "01_CREATE" (get (afj-tcp-commit-asts [{"type" "create-table" "table" "b06_posts" "schema" post-schema} {"type" "create-table" "table" "b06_meta" "schema" meta-schema}]) "ok"))
(check "02_SEED" (get (afj-tcp-commit-asts [{"type" "insert" "table" "b06_posts" "row" {"id" 1 "tenant" 1 "slug" "shared" "value" "first"}} {"type" "insert" "table" "b06_posts" "row" {"id" 2 "tenant" 2 "slug" "shared" "value" "second"}} {"type" "insert" "table" "b06_meta" "row" {"id" 1 "value" "old"}}]) "ok"))
(define held-catalog (deref engine-catalog))
(define held-indexes (deref engine-indexes))
(define held-databases (deref engine-databases))
(define held-catalog-json (json_str held-catalog))
(define held-indexes-json (json_str held-indexes))
(define held-databases-json (json_str held-databases))
(check "03_COMMIT" (get (afj-tcp-commit-asts [{"type" "insert" "table" "b06_posts" "row" {"id" 3 "tenant" 1 "slug" "third" "value" "한글😀"}} {"type" "update" "table" "b06_meta" "where" {"column" "id" "equals" 1} "changes" {"value" "changed"}}]) "ok"))
(check "04_CATALOG_ALIAS" (= held-catalog-json (json_str held-catalog)))
(check "05_INDEX_ALIAS" (= held-indexes-json (json_str held-indexes)))
(check "06_DATABASE_ALIAS" (= held-databases-json (json_str held-databases)))
(check "07_COMPOSITE_INDEX" (= (get (first (get (execute-ast {"type" "select" "table" "b06_posts" "where" {"and" [{"column" "tenant" "equals" 1} {"column" "slug" "equals" "third"}]}}) "rows")) "value") "한글😀"))
(define before-catalog (json_str (deref engine-catalog)))
(define before-indexes (json_str (deref engine-indexes)))
(define before-databases (json_str (deref engine-databases)))
(define before-wal (wal-hash))
(check "08_REJECT_DUPLICATE" (rejected? [{"type" "update" "table" "b06_meta" "where" {"column" "id" "equals" 1} "changes" {"value" "uncommitted"}} {"type" "insert" "table" "b06_posts" "row" {"id" 4 "tenant" 1 "slug" "third" "value" "duplicate"}}]))
(check "09_CATALOG_RESTORED" (= before-catalog (json_str (deref engine-catalog))))
(check "10_INDEXES_RESTORED" (= before-indexes (json_str (deref engine-indexes))))
(check "11_DATABASES_RESTORED" (= before-databases (json_str (deref engine-databases))))
(check "12_REJECT_WAL_UNCHANGED" (= before-wal (wal-hash)))
(check "13_REJECT_DATA_UNCHANGED" (and (= (get (first (select-rows "b06_meta" "id" 1)) "value") "changed") (= (count (select-rows "b06_posts" "id" 4)) 0)))
(check "14_REJECT_DDL_BATCH" (rejected? [{"type" "create-table" "table" "b06_temporary" "schema" meta-schema} {"type" "insert" "table" "b06_posts" "row" {"id" 1 "tenant" 9 "slug" "duplicate-id" "value" "rejected"}}]))
(check "15_DDL_RESTORED" (and (= before-catalog (json_str (deref engine-catalog))) (= before-indexes (json_str (deref engine-indexes))) (= before-databases (json_str (deref engine-databases))) (nil? (get (deref engine-catalog) "b06_temporary"))))
(check "16_DDL_WAL_UNCHANGED" (= before-wal (wal-hash)))
(check "17_REJECT_AFTER_DELETE" (rejected? [{"type" "delete" "table" "b06_posts" "where" {"column" "id" "equals" 3}} {"type" "insert" "table" "b06_posts" "row" {"id" 1 "tenant" 9 "slug" "rejected-after-delete" "value" "rejected"}}]))
(check "18_DELETED_ROW_AND_INDEX_RESTORED" (and (= before-catalog (json_str (deref engine-catalog))) (= before-indexes (json_str (deref engine-indexes))) (= (get (first (select-rows "b06_posts" "id" 3)) "value") "한글😀") (= before-wal (wal-hash))))
(check "19_OLD_VALUES_STILL_UNCHANGED" (and (= held-catalog-json (json_str held-catalog)) (= held-indexes-json (json_str held-indexes)) (= held-databases-json (json_str held-databases)) (not (deref afj-native-recovery-required))))
(check "20_COMMIT_AFTER_REJECTION" (and (get (afj-tcp-commit-asts [{"type" "insert" "table" "b06_posts" "row" {"id" 5 "tenant" 2 "slug" "new" "value" "final"}} {"type" "update" "table" "b06_meta" "where" {"column" "id" "equals" 1} "changes" {"value" "final"}}]) "ok") (= (get (first (select-rows "b06_posts" "id" 5)) "value") "final") (not (= before-wal (wal-hash)))))
(println (str "DB_B06_SNAPSHOT_PASS=" (deref passed) " FAIL=0"))
