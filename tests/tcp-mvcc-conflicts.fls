;; AFJ-014 phantom and write-skew/lost-update regression.
(load "../src/tcp-server.fls")

(server-start "tcp-mvcc-conflicts-test")
(reset! engine-catalog {})
(reset! engine-indexes {})
(reset! afj-tcp-commit-revision 0)
(reset! afj-tcp-sessions {"mvcc-a" "root" "mvcc-b" "root"})
(reset! afj-tcp-session-expiries {})
(reset! afj-tcp-transactions {})
(reset! afj-tcp-locks {})
(reset! afj-tcp-wait-for {})
(reset! afj-tcp-wait-starts {})

(doseq [table ["phantom_users" "quota_a" "quota_b"]]
  (execute-ast {"type" "create-table" "table" table
                "schema" {"columns" [{"name" "id" "type" "INTEGER"
                                         "nullable" false "primary" true}]
                           "primary-key" "id" "unique-columns" []}}))

(afj-tcp-commit-ast
  {"type" "create-table" "table" "schema_guard"
   "schema" {"columns" [{"name" "id" "type" "INTEGER"
                            "nullable" false "primary" true}]
              "primary-key" "id" "unique-columns" []}})
(afj-tcp-commit-ast
  {"type" "insert" "table" "schema_guard" "rows" [{"id" "1"}]})

(afj-tcp-commit-ast
  {"type" "create-table" "table" "versioned_accounts"
   "schema" {"columns" [{"name" "id" "type" "INTEGER"
                            "nullable" false "primary" true}
                           {"name" "balance" "type" "INTEGER"
                            "nullable" false}]
              "primary-key" "id" "unique-columns" []}})
(afj-tcp-commit-ast
  {"type" "insert" "table" "versioned_accounts"
   "rows" [{"id" "1" "balance" "10"}]})
(swap! afj-tcp-sessions assoc "mvcc-version-reader" "root")
(swap! afj-tcp-sessions assoc "mvcc-version-writer" "root")
(let [reader (afj-tcp-begin-level "mvcc-version-reader" "REPEATABLE READ")
      writer (afj-tcp-begin-level "mvcc-version-writer" "REPEATABLE READ")
      before (get (get (deref afj-tcp-transactions) "mvcc-version-reader")
                  "snapshot")]
  (afj-tcp-query {"token" "mvcc-version-writer"
                  "statement" "UPDATE versioned_accounts SET balance=20 WHERE id=1"})
  (afj-tcp-commit "mvcc-version-writer")
  (let [after (afj-tcp-versioned-rows "versioned_accounts" []
                                      (deref afj-tcp-commit-revision))
        before-rows (get (get before "versioned_accounts") "rows")
        chain (get (get (deref afj-tcp-row-versions) "versioned_accounts") "1")]
    (if (and (= (get (first before-rows) "balance") "10")
             (= (get (first after) "balance") "20")
             (>= (count chain) 2))
      nil
      (throw "TCP row-version chain integration failed")))
  (println "afj-db95 TCP row-version chain PASS")
  (afj-tcp-rollback "mvcc-version-reader"))

;; REPEATABLE READ keeps the original predicate view: a concurrent committed
;; insert must not appear as a phantom in the existing transaction.
(afj-tcp-begin-level "mvcc-a" "REPEATABLE READ")
(let [first-read (afj-tcp-query
                   {"token" "mvcc-a"
                    "statement" "SELECT * FROM phantom_users WHERE id=1"})
      outside-write (afj-tcp-query
                      {"token" "mvcc-b"
                       "statement" "INSERT INTO phantom_users (id) VALUES (1)"})
      second-read (afj-tcp-query
                    {"token" "mvcc-a"
                    "statement" "SELECT * FROM phantom_users WHERE id=1"})]
  (if (and (= (count (get (get first-read "result") "rows")) 0)
           (get outside-write "ok")
           (= (count (get (get second-read "result") "rows")) 0))
    nil
    (throw "repeatable-read phantom became visible")))
(afj-tcp-rollback "mvcc-a")

;; SERIALIZABLE predicate reads hold the table lock and reject a concurrent
;; insert before it can create a phantom.
(afj-tcp-begin-level "mvcc-a" "SERIALIZABLE")
(let [serial-read (afj-tcp-query
                    {"token" "mvcc-a"
                     "statement" "SELECT * FROM phantom_users"})
      blocked-write (afj-tcp-query
                      {"token" "mvcc-b"
                       "statement" "INSERT INTO phantom_users (id) VALUES (2)"})]
  (if (and (get serial-read "ok")
           (not (get blocked-write "ok"))
           (= (get blocked-write "error") "TX_CONFLICT"))
    nil
    (throw "serializable predicate read did not block phantom writer")))
(afj-tcp-rollback "mvcc-a")

;; Two transactions can write different tables without a table-lock conflict.
;; Commit validation must still reject the stale second snapshot, preventing
;; write skew and a whole-catalog lost update.
(afj-tcp-begin-level "mvcc-a" "REPEATABLE READ")
(afj-tcp-begin-level "mvcc-b" "REPEATABLE READ")
(afj-tcp-query
  {"token" "mvcc-a"
   "statement" "INSERT INTO quota_a (id) VALUES (1)"})
(afj-tcp-query
  {"token" "mvcc-b"
   "statement" "INSERT INTO quota_b (id) VALUES (1)"})
(let [first-commit (afj-tcp-commit "mvcc-a")
      stale-commit (afj-tcp-commit "mvcc-b")
      quota-a (afj-tcp-query
                {"token" "mvcc-a"
                 "statement" "SELECT * FROM quota_a"})
      quota-b (afj-tcp-query
                {"token" "mvcc-a"
                 "statement" "SELECT * FROM quota_b"})]
  (if (and (get first-commit "ok")
           (not (get stale-commit "ok"))
           (= (get stale-commit "error") "TX_CONFLICT")
           (= (count (get (get quota-a "result") "rows")) 1)
           (= (count (get (get quota-b "result") "rows")) 0))
    (println "afj-db95 MVCC phantom/write-skew PASS")
    (throw "MVCC conflict validation failed")))

;; A predicate read depends on the table definition as well as its rows.
;; Schema changes have no row-version record, so the reader must not commit
;; writes based on a stale schema snapshot.
(swap! afj-tcp-sessions assoc "mvcc-schema-reader" "root")
(swap! afj-tcp-sessions assoc "mvcc-schema-writer" "root")
(afj-tcp-begin-level "mvcc-schema-reader" "REPEATABLE READ")
(afj-tcp-begin-level "mvcc-schema-writer" "REPEATABLE READ")
(let [read-before (afj-tcp-query
                    {"token" "mvcc-schema-reader"
                     "statement" "SELECT * FROM schema_guard WHERE id=1"})
      drop (afj-tcp-query
              {"token" "mvcc-schema-writer"
               "statement" "DROP TABLE schema_guard"})
      writer-commit (afj-tcp-commit "mvcc-schema-writer")
      reader-write (afj-tcp-query
                     {"token" "mvcc-schema-reader"
                      "statement" "INSERT INTO quota_a (id) VALUES (2)"})
      reader-commit (afj-tcp-commit "mvcc-schema-reader")]
  (if (and (get read-before "ok") (get drop "ok")
           (get writer-commit "ok") (get reader-write "ok")
           (not (get reader-commit "ok"))
           (= (get reader-commit "error") "TX_CONFLICT"))
    (println "afj-db95 MVCC schema-read conflict PASS")
    (throw "schema change did not invalidate stale predicate reader")))

;; ALTER TABLE changes the schema without a row-version. A transaction whose
;; predicate read used the old definition must still fail commit validation.
(afj-tcp-commit-ast
  {"type" "create-table" "table" "schema_alter_guard"
   "schema" {"columns" [{"name" "id" "type" "INTEGER"
                            "nullable" false "primary" true}]
              "primary-key" "id" "unique-columns" []}})
(afj-tcp-commit-ast
  {"type" "insert" "table" "schema_alter_guard" "rows" [{"id" "1"}]})
(swap! afj-tcp-sessions assoc "mvcc-alter-reader" "root")
(swap! afj-tcp-sessions assoc "mvcc-alter-writer" "root")
(afj-tcp-begin-level "mvcc-alter-reader" "REPEATABLE READ")
(afj-tcp-begin-level "mvcc-alter-writer" "REPEATABLE READ")
(let [read-before (afj-tcp-query
                    {"token" "mvcc-alter-reader"
                     "statement" "SELECT * FROM schema_alter_guard WHERE id=1"})
      alter (afj-tcp-query
              {"token" "mvcc-alter-writer"
               "statement" "ALTER TABLE schema_alter_guard ADD COLUMN note TEXT"})
      writer-commit (afj-tcp-commit "mvcc-alter-writer")
      reader-write (afj-tcp-query
                     {"token" "mvcc-alter-reader"
                      "statement" "INSERT INTO quota_a (id) VALUES (3)"})
      reader-commit (afj-tcp-commit "mvcc-alter-reader")]
  (if (and (get read-before "ok") (get alter "ok")
           (get writer-commit "ok") (get reader-write "ok")
           (not (get reader-commit "ok"))
           (= (get reader-commit "error") "TX_CONFLICT"))
    (println "afj-db95 MVCC ALTER schema conflict PASS")
    (throw "ALTER TABLE did not invalidate stale predicate reader")))

;; `id` is not inherently unique in SQL. MVCC history must preserve repeated
;; identifiers and physically duplicate rows when no PRIMARY KEY is declared.
(afj-tcp-commit-ast
  {"type" "create-table" "table" "versioned_unkeyed"
   "schema" {"columns" [{"name" "id" "type" "INTEGER" "nullable" true}
                           {"name" "note" "type" "TEXT" "nullable" true}]
              "primary-key" nil "unique-columns" []}})
(afj-tcp-commit-ast
  {"type" "insert" "table" "versioned_unkeyed"
   "rows" [{"id" "1" "note" "first"}
           {"id" "1" "note" "second"}
           {"id" "1" "note" "second"}]})
(let [snapshot (deref afj-tcp-commit-revision)
      before (afj-tcp-versioned-rows "versioned_unkeyed" [] snapshot)]
  (afj-tcp-commit-ast
    {"type" "update" "table" "versioned_unkeyed"
     "where" {"column" "note" "equals" "first"}
     "changes" {"note" "updated"}})
  (let [after (afj-tcp-versioned-rows
                "versioned_unkeyed" [] (deref afj-tcp-commit-revision))
        historical (afj-tcp-versioned-rows "versioned_unkeyed" [] snapshot)]
    (if (and (= (count before) 3)
             (= (count after) 3)
             (= (count historical) 3)
             (any? (fn [row] (= (get row "note") "first")) historical)
             (any? (fn [row] (= (get row "note") "updated")) after))
      (println "afj-db95 MVCC duplicate unkeyed rows PASS")
      (throw "MVCC collapsed rows without a declared unique key"))))

;; Recreating a table with an identical schema must not hide an intervening
;; DDL generation change from a repeatable-read predicate reader.
(afj-tcp-commit-asts
  [{"type" "create-table" "table" "schema_generation_guard"
    "schema" {"columns" [{"name" "id" "type" "INTEGER"
                             "nullable" false "primary" true}]
               "primary-key" "id" "unique-columns" []}}
   {"type" "insert" "table" "schema_generation_guard"
    "rows" [{"id" "1"}]}])
(swap! afj-tcp-sessions assoc "mvcc-generation-reader" "root")
(swap! afj-tcp-sessions assoc "mvcc-generation-writer" "root")
(afj-tcp-begin-level "mvcc-generation-reader" "REPEATABLE READ")
(let [read-before (afj-tcp-query
                    {"token" "mvcc-generation-reader"
                     "statement" "SELECT * FROM schema_generation_guard WHERE id=1"})
      dropped (afj-tcp-query
                {"token" "mvcc-generation-writer"
                 "statement" "DROP TABLE schema_generation_guard"})
      recreated (afj-tcp-query
                  {"token" "mvcc-generation-writer"
                   "statement" "CREATE TABLE schema_generation_guard (id INTEGER PRIMARY KEY)"})
      inserted (afj-tcp-query
                 {"token" "mvcc-generation-writer"
                  "statement" "INSERT INTO schema_generation_guard (id) VALUES (1)"})
      reader-write (afj-tcp-query
                     {"token" "mvcc-generation-reader"
                      "statement" "INSERT INTO quota_a (id) VALUES (4)"})
      reader-commit (afj-tcp-commit "mvcc-generation-reader")]
  (if (and (get read-before "ok") (get dropped "ok")
           (get recreated "ok") (get inserted "ok")
           (get reader-write "ok") (not (get reader-commit "ok"))
           (= (get reader-commit "error") "TX_CONFLICT"))
    (println "afj-db95 MVCC recreated schema generation conflict PASS")
    (throw "drop/recreate hid a schema generation change from stale reader")))
