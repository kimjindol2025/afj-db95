;; Native product name LIKE COUNT fixture agreed in msg_e8e07f56a55f.
;; Both products use the original visible1 seeds; server COUNT bind %Widget% must return one text1 row.
(load "../src/sha1.fls")
(define likecount-control (env-get "AFJ_NATIVE_SHOP_PRODUCTS_NAME_LIKE_COUNT_CONTROL"))
(define likecount-connection (atom nil))
(define likecount-buffer (atom ""))
(define likecount-stage (atom "handshake"))
(define likecount-sequence (atom 0))
(define likecount-columns (atom []))
(define likecount-rows (atom []))
(define likecount-error (atom nil))
(define likecount-done (atom false))
(define likecount-statement (atom nil))

(defn likecount-check [condition message]
  (if (= condition true) true (throw message)))

(defn likecount-u32 [value]
  (buf-concat [(buf-u8 (rem value 256))
               (buf-u8 (rem (floor (/ value 256)) 256))
               (buf-u8 (rem (floor (/ value 65536)) 256))
               (buf-u8 (rem (floor (/ value 16777216)) 256))]))

(defn likecount-read-u32 [bytes offset]
  (+ (buf-read-u8 bytes offset)
     (* 256 (buf-read-u8 bytes (+ offset 1)))
     (* 65536 (buf-read-u8 bytes (+ offset 2)))
     (* 16777216 (buf-read-u8 bytes (+ offset 3)))))

(defn likecount-send [payload sequence next-stage response-sequence]
  (let [length (buf-len payload)
        frame (buf-concat [(buf-slice (likecount-u32 length) 0 3)
                           (buf-u8 sequence) payload])]
    (reset! likecount-stage next-stage)
    (reset! likecount-sequence response-sequence)
    (likecount-check (= (tcp-write (deref likecount-connection) (buf-to-binary frame)) "ok")
                 "NATIVE_SHOP_PRODUCTS_NAME_LIKE_COUNT_PACKET_WRITE")))

(defn likecount-command [code text next-stage]
  (likecount-send (buf-concat [(buf-u8 code) (buf-str text)])
              0 next-stage 1))

(defn likecount-text [bytes offset]
  (likecount-check (< offset (buf-len bytes)) "NATIVE_SHOP_PRODUCTS_NAME_LIKE_COUNT_TEXT_PREFIX")
  (let [length (buf-read-u8 bytes offset) next (+ offset 1 length)]
    (likecount-check (and (< length 251) (<= next (buf-len bytes)))
                 "NATIVE_SHOP_PRODUCTS_NAME_LIKE_COUNT_TEXT_LENGTH")
    {"value" (buf-read-str bytes (+ offset 1) length)
     "next" next}))

(defn likecount-column-name [bytes]
  (loop [index 0 offset 0]
    (let [field (likecount-text bytes offset)]
      (if (= index 4) (get field "value")
        (recur (+ index 1) (get field "next"))))))

(defn likecount-login [bytes]
  (likecount-check (= (buf-read-u8 bytes 0) 10) "NATIVE_SHOP_PRODUCTS_NAME_LIKE_COUNT_HANDSHAKE_VERSION")
  (let [version-end
          (loop [offset 1]
            (do
              (likecount-check (< offset (buf-len bytes)) "NATIVE_SHOP_PRODUCTS_NAME_LIKE_COUNT_HANDSHAKE_LENGTH")
              (if (= (buf-read-u8 bytes offset) 0) offset (recur (+ offset 1)))))
        first-offset (+ version-end 5)
        second-offset (+ first-offset 27)]
    (likecount-check (<= (+ second-offset 12) (buf-len bytes))
                 "NATIVE_SHOP_PRODUCTS_NAME_LIKE_COUNT_SCRAMBLE_LENGTH")
    (let [scramble (buf-concat [(buf-slice bytes first-offset 8)
                                (buf-slice bytes second-offset 12)])
          token (sha1-mysql-native-token "development-only" scramble)
          login (buf-concat [(likecount-u32 172545) (likecount-u32 1048576)
                             (buf-u8 33) (sha1-zero-bytes 23)
                             (buf-str "root") (buf-u8 0)
                             (buf-u8 20) token])]
      (likecount-check (= (buf-len token) 20) "NATIVE_SHOP_PRODUCTS_NAME_LIKE_COUNT_TOKEN_LENGTH")
      (likecount-send login 1 "login" 2))))

(defn likecount-frame [bytes sequence]
  (likecount-check (> (buf-len bytes) 0) "NATIVE_SHOP_PRODUCTS_NAME_LIKE_COUNT_EMPTY_PACKET")
  (likecount-check (= sequence (deref likecount-sequence)) "NATIVE_SHOP_PRODUCTS_NAME_LIKE_COUNT_PACKET_SEQUENCE")
  (swap! likecount-sequence + 1)
  (let [stage (deref likecount-stage) first-byte (buf-read-u8 bytes 0)]
    (if (= first-byte 255)
      (if (>= (buf-len bytes) 9)
        (throw (str "NATIVE_SHOP_PRODUCTS_NAME_LIKE_COUNT_SERVER_ERROR_" stage " code="
                    (+ (buf-read-u8 bytes 1) (* 256 (buf-read-u8 bytes 2)))
                    " message=" (buf-read-str bytes 9 (- (buf-len bytes) 9))))
        (throw (str "NATIVE_SHOP_PRODUCTS_NAME_LIKE_COUNT_SHORT_SERVER_ERROR_" stage)))
      nil)
    (cond
      (= stage "handshake") (likecount-login bytes)
      (= stage "login")
        (do
          (likecount-check (= first-byte 0) "NATIVE_SHOP_PRODUCTS_NAME_LIKE_COUNT_LOGIN_ACK")
          (likecount-command 3 "CREATE TABLE shop_products (id INT PRIMARY KEY, sku TEXT, name TEXT, price INT, visible INT)"
                           "create"))
      (= stage "create")
        (do
          (likecount-check (= first-byte 0) "NATIVE_SHOP_PRODUCTS_NAME_LIKE_COUNT_CREATE_ACK")
          (likecount-command 3 "INSERT INTO shop_products (id, sku, name, price, visible) VALUES (1, 'SKU-1', 'Demo Widget', 1500, 1)"
                           "seed"))
      (= stage "seed")
        (do
          (likecount-check (= first-byte 0) "NATIVE_SHOP_PRODUCTS_NAME_LIKE_COUNT_FIRST_SEED_ACK")
          (likecount-command 3 "INSERT INTO shop_products (id, sku, name, price, visible) VALUES (2, 'SKU-2', 'Demo Gadget', 2200, 1)"
                            "second-seed"))
      (= stage "second-seed")
        (do
          (likecount-check (= first-byte 0) "NATIVE_SHOP_PRODUCTS_NAME_LIKE_COUNT_SECOND_PRODUCT_SEED_ACK")
          (likecount-command 3 "CREATE TABLE shop_cart (id INT PRIMARY KEY, user_id INT, product_id INT, qty INT)" "cart-create"))
      (= stage "cart-create")
        (do
          (likecount-check (= first-byte 0) "NATIVE_SHOP_PRODUCTS_NAME_LIKE_COUNT_CART_CREATE_ACK")
          (likecount-command 3 "INSERT INTO shop_cart (id, user_id, product_id, qty) VALUES (2, 20, 2, 1)" "second-cart-seed"))
      (= stage "second-cart-seed")
        (do
          (likecount-check (= first-byte 0) "NATIVE_SHOP_PRODUCTS_NAME_LIKE_COUNT_SINGLE_CART_SEED_ACK")
          (likecount-command 22 "SELECT COUNT(*) FROM shop_products WHERE name LIKE ?" "prepare"))
      (= stage "prepare")
        (do
          (likecount-check (and (= first-byte 0) (>= (buf-len bytes) 12))
                       "NATIVE_SHOP_PRODUCTS_NAME_LIKE_COUNT_PREPARE_ACK")
          (likecount-check (and (= (buf-read-u8 bytes 7) 1)
                            (= (buf-read-u8 bytes 8) 0))
                       "NATIVE_SHOP_PRODUCTS_NAME_LIKE_COUNT_PREPARE_ONE_PARAMETER")
          (reset! likecount-statement (likecount-read-u32 bytes 1))
          (let [execute (buf-concat [(buf-u8 23) (likecount-u32 (deref likecount-statement))
                                     (buf-u8 0) (likecount-u32 1)
                                     (buf-u8 0) (buf-u8 1) (buf-u8 253) (buf-u8 0)
                                     (buf-u8 8) (buf-str "%Widget%")])]
            (likecount-send execute 0 "select" 1)))
      (= stage "select")
        (do
          (likecount-check (and (= first-byte 1) (= (buf-len bytes) 1))
                       "NATIVE_SHOP_PRODUCTS_NAME_LIKE_COUNT_SELECT_ONE_COLUMN")
          (reset! likecount-stage "columns"))
      (= stage "columns")
        (do
          (swap! likecount-columns conj (likecount-column-name bytes))
          (if (= (count (deref likecount-columns)) 1)
            (reset! likecount-stage "columns-end") nil))
      (= stage "columns-end")
        (do
          (likecount-check (and (= first-byte 254) (= (buf-len bytes) 5))
                       "NATIVE_SHOP_PRODUCTS_NAME_LIKE_COUNT_COLUMN_EOF")
          (likecount-check (> (count (get (deref likecount-columns) 0)) 0)
                         "NATIVE_SHOP_PRODUCTS_NAME_LIKE_COUNT_EXPRESSION_COLUMN")
          (reset! likecount-stage "rows"))
      (= stage "rows")
        (if (and (= first-byte 254) (= (buf-len bytes) 5))
          (do
            (likecount-check (= (count (deref likecount-rows)) 1)
                           "NATIVE_SHOP_PRODUCTS_NAME_LIKE_COUNT_EXACTLY_ONE_ROW")
            (likecount-check (= (get (deref likecount-rows) 0) "1")
                           "NATIVE_SHOP_PRODUCTS_NAME_LIKE_COUNT_EXACT_SERVER_TOTAL")
            (reset! likecount-stage "done")
            (reset! likecount-done true))
          (do
            (likecount-check (< (count (deref likecount-rows)) 1)
                           "NATIVE_SHOP_PRODUCTS_NAME_LIKE_COUNT_EXTRA_ROW")
            (let [field (likecount-text bytes 0)]
              (likecount-check (= (get field "next") (buf-len bytes))
                             "NATIVE_SHOP_PRODUCTS_NAME_LIKE_COUNT_ROW_TRAILING_BYTES")
              (swap! likecount-rows conj (get field "value")))))
      :else (throw "NATIVE_SHOP_PRODUCTS_NAME_LIKE_COUNT_UNEXPECTED_STAGE"))))

(defn likecount-drain []
  (if (>= (buf-len (deref likecount-buffer)) 4)
    (let [bytes (deref likecount-buffer)
          length (+ (buf-read-u8 bytes 0) (* 256 (buf-read-u8 bytes 1))
                     (* 65536 (buf-read-u8 bytes 2)))]
      (likecount-check (<= length 65536) "NATIVE_SHOP_PRODUCTS_NAME_LIKE_COUNT_PACKET_LIMIT")
      (if (>= (buf-len bytes) (+ 4 length))
        (do
          (reset! likecount-buffer (buf-slice bytes (+ 4 length)
                                         (- (buf-len bytes) (+ 4 length))))
          (likecount-frame (buf-slice bytes 4 length) (buf-read-u8 bytes 3))
          (likecount-drain))
        nil))
    nil))

(defn native-shop-products-name-like-count-handler [event connection payload peer]
  (try
    (cond
      (or (= event "connect") (= event "accept"))
        (do (likecount-check (nil? (deref likecount-connection)) "NATIVE_SHOP_PRODUCTS_NAME_LIKE_COUNT_SINGLE_CONNECTION")
            (reset! likecount-connection connection))
      (= event "data")
        (do (reset! likecount-buffer
              (buf-concat [(deref likecount-buffer) (buf-from-binary payload)]))
            (likecount-drain))
      (= event "close")
        (likecount-check (deref likecount-done) "NATIVE_SHOP_PRODUCTS_NAME_LIKE_COUNT_PREMATURE_CLOSE")
      :else nil)
    (catch [error]
      (reset! likecount-error (error_message error))
      (reset! likecount-done true))))

(likecount-check (not (nil? likecount-control)) "NATIVE_SHOP_PRODUCTS_NAME_LIKE_COUNT_HOST_ENV_REQUIRED")
(likecount-check (not (file_exists (str likecount-control "/ports.ready")))
             "NATIVE_SHOP_PRODUCTS_NAME_LIKE_COUNT_CONTROL_NOT_FRESH")
(let [bridge-port (tcp-client-free-port) daemon-port (tcp-client-free-port)]
  (likecount-check (and (number? bridge-port) (number? daemon-port)
                    (not (= bridge-port daemon-port))) "NATIVE_SHOP_PRODUCTS_NAME_LIKE_COUNT_DISTINCT_PORTS")
  (likecount-check (= (tcp-server-raw bridge-port "native-shop-products-name-like-count-handler" "127.0.0.1") "ok")
               "NATIVE_SHOP_PRODUCTS_NAME_LIKE_COUNT_LISTENER_START")
  (try
    (do
      (file_write (str likecount-control "/ports.json")
                  (json_str {"bridge" bridge-port "daemon" daemon-port}))
      (file_write (str likecount-control "/ports.ready") "ready")
      (let [deadline (+ (now-ms) 30000)]
        (while (and (< (now-ms) deadline) (not (deref likecount-done))) (fl-yield 10)))
      (likecount-check (deref likecount-done) "NATIVE_SHOP_PRODUCTS_NAME_LIKE_COUNT_CONTRACT_TIMEOUT")
      (if (nil? (deref likecount-error)) nil (throw (deref likecount-error)))
      (likecount-check (= (deref likecount-stage) "done") "NATIVE_SHOP_PRODUCTS_NAME_LIKE_COUNT_CONTRACT_INCOMPLETE")
      (likecount-check (= (buf-len (deref likecount-buffer)) 0) "NATIVE_SHOP_PRODUCTS_NAME_LIKE_COUNT_TRAILING_PACKET_BYTES"))
    (finally (tcp-server-stop bridge-port))))
(println (str "NATIVE_SHOP_PRODUCTS_NAME_LIKE_COUNT_RESULT "
  (json_str {"ok" true "prepared_parameters" 1
             "query" "SELECT COUNT(*) FROM shop_products WHERE name LIKE ?"
             "bind" ["%Widget%"] "select_executions" 1 "rows" 1
             "columns" (deref likecount-columns) "data" (deref likecount-rows)
             "exact_count" true "client_computes_count" false})))
(println "afj-db95 Native shop product name LIKE COUNT prepared SELECT PASS")
