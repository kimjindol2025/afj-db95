;; Native missing product SKU COUNT fixture agreed in msg_d32c32a16c0b.
;; Both original products remain seeded; server COUNT bind SKU-9 must return one text0 row.
(load "../src/sha1.fls")
(define skumisscount-control (env-get "AFJ_NATIVE_SHOP_PRODUCTS_SKU_COUNT_MISS_CONTROL"))
(define skumisscount-connection (atom nil))
(define skumisscount-buffer (atom ""))
(define skumisscount-stage (atom "handshake"))
(define skumisscount-sequence (atom 0))
(define skumisscount-columns (atom []))
(define skumisscount-rows (atom []))
(define skumisscount-error (atom nil))
(define skumisscount-done (atom false))
(define skumisscount-statement (atom nil))

(defn skumisscount-check [condition message]
  (if (= condition true) true (throw message)))

(defn skumisscount-u32 [value]
  (buf-concat [(buf-u8 (rem value 256))
               (buf-u8 (rem (floor (/ value 256)) 256))
               (buf-u8 (rem (floor (/ value 65536)) 256))
               (buf-u8 (rem (floor (/ value 16777216)) 256))]))

(defn skumisscount-read-u32 [bytes offset]
  (+ (buf-read-u8 bytes offset)
     (* 256 (buf-read-u8 bytes (+ offset 1)))
     (* 65536 (buf-read-u8 bytes (+ offset 2)))
     (* 16777216 (buf-read-u8 bytes (+ offset 3)))))

(defn skumisscount-send [payload sequence next-stage response-sequence]
  (let [length (buf-len payload)
        frame (buf-concat [(buf-slice (skumisscount-u32 length) 0 3)
                           (buf-u8 sequence) payload])]
    (reset! skumisscount-stage next-stage)
    (reset! skumisscount-sequence response-sequence)
    (skumisscount-check (= (tcp-write (deref skumisscount-connection) (buf-to-binary frame)) "ok")
                 "NATIVE_SHOP_PRODUCTS_SKU_COUNT_MISS_PACKET_WRITE")))

(defn skumisscount-command [code text next-stage]
  (skumisscount-send (buf-concat [(buf-u8 code) (buf-str text)])
              0 next-stage 1))

(defn skumisscount-text [bytes offset]
  (skumisscount-check (< offset (buf-len bytes)) "NATIVE_SHOP_PRODUCTS_SKU_COUNT_MISS_TEXT_PREFIX")
  (let [length (buf-read-u8 bytes offset) next (+ offset 1 length)]
    (skumisscount-check (and (< length 251) (<= next (buf-len bytes)))
                 "NATIVE_SHOP_PRODUCTS_SKU_COUNT_MISS_TEXT_LENGTH")
    {"value" (buf-read-str bytes (+ offset 1) length)
     "next" next}))

(defn skumisscount-column-name [bytes]
  (loop [index 0 offset 0]
    (let [field (skumisscount-text bytes offset)]
      (if (= index 4) (get field "value")
        (recur (+ index 1) (get field "next"))))))

(defn skumisscount-login [bytes]
  (skumisscount-check (= (buf-read-u8 bytes 0) 10) "NATIVE_SHOP_PRODUCTS_SKU_COUNT_MISS_HANDSHAKE_VERSION")
  (let [version-end
          (loop [offset 1]
            (do
              (skumisscount-check (< offset (buf-len bytes)) "NATIVE_SHOP_PRODUCTS_SKU_COUNT_MISS_HANDSHAKE_LENGTH")
              (if (= (buf-read-u8 bytes offset) 0) offset (recur (+ offset 1)))))
        first-offset (+ version-end 5)
        second-offset (+ first-offset 27)]
    (skumisscount-check (<= (+ second-offset 12) (buf-len bytes))
                 "NATIVE_SHOP_PRODUCTS_SKU_COUNT_MISS_SCRAMBLE_LENGTH")
    (let [scramble (buf-concat [(buf-slice bytes first-offset 8)
                                (buf-slice bytes second-offset 12)])
          token (sha1-mysql-native-token "development-only" scramble)
          login (buf-concat [(skumisscount-u32 172545) (skumisscount-u32 1048576)
                             (buf-u8 33) (sha1-zero-bytes 23)
                             (buf-str "root") (buf-u8 0)
                             (buf-u8 20) token])]
      (skumisscount-check (= (buf-len token) 20) "NATIVE_SHOP_PRODUCTS_SKU_COUNT_MISS_TOKEN_LENGTH")
      (skumisscount-send login 1 "login" 2))))

(defn skumisscount-frame [bytes sequence]
  (skumisscount-check (> (buf-len bytes) 0) "NATIVE_SHOP_PRODUCTS_SKU_COUNT_MISS_EMPTY_PACKET")
  (skumisscount-check (= sequence (deref skumisscount-sequence)) "NATIVE_SHOP_PRODUCTS_SKU_COUNT_MISS_PACKET_SEQUENCE")
  (swap! skumisscount-sequence + 1)
  (let [stage (deref skumisscount-stage) first-byte (buf-read-u8 bytes 0)]
    (if (= first-byte 255)
      (if (>= (buf-len bytes) 9)
        (throw (str "NATIVE_SHOP_PRODUCTS_SKU_COUNT_MISS_SERVER_ERROR_" stage " code="
                    (+ (buf-read-u8 bytes 1) (* 256 (buf-read-u8 bytes 2)))
                    " message=" (buf-read-str bytes 9 (- (buf-len bytes) 9))))
        (throw (str "NATIVE_SHOP_PRODUCTS_SKU_COUNT_MISS_SHORT_SERVER_ERROR_" stage)))
      nil)
    (cond
      (= stage "handshake") (skumisscount-login bytes)
      (= stage "login")
        (do
          (skumisscount-check (= first-byte 0) "NATIVE_SHOP_PRODUCTS_SKU_COUNT_MISS_LOGIN_ACK")
          (skumisscount-command 3 "CREATE TABLE shop_products (id INT PRIMARY KEY, sku TEXT, name TEXT, price INT, visible INT)"
                           "create"))
      (= stage "create")
        (do
          (skumisscount-check (= first-byte 0) "NATIVE_SHOP_PRODUCTS_SKU_COUNT_MISS_CREATE_ACK")
          (skumisscount-command 3 "INSERT INTO shop_products (id, sku, name, price, visible) VALUES (1, 'SKU-1', 'Demo Widget', 1500, 1)"
                           "seed"))
      (= stage "seed")
        (do
          (skumisscount-check (= first-byte 0) "NATIVE_SHOP_PRODUCTS_SKU_COUNT_MISS_FIRST_SEED_ACK")
          (skumisscount-command 3 "INSERT INTO shop_products (id, sku, name, price, visible) VALUES (2, 'SKU-2', 'Demo Gadget', 2200, 1)"
                            "second-seed"))
      (= stage "second-seed")
        (do
          (skumisscount-check (= first-byte 0) "NATIVE_SHOP_PRODUCTS_SKU_COUNT_MISS_SECOND_PRODUCT_SEED_ACK")
          (skumisscount-command 3 "CREATE TABLE shop_cart (id INT PRIMARY KEY, user_id INT, product_id INT, qty INT)" "cart-create"))
      (= stage "cart-create")
        (do
          (skumisscount-check (= first-byte 0) "NATIVE_SHOP_PRODUCTS_SKU_COUNT_MISS_CART_CREATE_ACK")
          (skumisscount-command 3 "INSERT INTO shop_cart (id, user_id, product_id, qty) VALUES (2, 20, 2, 1)" "second-cart-seed"))
      (= stage "second-cart-seed")
        (do
          (skumisscount-check (= first-byte 0) "NATIVE_SHOP_PRODUCTS_SKU_COUNT_MISS_SINGLE_CART_SEED_ACK")
          (skumisscount-command 22 "SELECT COUNT(*) FROM shop_products WHERE sku=?" "prepare"))
      (= stage "prepare")
        (do
          (skumisscount-check (and (= first-byte 0) (>= (buf-len bytes) 12))
                       "NATIVE_SHOP_PRODUCTS_SKU_COUNT_MISS_PREPARE_ACK")
          (skumisscount-check (and (= (buf-read-u8 bytes 7) 1)
                            (= (buf-read-u8 bytes 8) 0))
                       "NATIVE_SHOP_PRODUCTS_SKU_COUNT_MISS_PREPARE_ONE_PARAMETER")
          (reset! skumisscount-statement (skumisscount-read-u32 bytes 1))
          (let [execute (buf-concat [(buf-u8 23) (skumisscount-u32 (deref skumisscount-statement))
                                     (buf-u8 0) (skumisscount-u32 1)
                                     (buf-u8 0) (buf-u8 1) (buf-u8 253) (buf-u8 0)
                                     (buf-u8 5) (buf-str "SKU-9")])]
            (skumisscount-send execute 0 "select" 1)))
      (= stage "select")
        (do
          (skumisscount-check (and (= first-byte 1) (= (buf-len bytes) 1))
                       "NATIVE_SHOP_PRODUCTS_SKU_COUNT_MISS_SELECT_ONE_COLUMN")
          (reset! skumisscount-stage "columns"))
      (= stage "columns")
        (do
          (swap! skumisscount-columns conj (skumisscount-column-name bytes))
          (if (= (count (deref skumisscount-columns)) 1)
            (reset! skumisscount-stage "columns-end") nil))
      (= stage "columns-end")
        (do
          (skumisscount-check (and (= first-byte 254) (= (buf-len bytes) 5))
                       "NATIVE_SHOP_PRODUCTS_SKU_COUNT_MISS_COLUMN_EOF")
          (skumisscount-check (> (count (get (deref skumisscount-columns) 0)) 0)
                         "NATIVE_SHOP_PRODUCTS_SKU_COUNT_MISS_EXPRESSION_COLUMN")
          (reset! skumisscount-stage "rows"))
      (= stage "rows")
        (if (and (= first-byte 254) (= (buf-len bytes) 5))
          (do
            (skumisscount-check (= (count (deref skumisscount-rows)) 1)
                           "NATIVE_SHOP_PRODUCTS_SKU_COUNT_MISS_EXACTLY_ONE_ROW")
            (skumisscount-check (= (get (deref skumisscount-rows) 0) "0")
                           "NATIVE_SHOP_PRODUCTS_SKU_COUNT_MISS_EXACT_SERVER_TOTAL")
            (reset! skumisscount-stage "done")
            (reset! skumisscount-done true))
          (do
            (skumisscount-check (< (count (deref skumisscount-rows)) 1)
                           "NATIVE_SHOP_PRODUCTS_SKU_COUNT_MISS_EXTRA_ROW")
            (let [field (skumisscount-text bytes 0)]
              (skumisscount-check (= (get field "next") (buf-len bytes))
                             "NATIVE_SHOP_PRODUCTS_SKU_COUNT_MISS_ROW_TRAILING_BYTES")
              (swap! skumisscount-rows conj (get field "value")))))
      :else (throw "NATIVE_SHOP_PRODUCTS_SKU_COUNT_MISS_UNEXPECTED_STAGE"))))

(defn skumisscount-drain []
  (if (>= (buf-len (deref skumisscount-buffer)) 4)
    (let [bytes (deref skumisscount-buffer)
          length (+ (buf-read-u8 bytes 0) (* 256 (buf-read-u8 bytes 1))
                     (* 65536 (buf-read-u8 bytes 2)))]
      (skumisscount-check (<= length 65536) "NATIVE_SHOP_PRODUCTS_SKU_COUNT_MISS_PACKET_LIMIT")
      (if (>= (buf-len bytes) (+ 4 length))
        (do
          (reset! skumisscount-buffer (buf-slice bytes (+ 4 length)
                                         (- (buf-len bytes) (+ 4 length))))
          (skumisscount-frame (buf-slice bytes 4 length) (buf-read-u8 bytes 3))
          (skumisscount-drain))
        nil))
    nil))

(defn native-shop-products-sku-count-miss-handler [event connection payload peer]
  (try
    (cond
      (or (= event "connect") (= event "accept"))
        (do (skumisscount-check (nil? (deref skumisscount-connection)) "NATIVE_SHOP_PRODUCTS_SKU_COUNT_MISS_SINGLE_CONNECTION")
            (reset! skumisscount-connection connection))
      (= event "data")
        (do (reset! skumisscount-buffer
              (buf-concat [(deref skumisscount-buffer) (buf-from-binary payload)]))
            (skumisscount-drain))
      (= event "close")
        (skumisscount-check (deref skumisscount-done) "NATIVE_SHOP_PRODUCTS_SKU_COUNT_MISS_PREMATURE_CLOSE")
      :else nil)
    (catch [error]
      (reset! skumisscount-error (error_message error))
      (reset! skumisscount-done true))))

(skumisscount-check (not (nil? skumisscount-control)) "NATIVE_SHOP_PRODUCTS_SKU_COUNT_MISS_HOST_ENV_REQUIRED")
(skumisscount-check (not (file_exists (str skumisscount-control "/ports.ready")))
             "NATIVE_SHOP_PRODUCTS_SKU_COUNT_MISS_CONTROL_NOT_FRESH")
(let [bridge-port (tcp-client-free-port) daemon-port (tcp-client-free-port)]
  (skumisscount-check (and (number? bridge-port) (number? daemon-port)
                    (not (= bridge-port daemon-port))) "NATIVE_SHOP_PRODUCTS_SKU_COUNT_MISS_DISTINCT_PORTS")
  (skumisscount-check (= (tcp-server-raw bridge-port "native-shop-products-sku-count-miss-handler" "127.0.0.1") "ok")
               "NATIVE_SHOP_PRODUCTS_SKU_COUNT_MISS_LISTENER_START")
  (try
    (do
      (file_write (str skumisscount-control "/ports.json")
                  (json_str {"bridge" bridge-port "daemon" daemon-port}))
      (file_write (str skumisscount-control "/ports.ready") "ready")
      (let [deadline (+ (now-ms) 30000)]
        (while (and (< (now-ms) deadline) (not (deref skumisscount-done))) (fl-yield 10)))
      (skumisscount-check (deref skumisscount-done) "NATIVE_SHOP_PRODUCTS_SKU_COUNT_MISS_CONTRACT_TIMEOUT")
      (if (nil? (deref skumisscount-error)) nil (throw (deref skumisscount-error)))
      (skumisscount-check (= (deref skumisscount-stage) "done") "NATIVE_SHOP_PRODUCTS_SKU_COUNT_MISS_CONTRACT_INCOMPLETE")
      (skumisscount-check (= (buf-len (deref skumisscount-buffer)) 0) "NATIVE_SHOP_PRODUCTS_SKU_COUNT_MISS_TRAILING_PACKET_BYTES"))
    (finally (tcp-server-stop bridge-port))))
(println (str "NATIVE_SHOP_PRODUCTS_SKU_COUNT_MISS_RESULT "
  (json_str {"ok" true "prepared_parameters" 1
             "query" "SELECT COUNT(*) FROM shop_products WHERE sku=?"
             "bind" ["SKU-9"] "select_executions" 1 "rows" 1
             "columns" (deref skumisscount-columns) "data" (deref skumisscount-rows)
             "exact_count" true "client_computes_count" false})))
(println "afj-db95 Native shop missing product SKU COUNT prepared SELECT PASS")
