;; Independent Native codec contract for prepared wire frames, outside case66.
;; Existing codec only: no case71 client, proxy implementation or daemon change.
(load "../src/mariadb-wire.fls")
(define packet-checks (atom 0))
(define packet-statement-id 16909060)
(define packet-sql "INSERT INTO packet_products (id,sku) VALUES (?,?)")

(defn packet-check [condition message]
  (if (= condition true) (swap! packet-checks + 1) (throw message)))

(defn packet-body [frame payload-length sequence]
  (packet-check (= (buf-len frame) (+ payload-length 4)) "PREPARED_PACKET_FRAME_LENGTH")
  (packet-check (and (= (buf-read-u8 frame 0) (rem payload-length 256))
                     (= (buf-read-u8 frame 1) (rem (floor (/ payload-length 256)) 256))
                     (= (buf-read-u8 frame 2) (floor (/ payload-length 65536))))
                "PREPARED_PACKET_LENGTH_BYTES")
  (packet-check (= (buf-read-u8 frame 3) sequence) "PREPARED_PACKET_SEQUENCE_BYTE")
  (packet-check (mariadb-packet-complete? frame) "PREPARED_PACKET_NOT_COMPLETE")
  (mariadb-packet-payload frame))

(define prepare-payload (buf-concat [(buf-u8 22) (buf-str packet-sql)]))
(define prepare-frame (mariadb-packet 0 prepare-payload))
(define prepare-body (packet-body prepare-frame (+ 1 (buf-len (buf-str packet-sql))) 0))
(packet-check (= (buf-read-u8 prepare-body 0) 22) "PREPARED_PACKET_PREPARE_OPCODE")
(packet-check (= (buf-read-str prepare-body 1 (- (buf-len prepare-body) 1)) packet-sql)
              "PREPARED_PACKET_PREPARE_SQL")
(packet-check (= (mariadb-wire-placeholder-count packet-sql) 2)
              "PREPARED_PACKET_PARAMETER_COUNT")

(define acknowledge-frame
  (mariadb-packet 1 (mariadb-wire-prepare-payload packet-statement-id 2)))
(define acknowledge-body (packet-body acknowledge-frame 12 1))
(packet-check (= (buf-read-u8 acknowledge-body 0) 0) "PREPARED_PACKET_ACK_OK")
(packet-check (and (= (buf-read-u8 acknowledge-body 1) 4)
                   (= (buf-read-u8 acknowledge-body 2) 3)
                   (= (buf-read-u8 acknowledge-body 3) 2)
                   (= (buf-read-u8 acknowledge-body 4) 1))
              "PREPARED_PACKET_STATEMENT_ID_LITTLE_ENDIAN")
(packet-check (= (mariadb-read-u32le acknowledge-body 1) packet-statement-id)
              "PREPARED_PACKET_ACK_STATEMENT_ID")
(packet-check (and (= (buf-read-u8 acknowledge-body 5) 0)
                   (= (buf-read-u8 acknowledge-body 6) 0)
                   (= (buf-read-u8 acknowledge-body 7) 2)
                   (= (buf-read-u8 acknowledge-body 8) 0))
              "PREPARED_PACKET_ACK_COUNTS")

(define execute-payload
  (buf-concat [(buf-u8 23) (mariadb-u32le packet-statement-id)
               (buf-u8 0) (mariadb-u32le 1)
               (buf-u8 0) (buf-u8 1)
               (buf-u8 3) (buf-u8 0) (buf-u8 253) (buf-u8 0)
               (mariadb-u32le 513) (mariadb-lenenc-string "packet-bind")]))
(define execute-frame (mariadb-packet 0 execute-payload))
(define execute-body (packet-body execute-frame 32 0))
(packet-check (= (buf-read-u8 execute-body 0) 23) "PREPARED_PACKET_EXECUTE_OPCODE")
(packet-check (= (mariadb-read-u32le execute-body 1) packet-statement-id)
              "PREPARED_PACKET_EXECUTE_STATEMENT_ID")
(packet-check (and (= (buf-read-u8 execute-body 5) 0)
                   (= (mariadb-read-u32le execute-body 6) 1))
              "PREPARED_PACKET_EXECUTE_FLAGS_AND_ITERATION")
(packet-check (and (= (buf-read-u8 execute-body 10) 0)
                   (= (buf-read-u8 execute-body 11) 1))
              "PREPARED_PACKET_NULL_BITMAP_AND_NEW_TYPES")
(packet-check (and (= (buf-read-u8 execute-body 12) 3)
                   (= (buf-read-u8 execute-body 13) 0)
                   (= (buf-read-u8 execute-body 14) 253)
                   (= (buf-read-u8 execute-body 15) 0))
              "PREPARED_PACKET_TYPED_BINDINGS")
(packet-check (and (= (buf-read-u8 execute-body 16) 1)
                   (= (buf-read-u8 execute-body 17) 2)
                   (= (buf-read-u8 execute-body 18) 0)
                   (= (buf-read-u8 execute-body 19) 0))
              "PREPARED_PACKET_INTEGER_BINDING_BYTES")
(packet-check (and (= (buf-read-u8 execute-body 20) 11)
                   (= (buf-read-str execute-body 21 11) "packet-bind"))
              "PREPARED_PACKET_STRING_BINDING_BYTES")

(define packet-types (mariadb-wire-read-types-at execute-body 12 0 2 []))
(packet-check (and (= (count packet-types) 2)
                   (= (get (get packet-types 0) "type") 3)
                   (= (get (get packet-types 1) "type") 253)
                   (= (get (get packet-types 0) "unsigned") false)
                   (= (get (get packet-types 1) "unsigned") false))
              "PREPARED_PACKET_DECODED_TYPES")
(define packet-decoded
  (mariadb-wire-read-parameters-at execute-body 16 10 0 packet-types []))
(define packet-values (get packet-decoded "values"))
(packet-check (and (= (count packet-values) 2)
                   (= (get packet-values 0) 513)
                   (= (get packet-values 1) "packet-bind"))
              "PREPARED_PACKET_DECODED_VALUES")
(packet-check (= (get packet-decoded "next") 32) "PREPARED_PACKET_ALL_VALUES_CONSUMED")
(define packet-bound-sql (mariadb-wire-bind packet-sql packet-values))
(packet-check (= packet-bound-sql
                 "INSERT INTO packet_products (id,sku) VALUES (513,'packet-bind')")
              "PREPARED_PACKET_SQL_BINDING")
(println (str "NATIVE_MARIADB_PREPARED_PACKETS_RESULT "
  (json_str {"ok" true "frames" 3 "prepared_parameters" 2
             "statement_id" packet-statement-id "types" [3 253]
             "values" packet-values "execute_payload_bytes" 32
             "sql_binding" packet-bound-sql "checks" (deref packet-checks)})))
(println "afj-db95 Native MariaDB prepared packet frames PASS")
