;; AFJ-014 durable row-version history must survive catalog-page recovery.
(load "/root/kilo-freelang/projects/afj-db95/src/tcp-server.fls")

(if (file_exists afj-tcp-wal) (file_delete afj-tcp-wal) nil)
(if (file_exists afj-tcp-catalog-page-path)
  (file_delete afj-tcp-catalog-page-path)
  nil)
(reset! engine-catalog {})
(reset! engine-indexes {})
(reset! engine-databases {})
(reset! afj-tcp-commit-revision 0)
(reset! afj-tcp-table-revisions {})
(reset! afj-tcp-schema-revisions {})
(reset! afj-tcp-row-versions {})

(afj-tcp-commit-ast
  {"type" "create-table" "table" "checkpoint_versions"
   "schema" {"columns" [{"name" "id" "type" "INTEGER"
                            "nullable" false "primary" true}
                           {"name" "value" "type" "INTEGER"
                            "nullable" false}]
              "primary-key" "id" "unique-columns" []}})
(afj-tcp-commit-ast
  {"type" "insert" "table" "checkpoint_versions"
   "row" {"id" "1" "value" "10"}})
(afj-tcp-commit-ast
  {"type" "update" "table" "checkpoint_versions"
   "where" {"column" "id" "equals" "1"}
   "changes" {"value" "20"}})

(let [manifest (afj-tcp-read-page-set-value afj-tcp-catalog-page-path)
      table-page (afj-tcp-read-page-set-value
                   (afj-tcp-table-page-path "checkpoint_versions"))
      history (get table-page "row-version-history")
      chain (get history "1")]
  (if (and (= (get manifest "commit-revision") 3)
           (= (get (get manifest "schema-revisions") "checkpoint_versions") 1)
           (>= (count chain) 2))
    (println "afj-db95 durable row-version checkpoint write PASS")
    (throw "durable row-version checkpoint was not written")))

(reset! engine-catalog {})
(reset! engine-indexes {})
(reset! engine-databases {})
(reset! afj-tcp-commit-revision 0)
(reset! afj-tcp-table-revisions {})
(reset! afj-tcp-schema-revisions {})
(reset! afj-tcp-row-versions {})
(afj-tcp-recover)
(let [schema-revision (get (deref afj-tcp-schema-revisions) "checkpoint_versions" 0)
      chain (get (get (deref afj-tcp-row-versions) "checkpoint_versions") "1")
      old (afj-tcp-versioned-rows "checkpoint_versions" [] 2)
      current (afj-tcp-versioned-rows "checkpoint_versions" [] 3)]
  (if (and (= (deref afj-tcp-commit-revision) 3)
           (= schema-revision 1)
           (>= (count chain) 2)
           (= (get (first old) "value") "10")
           (= (get (first current) "value") "20"))
    (println "afj-db95 durable row-version checkpoint recovery PASS")
    (throw "durable row-version checkpoint recovery failed")))

(if (file_exists afj-tcp-wal) (file_delete afj-tcp-wal) nil)
(if (file_exists afj-tcp-catalog-page-path)
  (file_delete afj-tcp-catalog-page-path)
  nil)
