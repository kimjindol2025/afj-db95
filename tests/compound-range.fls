;; AFJ-013 compound predicate range planning contract.
(load "../src/engine.fls")
(load "../src/sql-core.fls")

(reset! engine-catalog {})
(reset! engine-indexes {})
(execute-ast (parse-sql
               "CREATE TABLE compound_range (id INTEGER PRIMARY KEY, tenant TEXT, email TEXT UNIQUE)"))
(execute-ast {"type" "insert" "table" "compound_range"
              "rows" [{"id" 1 "tenant" "a"}
                      {"id" 2 "tenant" "b" "email" "a@example.test"}
                      {"id" 3 "tenant" "a" "email" "b@example.test"}
                      {"id" 4 "tenant" "a" "email" "c@example.test"}]})

(let [query (execute-ast
              (parse-sql
                "SELECT * FROM compound_range WHERE id > 1 AND tenant = 'a'"))
      rows (get query "rows")]
  (if (and (= (get query "plan") "index-range-scan")
           (= (count rows) 2)
           (= (get (first rows) "id") 3)
           (= (get (last rows) "id") 4))
    (println "afj-db95 compound range predicate PASS")
    (throw "compound range predicate failed")))

(let [query (execute-ast
              (parse-sql
                "SELECT * FROM compound_range WHERE tenant = 'a' AND id >= 3"))]
  (if (and (= (get query "plan") "index-range-scan")
           (= (count (get query "rows")) 2))
    (println "afj-db95 compound range reverse predicate PASS")
    (throw "compound reverse range predicate failed")))

(let [query (execute-ast
              (parse-sql
                "SELECT * FROM compound_range WHERE id > 1 AND email = 'c@example.test'"))]
  (if (and (= (get query "plan") "index-range-scan")
           (= (count (get query "rows")) 1)
           (= (get (first (get query "rows")) "id") 4))
    (println "afj-db95 multi-index intersection PASS")
    (throw "multi-index intersection failed")))

;; Numeric components arrive from the SQL parser as decimal strings. Composite
;; range candidates must compare them numerically, not lexicographically.
(execute-ast (parse-sql
  "CREATE TABLE numeric_compound (id INTEGER, tenant TEXT, UNIQUE (id,tenant))"))
(execute-ast {"type" "insert" "table" "numeric_compound"
              "rows" (map (fn [id] {"id" (str id) "tenant" "x"})
                         (range 1 101))})
(let [query (execute-ast
              (parse-sql
                "SELECT * FROM numeric_compound WHERE id > 2 AND tenant = 'x'"))
      rows (get query "rows")]
  (if (and (= (get query "plan") "index-full-scan")
           (= (count rows) 98)
           (any? (fn [row] (= (get row "id") "100")) rows))
    (println "afj-db95 composite numeric range PASS")
    (throw "composite numeric range lost rows due to string key ordering")))

(execute-ast (parse-sql
  "CREATE TABLE numeric_single (id INTEGER PRIMARY KEY, note TEXT)"))
(execute-ast {"type" "insert" "table" "numeric_single"
              "rows" (map (fn [id] {"id" (str id) "note" "x"})
                         (range 1 101))})
(let [query (execute-ast
              (parse-sql "SELECT * FROM numeric_single WHERE id > 2"))
      rows (get query "rows")]
  (if (and (= (count rows) 98)
           (any? (fn [row] (= (get row "id") "100")) rows))
    (println "afj-db95 single numeric range PASS")
    (throw "single INTEGER index range lost rows due to string key ordering")))

;; Delimiter characters are ordinary TEXT data and must not be mistaken for
;; composite-key component boundaries during range candidate selection.
(execute-ast (parse-sql
  "CREATE TABLE pipe_compound (label TEXT, tenant TEXT, UNIQUE (label,tenant))"))
(execute-ast {"type" "insert" "table" "pipe_compound"
              "rows" [{"label" "a|x" "tenant" "q"}]})
(let [query (execute-ast
              (parse-sql
                "SELECT * FROM pipe_compound WHERE label > 'a' AND tenant = 'q'"))]
  (if (and (= (get query "plan") "index-full-scan")
           (= (count (get query "rows")) 1)
           (= (get (first (get query "rows")) "label") "a|x"))
    (println "afj-db95 composite delimiter range PASS")
    (throw "composite range split TEXT data as a key delimiter")))

;; Use two persisted leaf pages with mixed tenant values. The leading
;; component range must visit the second page, then recheck tenant so the
;; non-matching row is not returned by the page-range branch.
(let [rows [{"id" "1" "tenant" "a"}
            {"id" "2" "tenant" "b"}
            {"id" "3" "tenant" "b"}
            {"id" "4" "tenant" "a"}]
      schema {"columns" [{"name" "id" "type" "TEXT"
                            "nullable" false}
                           {"name" "tenant" "type" "TEXT"
                            "nullable" false}]
              "primary-key" nil "unique-columns" []
              "unique-groups" [["id" "tenant"]]}
      tree {"leaf" false "separators" ["3|a"]
            "children" [{"leaf" true "entries"
                          [{"key" "1|a" "row-id" 0}
                           {"key" "2|a" "row-id" 1}]}
                         {"leaf" true "entries"
                          [{"key" "3|a" "row-id" 2}
                           {"key" "4|a" "row-id" 3}]}]}
      _catalog (reset! engine-catalog
                        {"paged_compound" {"name" "paged_compound"
                                           "rows" rows "columns" ["id" "tenant"]
                                           "schema" schema}})
      _set (reset! engine-indexes
                   {"paged_compound.id|tenant"
                    {"table" "paged_compound" "column" "id|tenant"
                     "columns" ["id" "tenant"] "buckets" {}
                     "btree" tree}})
      query (execute-ast
              {"type" "select" "columns" ["*"] "table" "paged_compound"
               "where" {"and" [{"column" "id" "operator" ">" "value" "2"}
                                  {"column" "tenant" "equals" "a"}]}})]
  (if (and (not (get tree "leaf"))
           (= (get query "plan") "index-full-scan")
            (= (count (get query "rows")) 1)
            (= (get (first (get query "rows")) "id") "4"))
    (println "afj-db95 composite page range PASS")
    (throw "composite page range failed")))
