;; Stable TCP error-code mapping contract.
(load "../src/tcp-server.fls")

(let [known (afj-tcp-error-code-message
              "[engine] UNIQUE_VIOLATION: email")
      parameter (afj-tcp-error-code-message
                  "[server-engine] PARAMETER_COUNT_MISMATCH")
      primary (afj-tcp-error-code-message "PRIMARY_KEY_VIOLATION")
      database (afj-tcp-error-code-message "DATABASE_EXISTS")
      lock (afj-tcp-error-code-message "DEADLOCK_DETECTED")
      collation (afj-tcp-error-code-message "COLLATION_NOT_SUPPORTED")
      unsupported (afj-tcp-error-code-message "[parse-select] unsupported SELECT form")
      unknown (afj-tcp-error-code-message "unexpected runtime failure")]
  (if (and (= known "UNIQUE_VIOLATION")
           (= parameter "PARAMETER_COUNT_MISMATCH")
           (= primary "PRIMARY_KEY_VIOLATION")
           (= database "DATABASE_EXISTS")
           (= lock "DEADLOCK_DETECTED")
           (= collation "COLLATION_NOT_SUPPORTED")
           (= unsupported "UNSUPPORTED_SQL")
           (= unknown "SQL_ERROR"))
    (println "afj-db95 error mapping PASS")
    (throw "stable error mapping failure")))
