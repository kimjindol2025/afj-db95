;; Native per-user cart listing fixture agreed in msg_bc5e0d708956.
;; Two users are seeded; prepared user_id=10 must return exactly that user cart row.
(load "../src/sha1.fls")
(define usercart-control (env-get "AFJ_NATIVE_SHOP_CART_USER_CONTROL"))
(define usercart-connection (atom nil))
(define usercart-buffer (atom ""))
(define usercart-stage (atom "handshake"))
(define usercart-sequence (atom 0))
(define usercart-columns (atom []))
(define usercart-rows (atom []))
(define usercart-error (atom nil))
(define usercart-done (atom false))
(define usercart-statement (atom nil))

(defn usercart-check [condition message]
  (if (= condition true) true (throw message)))

(defn usercart-u32 [value]
  (buf-concat [(buf-u8 (rem value 256))
               (buf-u8 (rem (floor (/ value 256)) 256))
               (buf-u8 (rem (floor (/ value 65536)) 256))
               (buf-u8 (rem (floor (/ value 16777216)) 256))]))

(defn usercart-read-u32 [bytes offset]
  (+ (buf-read-u8 bytes offset)
     (* 256 (buf-read-u8 bytes (+ offset 1)))
     (* 65536 (buf-read-u8 bytes (+ offset 2)))
     (* 16777216 (buf-read-u8 bytes (+ offset 3)))))

(defn usercart-send [payload sequence next-stage response-sequence]
  (let [length (buf-len payload)
        frame (buf-concat [(buf-slice (usercart-u32 length) 0 3)
                           (buf-u8 sequence) payload])]
    (reset! usercart-stage next-stage)
    (reset! usercart-sequence response-sequence)
    (usercart-check (= (tcp-write (deref usercart-connection) (buf-to-binary frame)) "ok")
                 "NATIVE_SHOP_CART_USER_PACKET_WRITE")))

(defn usercart-command [code text next-stage]
  (usercart-send (buf-concat [(buf-u8 code) (buf-str text)])
              0 next-stage 1))

(defn usercart-text [bytes offset]
  (usercart-check (< offset (buf-len bytes)) "NATIVE_SHOP_CART_USER_TEXT_PREFIX")
  (let [length (buf-read-u8 bytes offset) next (+ offset 1 length)]
    (usercart-check (and (< length 251) (<= next (buf-len bytes)))
                 "NATIVE_SHOP_CART_USER_TEXT_LENGTH")
    {"value" (buf-read-str bytes (+ offset 1) length)
     "next" next}))

(defn usercart-column-name [bytes]
  (loop [index 0 offset 0]
    (let [field (usercart-text bytes offset)]
      (if (= index 4) (get field "value")
        (recur (+ index 1) (get field "next"))))))

(defn usercart-login [bytes]
  (usercart-check (= (buf-read-u8 bytes 0) 10) "NATIVE_SHOP_CART_USER_HANDSHAKE_VERSION")
  (let [version-end
          (loop [offset 1]
            (do
              (usercart-check (< offset (buf-len bytes)) "NATIVE_SHOP_CART_USER_HANDSHAKE_LENGTH")
              (if (= (buf-read-u8 bytes offset) 0) offset (recur (+ offset 1)))))
        first-offset (+ version-end 5)
        second-offset (+ first-offset 27)]
    (usercart-check (<= (+ second-offset 12) (buf-len bytes))
                 "NATIVE_SHOP_CART_USER_SCRAMBLE_LENGTH")
    (let [scramble (buf-concat [(buf-slice bytes first-offset 8)
                                (buf-slice bytes second-offset 12)])
          token (sha1-mysql-native-token "development-only" scramble)
          login (buf-concat [(usercart-u32 172545) (usercart-u32 1048576)
                             (buf-u8 33) (sha1-zero-bytes 23)
                             (buf-str "root") (buf-u8 0)
                             (buf-u8 20) token])]
      (usercart-check (= (buf-len token) 20) "NATIVE_SHOP_CART_USER_TOKEN_LENGTH")
      (usercart-send login 1 "login" 2))))


(define usercart-setup
  ["CREATE TABLE shop_cart (id INT PRIMARY KEY, user_id INT, product_id INT, qty INT)"
   "INSERT INTO shop_cart (id, user_id, product_id, qty) VALUES (1, 10, 1, 2)"
   "INSERT INTO shop_cart (id, user_id, product_id, qty) VALUES (2, 20, 2, 1)"])
(define usercart-queries
  [{"sql" "SELECT id, user_id, product_id, qty FROM shop_cart WHERE user_id=?"
    "bind" [10] "response" "resultset" "columns" ["id" "user_id" "product_id" "qty"]
    "row-count" 1 "expected-row" {"id" "1" "user_id" "10" "product_id" "1" "qty" "2"}}])
(define usercart-setup-index (atom 0))
(define usercart-query-index (atom 0))
(define usercart-results (atom []))
(define usercart-column-count (atom 0))

(defn usercart-row-map [bytes]
  (loop [index 0 offset 0 result {}]
    (if (= index (deref usercart-column-count))
      (do
        (usercart-check (= offset (buf-len bytes)) "NATIVE_SHOP_CART_USER_ROW_TRAILING_BYTES")
        result)
      (let [field (usercart-text bytes offset)]
        (recur (+ index 1) (get field "next")
               (assoc result (get (deref usercart-columns) index) (get field "value")))))))

(defn usercart-prepare-current []
  (reset! usercart-columns [])
  (reset! usercart-rows [])
  (usercart-command 22 (get (get usercart-queries (deref usercart-query-index)) "sql") "prepare"))

(defn usercart-finish-result []
  (let [index (deref usercart-query-index)
        query (get usercart-queries index)
        rows (deref usercart-rows)]
    (usercart-check (= (count rows) (get query "row-count"))
                    "NATIVE_SHOP_CART_USER_EXACT_ROW_COUNT")
    (if (= (get query "row-count") 1)
      (doseq [column (get query "columns")]
        (usercart-check (= (get (get rows 0) column)
                           (get (get query "expected-row") column))
                        "NATIVE_SHOP_CART_USER_EXACT_ROW_VALUE"))
      nil)
    (swap! usercart-results conj
           {"query" (get query "sql") "bind" (get query "bind")
            "response" (get query "response") "rows" (count rows) "columns" (deref usercart-columns) "data" rows})
    (if (< (+ index 1) (count usercart-queries))
      (do (swap! usercart-query-index + 1) (usercart-prepare-current))
      (do (reset! usercart-stage "done") (reset! usercart-done true)))))

(defn usercart-frame [bytes sequence]
  (usercart-check (> (buf-len bytes) 0) "NATIVE_SHOP_CART_USER_EMPTY_PACKET")
  (usercart-check (= sequence (deref usercart-sequence)) "NATIVE_SHOP_CART_USER_PACKET_SEQUENCE")
  (swap! usercart-sequence + 1)
  (let [stage (deref usercart-stage) first-byte (buf-read-u8 bytes 0)]
    (if (= first-byte 255)
      (if (>= (buf-len bytes) 9)
        (throw (str "NATIVE_SHOP_CART_USER_SERVER_ERROR_" stage " code="
                    (+ (buf-read-u8 bytes 1) (* 256 (buf-read-u8 bytes 2)))
                    " message=" (buf-read-str bytes 9 (- (buf-len bytes) 9))))
        (throw "NATIVE_SHOP_CART_USER_SHORT_SERVER_ERROR"))
      nil)
    (cond
      (= stage "handshake") (usercart-login bytes)
      (= stage "login")
        (do (usercart-check (= first-byte 0) "NATIVE_SHOP_CART_USER_LOGIN_ACK")
            (usercart-command 3 (get usercart-setup 0) "setup"))
      (= stage "setup")
        (do
          (usercart-check (= first-byte 0) "NATIVE_SHOP_CART_USER_SETUP_ACK")
          (swap! usercart-setup-index + 1)
          (if (< (deref usercart-setup-index) (count usercart-setup))
            (usercart-command 3 (get usercart-setup (deref usercart-setup-index)) "setup")
            (usercart-prepare-current)))
      (= stage "prepare")
        (let [parameters (count (get (get usercart-queries (deref usercart-query-index)) "bind"))]
          (usercart-check (and (= first-byte 0) (>= (buf-len bytes) 12))
                          "NATIVE_SHOP_CART_USER_PREPARE_ACK")
          (usercart-check (and (= (buf-read-u8 bytes 7) parameters)
                               (= (buf-read-u8 bytes 8) 0))
                          "NATIVE_SHOP_CART_USER_PARAMETER_COUNT")
          (reset! usercart-statement (usercart-read-u32 bytes 1))
          (let [bind (get (get usercart-queries (deref usercart-query-index)) "bind")
                execute (atom (buf-concat [(buf-u8 23) (usercart-u32 (deref usercart-statement))
                                           (buf-u8 0) (usercart-u32 1)
                                           (buf-u8 0) (buf-u8 1)]))]
            ;; Existing Native INT32 and VAR_STRING parameter types.
            (doseq [value bind]
              (usercart-check (or (number? value) (string? value))
                            "NATIVE_SHOP_CART_USER_BIND_TYPE")
              (reset! execute (buf-concat [(deref execute)
                                           (buf-u8 (if (number? value) 3 253)) (buf-u8 0)])))
            (doseq [value bind]
              (let [encoded (if (number? value)
                              (usercart-u32 value)
                              (let [text (buf-str value)]
                                (usercart-check (< (buf-len text) 251)
                                              "NATIVE_SHOP_CART_USER_SHORT_TEXT_BIND")
                                (buf-concat [(buf-u8 (buf-len text)) text])))]
                (reset! execute (buf-concat [(deref execute) encoded]))))
            (usercart-send (deref execute) 0 "select" 1)))
      (= stage "select")
        (let [query (get usercart-queries (deref usercart-query-index))]
          (usercart-check (and (= (buf-len bytes) 1)
                             (= first-byte (count (get query "columns"))))
                        "NATIVE_SHOP_CART_USER_RESULT_HEADER")
          (reset! usercart-column-count first-byte)
          (reset! usercart-stage "columns"))
      (= stage "columns")
        (do
          (swap! usercart-columns conj (usercart-column-name bytes))
          (if (= (count (deref usercart-columns)) (deref usercart-column-count))
            (reset! usercart-stage "columns-end") nil))
      (= stage "columns-end")
        (do
          (usercart-check (and (= first-byte 254) (= (buf-len bytes) 5))
                          "NATIVE_SHOP_CART_USER_COLUMN_EOF")
          ;; An empty result need not expose id metadata; ERR and rows remain strict.
          (if (= (get (get usercart-queries (deref usercart-query-index)) "row-count") 0) nil
            (usercart-check (= (deref usercart-columns)
                               (get (get usercart-queries (deref usercart-query-index)) "columns"))
                            "NATIVE_SHOP_CART_USER_RESULT_SCHEMA"))
          (reset! usercart-stage "rows"))
      (= stage "rows")
        (if (and (= first-byte 254) (= (buf-len bytes) 5))
          (usercart-finish-result)
          (do
            (usercart-check (< (count (deref usercart-rows))
                               (get (get usercart-queries (deref usercart-query-index)) "row-count"))
                            "NATIVE_SHOP_CART_USER_EXTRA_ROW")
            (swap! usercart-rows conj (usercart-row-map bytes))))
      :else (throw "NATIVE_SHOP_CART_USER_UNEXPECTED_STAGE"))))
(defn usercart-drain []
  (if (>= (buf-len (deref usercart-buffer)) 4)
    (let [bytes (deref usercart-buffer)
          length (+ (buf-read-u8 bytes 0) (* 256 (buf-read-u8 bytes 1))
                     (* 65536 (buf-read-u8 bytes 2)))]
      (usercart-check (<= length 65536) "NATIVE_SHOP_CART_USER_PACKET_LIMIT")
      (if (>= (buf-len bytes) (+ 4 length))
        (do
          (reset! usercart-buffer (buf-slice bytes (+ 4 length)
                                         (- (buf-len bytes) (+ 4 length))))
          (usercart-frame (buf-slice bytes 4 length) (buf-read-u8 bytes 3))
          (usercart-drain))
        nil))
    nil))

(defn native-shop-cart-user-handler [event connection payload peer]
  (try
    (cond
      (or (= event "connect") (= event "accept"))
        (do (usercart-check (nil? (deref usercart-connection)) "NATIVE_SHOP_CART_USER_SINGLE_CONNECTION")
            (reset! usercart-connection connection))
      (= event "data")
        (do (reset! usercart-buffer
              (buf-concat [(deref usercart-buffer) (buf-from-binary payload)]))
            (usercart-drain))
      (= event "close")
        (usercart-check (deref usercart-done) "NATIVE_SHOP_CART_USER_PREMATURE_CLOSE")
      :else nil)
    (catch [error]
      (reset! usercart-error (error_message error))
      (reset! usercart-done true))))

(usercart-check (not (nil? usercart-control)) "NATIVE_SHOP_CART_USER_HOST_ENV_REQUIRED")
(usercart-check (not (file_exists (str usercart-control "/ports.ready")))
             "NATIVE_SHOP_CART_USER_CONTROL_NOT_FRESH")
(let [bridge-port (tcp-client-free-port) daemon-port (tcp-client-free-port)]
  (usercart-check (and (number? bridge-port) (number? daemon-port)
                    (not (= bridge-port daemon-port))) "NATIVE_SHOP_CART_USER_DISTINCT_PORTS")
  (usercart-check (= (tcp-server-raw bridge-port "native-shop-cart-user-handler" "127.0.0.1") "ok")
               "NATIVE_SHOP_CART_USER_LISTENER_START")
  (try
    (do
      (file_write (str usercart-control "/ports.json")
                  (json_str {"bridge" bridge-port "daemon" daemon-port}))
      (file_write (str usercart-control "/ports.ready") "ready")
      (let [deadline (+ (now-ms) 30000)]
        (while (and (< (now-ms) deadline) (not (deref usercart-done))) (fl-yield 10)))
      (usercart-check (deref usercart-done) "NATIVE_SHOP_CART_USER_CONTRACT_TIMEOUT")
      (if (nil? (deref usercart-error)) nil (throw (deref usercart-error)))
      (usercart-check (= (deref usercart-stage) "done") "NATIVE_SHOP_CART_USER_CONTRACT_INCOMPLETE")
      (usercart-check (= (buf-len (deref usercart-buffer)) 0) "NATIVE_SHOP_CART_USER_TRAILING_PACKET_BYTES"))
    (finally (tcp-server-stop bridge-port))))
(usercart-check (= (count (deref usercart-results)) 1) "NATIVE_SHOP_CART_USER_ONE_RESULT")
(println (str "NATIVE_SHOP_CART_USER_RESULT "
  (json_str {"ok" true "user_id" 10 "prepared_executions" 1
             "prepared_select_executions" 1 "rows" 1 "unrelated_user_row_absent" true
             "err_packets" 0 "results" (deref usercart-results)})))
(println "afj-db95 Native shop per-user cart prepared SELECT PASS")
