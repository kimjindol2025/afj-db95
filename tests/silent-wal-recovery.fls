;; A long WAL must replay once, in order, without losing committed rows.
(load "../src/afj-db95.fls")

(define path (env-get "DB95_TEST_WAL"))
(if (nil? path) (throw "DB95_TEST_WAL_REQUIRED") nil)
(define expected-rows
  (map (fn [id] {"id" id "value" (str "value-" id)})
       (range 0 3200)))
(define expected-hash (sha256 (json_str expected-rows)))
(define fixture-events
  (concat
    [{"op" "create-table" "name" "silent_wal_rows"
      "columns" {"id" "INTEGER" "value" "TEXT"}}]
    (map (fn [row] {"op" "insert" "name" "silent_wal_rows"
                    "row" row}) expected-rows)))
(println (str "DB95_WAL_BEFORE count=" (count expected-rows)
              " hash=" expected-hash))
(file_write path
  (str (str_join_lines
         (map (fn [event]
                (let [encoded (json_str event)]
                  (json_str {"version" afj-wal-version
                             "length" (count encoded)
                             "checksum" (sha256 encoded)
                             "body" event})))
              fixture-events)) "\n"))

(try
  (do
    (open-store path)
    (let [rows (select-all "silent_wal_rows")]
      (println (str "DB95_WAL_AFTER count=" (count rows)
                    " hash=" (sha256 (json_str rows)))))
    (close-store))
  (catch [error]
    (do
      (println (str "DB95_WAL_RECOVER_ERROR=" (error_message error)))
      (throw error))))

(let [loaded-events (load-wal-events path)
      rows (select-all "silent_wal_rows")]
  (println (str "DB95_WAL_COUNTS events=" (count loaded-events)
                " rows=" (count rows)
                " first=" (get (first rows) "value")))
  (if (and (= (count loaded-events) 3201)
           (= (count rows) 3200)
           (= (sha256 (json_str rows)) expected-hash)
           (= (get (first rows) "value") "value-0"))
    (println "PASS silent-wal-recovery")
    (throw "WAL_REPLAY_MISMATCH")))

;; Complete invalid records, including the final line, are never torn tails.
(let [valid (file_read path)]
  (file_append path "{\"version\":1,\"body\":{}}\n")
  (try
    (do (open-store path) (throw "WAL_CORRUPT_NOT_RAISED"))
    (catch [error]
      (if (str_ends_with (error_message error) "WAL_CORRUPT")
        (println "PASS silent-wal-corrupt-tail")
        (throw error))))
  (file_write path (str "not-json\n" valid))
  (try
    (do (open-store path) (throw "WAL_CORRUPT_NOT_RAISED"))
    (catch [error]
      (if (str_ends_with (error_message error) "WAL_CORRUPT")
        (println "PASS silent-wal-corrupt-middle")
        (throw error)))))

(file_write path "\n")
(try
  (do (open-store path) (throw "WAL_CORRUPT_NOT_RAISED"))
  (catch [error]
    (if (str_ends_with (error_message error) "WAL_CORRUPT")
      (println "PASS silent-wal-blank-record")
      (throw error))))

(let [body {"op" "unknown"}
      encoded (json_str body)]
  (file_write path
    (str (json_str {"version" afj-wal-version
                    "length" (count encoded)
                    "checksum" (sha256 encoded)
                    "body" body}) "\n"))
  (try
    (do (open-store path) (throw "WAL_CORRUPT_NOT_RAISED"))
    (catch [error]
      (if (str_ends_with (error_message error) "WAL_CORRUPT")
        (println "PASS silent-wal-unknown-operation")
        (throw error)))))
