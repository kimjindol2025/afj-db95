;; AFJ-014 WAL replay must rebuild committed row-version history.
(load "/root/kilo-freelang/projects/afj-db95/src/tcp-server.fls")

(if (file_exists afj-tcp-wal) (file_delete afj-tcp-wal) nil)
(reset! engine-catalog {})
(reset! engine-indexes {})
(reset! engine-databases {})
(reset! afj-tcp-commit-revision 0)
(reset! afj-tcp-table-revisions {})
(reset! afj-tcp-schema-revisions {})
(reset! afj-tcp-row-versions {})

(afj-tcp-commit-ast
  {"type" "create-table" "table" "recovery_accounts"
   "schema" {"columns" [{"name" "id" "type" "INTEGER"
                            "nullable" false "primary" true}
                           {"name" "balance" "type" "INTEGER"
                            "nullable" false}]
              "primary-key" "id" "unique-columns" []}})
(afj-tcp-commit-ast
  {"type" "insert" "table" "recovery_accounts"
   "rows" [{"id" "1" "balance" "10"}]})
(afj-tcp-commit-ast
  {"type" "update" "table" "recovery_accounts"
   "where" {"column" "id" "equals" "1"}
   "changes" {"balance" "20"}})

(reset! engine-catalog {})
(reset! engine-indexes {})
(reset! engine-databases {})
(afj-tcp-recover)
(let [schema-revision (get (deref afj-tcp-schema-revisions) "recovery_accounts" 0)
      chain (get (get (deref afj-tcp-row-versions) "recovery_accounts") "1")
      rows (afj-tcp-versioned-rows "recovery_accounts" []
                                    (deref afj-tcp-commit-revision))]
  (if (and (>= (deref afj-tcp-commit-revision) 3)
           (= schema-revision 1)
           (>= (count chain) 2)
           (= (get (first rows) "balance") "20"))
    (println "afj-db95 TCP row-version WAL recovery PASS")
    (throw "TCP row-version WAL recovery failed")))
(file_delete afj-tcp-wal)
