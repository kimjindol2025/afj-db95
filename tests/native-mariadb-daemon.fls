;; Native FreeLang MariaDB packet listener harness.
(load "../src/engine.fls")
(load "../src/sql-core.fls")
(load "../src/mariadb-wire.fls")
(define native-mariadb-port (str-to-num (env-get "AFJ_NATIVE_MARIADB_PORT")))
(define native-mariadb-start
  (tcp-server-raw native-mariadb-port "mariadb-wire-handler" "127.0.0.1"))
(if (= native-mariadb-start "ok")
  (do
    (println "afj-db95 native MariaDB STARTED")
    ;; tcp-server-raw events are delivered only when the FreeLang scheduler
    ;; drains the runtime IO worker ring.
    (loop [tick 0]
      (if (< tick 6000)
        (do (fl-yield 10) (recur (+ tick 1)))
        (tcp-server-stop native-mariadb-port))))
  (throw native-mariadb-start))
