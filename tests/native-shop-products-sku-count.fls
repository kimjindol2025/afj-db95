;; Native product SKU COUNT fixture agreed in msg_14cb4604c6fb.
;; Both products use the original visible1 seeds; server COUNT bind SKU-1 must return one text1 row.
(load "../src/sha1.fls")
(define skucount-control (env-get "AFJ_NATIVE_SHOP_PRODUCTS_SKU_COUNT_CONTROL"))
(define skucount-connection (atom nil))
(define skucount-buffer (atom ""))
(define skucount-stage (atom "handshake"))
(define skucount-sequence (atom 0))
(define skucount-columns (atom []))
(define skucount-rows (atom []))
(define skucount-error (atom nil))
(define skucount-done (atom false))
(define skucount-statement (atom nil))

(defn skucount-check [condition message]
  (if (= condition true) true (throw message)))

(defn skucount-u32 [value]
  (buf-concat [(buf-u8 (rem value 256))
               (buf-u8 (rem (floor (/ value 256)) 256))
               (buf-u8 (rem (floor (/ value 65536)) 256))
               (buf-u8 (rem (floor (/ value 16777216)) 256))]))

(defn skucount-read-u32 [bytes offset]
  (+ (buf-read-u8 bytes offset)
     (* 256 (buf-read-u8 bytes (+ offset 1)))
     (* 65536 (buf-read-u8 bytes (+ offset 2)))
     (* 16777216 (buf-read-u8 bytes (+ offset 3)))))

(defn skucount-send [payload sequence next-stage response-sequence]
  (let [length (buf-len payload)
        frame (buf-concat [(buf-slice (skucount-u32 length) 0 3)
                           (buf-u8 sequence) payload])]
    (reset! skucount-stage next-stage)
    (reset! skucount-sequence response-sequence)
    (skucount-check (= (tcp-write (deref skucount-connection) (buf-to-binary frame)) "ok")
                 "NATIVE_SHOP_PRODUCTS_SKU_COUNT_PACKET_WRITE")))

(defn skucount-command [code text next-stage]
  (skucount-send (buf-concat [(buf-u8 code) (buf-str text)])
              0 next-stage 1))

(defn skucount-text [bytes offset]
  (skucount-check (< offset (buf-len bytes)) "NATIVE_SHOP_PRODUCTS_SKU_COUNT_TEXT_PREFIX")
  (let [length (buf-read-u8 bytes offset) next (+ offset 1 length)]
    (skucount-check (and (< length 251) (<= next (buf-len bytes)))
                 "NATIVE_SHOP_PRODUCTS_SKU_COUNT_TEXT_LENGTH")
    {"value" (buf-read-str bytes (+ offset 1) length)
     "next" next}))

(defn skucount-column-name [bytes]
  (loop [index 0 offset 0]
    (let [field (skucount-text bytes offset)]
      (if (= index 4) (get field "value")
        (recur (+ index 1) (get field "next"))))))

(defn skucount-login [bytes]
  (skucount-check (= (buf-read-u8 bytes 0) 10) "NATIVE_SHOP_PRODUCTS_SKU_COUNT_HANDSHAKE_VERSION")
  (let [version-end
          (loop [offset 1]
            (do
              (skucount-check (< offset (buf-len bytes)) "NATIVE_SHOP_PRODUCTS_SKU_COUNT_HANDSHAKE_LENGTH")
              (if (= (buf-read-u8 bytes offset) 0) offset (recur (+ offset 1)))))
        first-offset (+ version-end 5)
        second-offset (+ first-offset 27)]
    (skucount-check (<= (+ second-offset 12) (buf-len bytes))
                 "NATIVE_SHOP_PRODUCTS_SKU_COUNT_SCRAMBLE_LENGTH")
    (let [scramble (buf-concat [(buf-slice bytes first-offset 8)
                                (buf-slice bytes second-offset 12)])
          token (sha1-mysql-native-token "development-only" scramble)
          login (buf-concat [(skucount-u32 172545) (skucount-u32 1048576)
                             (buf-u8 33) (sha1-zero-bytes 23)
                             (buf-str "root") (buf-u8 0)
                             (buf-u8 20) token])]
      (skucount-check (= (buf-len token) 20) "NATIVE_SHOP_PRODUCTS_SKU_COUNT_TOKEN_LENGTH")
      (skucount-send login 1 "login" 2))))

(defn skucount-frame [bytes sequence]
  (skucount-check (> (buf-len bytes) 0) "NATIVE_SHOP_PRODUCTS_SKU_COUNT_EMPTY_PACKET")
  (skucount-check (= sequence (deref skucount-sequence)) "NATIVE_SHOP_PRODUCTS_SKU_COUNT_PACKET_SEQUENCE")
  (swap! skucount-sequence + 1)
  (let [stage (deref skucount-stage) first-byte (buf-read-u8 bytes 0)]
    (if (= first-byte 255)
      (if (>= (buf-len bytes) 9)
        (throw (str "NATIVE_SHOP_PRODUCTS_SKU_COUNT_SERVER_ERROR_" stage " code="
                    (+ (buf-read-u8 bytes 1) (* 256 (buf-read-u8 bytes 2)))
                    " message=" (buf-read-str bytes 9 (- (buf-len bytes) 9))))
        (throw (str "NATIVE_SHOP_PRODUCTS_SKU_COUNT_SHORT_SERVER_ERROR_" stage)))
      nil)
    (cond
      (= stage "handshake") (skucount-login bytes)
      (= stage "login")
        (do
          (skucount-check (= first-byte 0) "NATIVE_SHOP_PRODUCTS_SKU_COUNT_LOGIN_ACK")
          (skucount-command 3 "CREATE TABLE shop_products (id INT PRIMARY KEY, sku TEXT, name TEXT, price INT, visible INT)"
                           "create"))
      (= stage "create")
        (do
          (skucount-check (= first-byte 0) "NATIVE_SHOP_PRODUCTS_SKU_COUNT_CREATE_ACK")
          (skucount-command 3 "INSERT INTO shop_products (id, sku, name, price, visible) VALUES (1, 'SKU-1', 'Demo Widget', 1500, 1)"
                           "seed"))
      (= stage "seed")
        (do
          (skucount-check (= first-byte 0) "NATIVE_SHOP_PRODUCTS_SKU_COUNT_FIRST_SEED_ACK")
          (skucount-command 3 "INSERT INTO shop_products (id, sku, name, price, visible) VALUES (2, 'SKU-2', 'Demo Gadget', 2200, 1)"
                            "second-seed"))
      (= stage "second-seed")
        (do
          (skucount-check (= first-byte 0) "NATIVE_SHOP_PRODUCTS_SKU_COUNT_SECOND_PRODUCT_SEED_ACK")
          (skucount-command 3 "CREATE TABLE shop_cart (id INT PRIMARY KEY, user_id INT, product_id INT, qty INT)" "cart-create"))
      (= stage "cart-create")
        (do
          (skucount-check (= first-byte 0) "NATIVE_SHOP_PRODUCTS_SKU_COUNT_CART_CREATE_ACK")
          (skucount-command 3 "INSERT INTO shop_cart (id, user_id, product_id, qty) VALUES (2, 20, 2, 1)" "second-cart-seed"))
      (= stage "second-cart-seed")
        (do
          (skucount-check (= first-byte 0) "NATIVE_SHOP_PRODUCTS_SKU_COUNT_SINGLE_CART_SEED_ACK")
          (skucount-command 22 "SELECT COUNT(*) FROM shop_products WHERE sku=?" "prepare"))
      (= stage "prepare")
        (do
          (skucount-check (and (= first-byte 0) (>= (buf-len bytes) 12))
                       "NATIVE_SHOP_PRODUCTS_SKU_COUNT_PREPARE_ACK")
          (skucount-check (and (= (buf-read-u8 bytes 7) 1)
                            (= (buf-read-u8 bytes 8) 0))
                       "NATIVE_SHOP_PRODUCTS_SKU_COUNT_PREPARE_ONE_PARAMETER")
          (reset! skucount-statement (skucount-read-u32 bytes 1))
          (let [execute (buf-concat [(buf-u8 23) (skucount-u32 (deref skucount-statement))
                                     (buf-u8 0) (skucount-u32 1)
                                     (buf-u8 0) (buf-u8 1) (buf-u8 253) (buf-u8 0)
                                     (buf-u8 5) (buf-str "SKU-1")])]
            (skucount-send execute 0 "select" 1)))
      (= stage "select")
        (do
          (skucount-check (and (= first-byte 1) (= (buf-len bytes) 1))
                       "NATIVE_SHOP_PRODUCTS_SKU_COUNT_SELECT_ONE_COLUMN")
          (reset! skucount-stage "columns"))
      (= stage "columns")
        (do
          (swap! skucount-columns conj (skucount-column-name bytes))
          (if (= (count (deref skucount-columns)) 1)
            (reset! skucount-stage "columns-end") nil))
      (= stage "columns-end")
        (do
          (skucount-check (and (= first-byte 254) (= (buf-len bytes) 5))
                       "NATIVE_SHOP_PRODUCTS_SKU_COUNT_COLUMN_EOF")
          (skucount-check (> (count (get (deref skucount-columns) 0)) 0)
                         "NATIVE_SHOP_PRODUCTS_SKU_COUNT_EXPRESSION_COLUMN")
          (reset! skucount-stage "rows"))
      (= stage "rows")
        (if (and (= first-byte 254) (= (buf-len bytes) 5))
          (do
            (skucount-check (= (count (deref skucount-rows)) 1)
                           "NATIVE_SHOP_PRODUCTS_SKU_COUNT_EXACTLY_ONE_ROW")
            (skucount-check (= (get (deref skucount-rows) 0) "1")
                           "NATIVE_SHOP_PRODUCTS_SKU_COUNT_EXACT_SERVER_TOTAL")
            (reset! skucount-stage "done")
            (reset! skucount-done true))
          (do
            (skucount-check (< (count (deref skucount-rows)) 1)
                           "NATIVE_SHOP_PRODUCTS_SKU_COUNT_EXTRA_ROW")
            (let [field (skucount-text bytes 0)]
              (skucount-check (= (get field "next") (buf-len bytes))
                             "NATIVE_SHOP_PRODUCTS_SKU_COUNT_ROW_TRAILING_BYTES")
              (swap! skucount-rows conj (get field "value")))))
      :else (throw "NATIVE_SHOP_PRODUCTS_SKU_COUNT_UNEXPECTED_STAGE"))))

(defn skucount-drain []
  (if (>= (buf-len (deref skucount-buffer)) 4)
    (let [bytes (deref skucount-buffer)
          length (+ (buf-read-u8 bytes 0) (* 256 (buf-read-u8 bytes 1))
                     (* 65536 (buf-read-u8 bytes 2)))]
      (skucount-check (<= length 65536) "NATIVE_SHOP_PRODUCTS_SKU_COUNT_PACKET_LIMIT")
      (if (>= (buf-len bytes) (+ 4 length))
        (do
          (reset! skucount-buffer (buf-slice bytes (+ 4 length)
                                         (- (buf-len bytes) (+ 4 length))))
          (skucount-frame (buf-slice bytes 4 length) (buf-read-u8 bytes 3))
          (skucount-drain))
        nil))
    nil))

(defn native-shop-products-sku-count-handler [event connection payload peer]
  (try
    (cond
      (or (= event "connect") (= event "accept"))
        (do (skucount-check (nil? (deref skucount-connection)) "NATIVE_SHOP_PRODUCTS_SKU_COUNT_SINGLE_CONNECTION")
            (reset! skucount-connection connection))
      (= event "data")
        (do (reset! skucount-buffer
              (buf-concat [(deref skucount-buffer) (buf-from-binary payload)]))
            (skucount-drain))
      (= event "close")
        (skucount-check (deref skucount-done) "NATIVE_SHOP_PRODUCTS_SKU_COUNT_PREMATURE_CLOSE")
      :else nil)
    (catch [error]
      (reset! skucount-error (error_message error))
      (reset! skucount-done true))))

(skucount-check (not (nil? skucount-control)) "NATIVE_SHOP_PRODUCTS_SKU_COUNT_HOST_ENV_REQUIRED")
(skucount-check (not (file_exists (str skucount-control "/ports.ready")))
             "NATIVE_SHOP_PRODUCTS_SKU_COUNT_CONTROL_NOT_FRESH")
(let [bridge-port (tcp-client-free-port) daemon-port (tcp-client-free-port)]
  (skucount-check (and (number? bridge-port) (number? daemon-port)
                    (not (= bridge-port daemon-port))) "NATIVE_SHOP_PRODUCTS_SKU_COUNT_DISTINCT_PORTS")
  (skucount-check (= (tcp-server-raw bridge-port "native-shop-products-sku-count-handler" "127.0.0.1") "ok")
               "NATIVE_SHOP_PRODUCTS_SKU_COUNT_LISTENER_START")
  (try
    (do
      (file_write (str skucount-control "/ports.json")
                  (json_str {"bridge" bridge-port "daemon" daemon-port}))
      (file_write (str skucount-control "/ports.ready") "ready")
      (let [deadline (+ (now-ms) 30000)]
        (while (and (< (now-ms) deadline) (not (deref skucount-done))) (fl-yield 10)))
      (skucount-check (deref skucount-done) "NATIVE_SHOP_PRODUCTS_SKU_COUNT_CONTRACT_TIMEOUT")
      (if (nil? (deref skucount-error)) nil (throw (deref skucount-error)))
      (skucount-check (= (deref skucount-stage) "done") "NATIVE_SHOP_PRODUCTS_SKU_COUNT_CONTRACT_INCOMPLETE")
      (skucount-check (= (buf-len (deref skucount-buffer)) 0) "NATIVE_SHOP_PRODUCTS_SKU_COUNT_TRAILING_PACKET_BYTES"))
    (finally (tcp-server-stop bridge-port))))
(println (str "NATIVE_SHOP_PRODUCTS_SKU_COUNT_RESULT "
  (json_str {"ok" true "prepared_parameters" 1
             "query" "SELECT COUNT(*) FROM shop_products WHERE sku=?"
             "bind" ["SKU-1"] "select_executions" 1 "rows" 1
             "columns" (deref skucount-columns) "data" (deref skucount-rows)
             "exact_count" true "client_computes_count" false})))
(println "afj-db95 Native shop product SKU COUNT prepared SELECT PASS")
