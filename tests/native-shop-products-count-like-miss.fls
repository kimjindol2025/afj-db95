;; Native product name LIKE COUNT fixture agreed in msg_e8e07f56a55f.
;; Both original products remain seeded; server COUNT bind %NoSuch% must return one text0 row.
(load "../src/sha1.fls")
(define countlikemiss-control (env-get "AFJ_NATIVE_SHOP_PRODUCTS_COUNT_LIKE_MISS_CONTROL"))
(define countlikemiss-connection (atom nil))
(define countlikemiss-buffer (atom ""))
(define countlikemiss-stage (atom "handshake"))
(define countlikemiss-sequence (atom 0))
(define countlikemiss-columns (atom []))
(define countlikemiss-rows (atom []))
(define countlikemiss-error (atom nil))
(define countlikemiss-done (atom false))
(define countlikemiss-statement (atom nil))

(defn countlikemiss-check [condition message]
  (if (= condition true) true (throw message)))

(defn countlikemiss-u32 [value]
  (buf-concat [(buf-u8 (rem value 256))
               (buf-u8 (rem (floor (/ value 256)) 256))
               (buf-u8 (rem (floor (/ value 65536)) 256))
               (buf-u8 (rem (floor (/ value 16777216)) 256))]))

(defn countlikemiss-read-u32 [bytes offset]
  (+ (buf-read-u8 bytes offset)
     (* 256 (buf-read-u8 bytes (+ offset 1)))
     (* 65536 (buf-read-u8 bytes (+ offset 2)))
     (* 16777216 (buf-read-u8 bytes (+ offset 3)))))

(defn countlikemiss-send [payload sequence next-stage response-sequence]
  (let [length (buf-len payload)
        frame (buf-concat [(buf-slice (countlikemiss-u32 length) 0 3)
                           (buf-u8 sequence) payload])]
    (reset! countlikemiss-stage next-stage)
    (reset! countlikemiss-sequence response-sequence)
    (countlikemiss-check (= (tcp-write (deref countlikemiss-connection) (buf-to-binary frame)) "ok")
                 "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_MISS_PACKET_WRITE")))

(defn countlikemiss-command [code text next-stage]
  (countlikemiss-send (buf-concat [(buf-u8 code) (buf-str text)])
              0 next-stage 1))

(defn countlikemiss-text [bytes offset]
  (countlikemiss-check (< offset (buf-len bytes)) "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_MISS_TEXT_PREFIX")
  (let [length (buf-read-u8 bytes offset) next (+ offset 1 length)]
    (countlikemiss-check (and (< length 251) (<= next (buf-len bytes)))
                 "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_MISS_TEXT_LENGTH")
    {"value" (buf-read-str bytes (+ offset 1) length)
     "next" next}))

(defn countlikemiss-column-name [bytes]
  (loop [index 0 offset 0]
    (let [field (countlikemiss-text bytes offset)]
      (if (= index 4) (get field "value")
        (recur (+ index 1) (get field "next"))))))

(defn countlikemiss-login [bytes]
  (countlikemiss-check (= (buf-read-u8 bytes 0) 10) "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_MISS_HANDSHAKE_VERSION")
  (let [version-end
          (loop [offset 1]
            (do
              (countlikemiss-check (< offset (buf-len bytes)) "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_MISS_HANDSHAKE_LENGTH")
              (if (= (buf-read-u8 bytes offset) 0) offset (recur (+ offset 1)))))
        first-offset (+ version-end 5)
        second-offset (+ first-offset 27)]
    (countlikemiss-check (<= (+ second-offset 12) (buf-len bytes))
                 "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_MISS_SCRAMBLE_LENGTH")
    (let [scramble (buf-concat [(buf-slice bytes first-offset 8)
                                (buf-slice bytes second-offset 12)])
          token (sha1-mysql-native-token "development-only" scramble)
          login (buf-concat [(countlikemiss-u32 172545) (countlikemiss-u32 1048576)
                             (buf-u8 33) (sha1-zero-bytes 23)
                             (buf-str "root") (buf-u8 0)
                             (buf-u8 20) token])]
      (countlikemiss-check (= (buf-len token) 20) "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_MISS_TOKEN_LENGTH")
      (countlikemiss-send login 1 "login" 2))))

(defn countlikemiss-frame [bytes sequence]
  (countlikemiss-check (> (buf-len bytes) 0) "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_MISS_EMPTY_PACKET")
  (countlikemiss-check (= sequence (deref countlikemiss-sequence)) "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_MISS_PACKET_SEQUENCE")
  (swap! countlikemiss-sequence + 1)
  (let [stage (deref countlikemiss-stage) first-byte (buf-read-u8 bytes 0)]
    (if (= first-byte 255)
      (if (>= (buf-len bytes) 9)
        (throw (str "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_MISS_SERVER_ERROR_" stage " code="
                    (+ (buf-read-u8 bytes 1) (* 256 (buf-read-u8 bytes 2)))
                    " message=" (buf-read-str bytes 9 (- (buf-len bytes) 9))))
        (throw (str "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_MISS_SHORT_SERVER_ERROR_" stage)))
      nil)
    (cond
      (= stage "handshake") (countlikemiss-login bytes)
      (= stage "login")
        (do
          (countlikemiss-check (= first-byte 0) "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_MISS_LOGIN_ACK")
          (countlikemiss-command 3 "CREATE TABLE shop_products (id INT PRIMARY KEY, sku TEXT, name TEXT, price INT, visible INT)"
                           "create"))
      (= stage "create")
        (do
          (countlikemiss-check (= first-byte 0) "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_MISS_CREATE_ACK")
          (countlikemiss-command 3 "INSERT INTO shop_products (id, sku, name, price, visible) VALUES (1, 'SKU-1', 'Demo Widget', 1500, 1)"
                           "seed"))
      (= stage "seed")
        (do
          (countlikemiss-check (= first-byte 0) "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_MISS_FIRST_SEED_ACK")
          (countlikemiss-command 3 "INSERT INTO shop_products (id, sku, name, price, visible) VALUES (2, 'SKU-2', 'Demo Gadget', 2200, 1)"
                            "second-seed"))
      (= stage "second-seed")
        (do
          (countlikemiss-check (= first-byte 0) "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_MISS_SECOND_PRODUCT_SEED_ACK")
          (countlikemiss-command 3 "CREATE TABLE shop_cart (id INT PRIMARY KEY, user_id INT, product_id INT, qty INT)" "cart-create"))
      (= stage "cart-create")
        (do
          (countlikemiss-check (= first-byte 0) "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_MISS_CART_CREATE_ACK")
          (countlikemiss-command 3 "INSERT INTO shop_cart (id, user_id, product_id, qty) VALUES (2, 20, 2, 1)" "second-cart-seed"))
      (= stage "second-cart-seed")
        (do
          (countlikemiss-check (= first-byte 0) "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_MISS_SINGLE_CART_SEED_ACK")
          (countlikemiss-command 22 "SELECT COUNT(*) FROM shop_products WHERE name LIKE ?" "prepare"))
      (= stage "prepare")
        (do
          (countlikemiss-check (and (= first-byte 0) (>= (buf-len bytes) 12))
                       "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_MISS_PREPARE_ACK")
          (countlikemiss-check (and (= (buf-read-u8 bytes 7) 1)
                            (= (buf-read-u8 bytes 8) 0))
                       "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_MISS_PREPARE_ONE_PARAMETER")
          (reset! countlikemiss-statement (countlikemiss-read-u32 bytes 1))
          (let [execute (buf-concat [(buf-u8 23) (countlikemiss-u32 (deref countlikemiss-statement))
                                     (buf-u8 0) (countlikemiss-u32 1)
                                     (buf-u8 0) (buf-u8 1) (buf-u8 253) (buf-u8 0)
                                     (buf-u8 8) (buf-str "%NoSuch%")])]
            (countlikemiss-send execute 0 "select" 1)))
      (= stage "select")
        (do
          (countlikemiss-check (and (= first-byte 1) (= (buf-len bytes) 1))
                       "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_MISS_SELECT_ONE_COLUMN")
          (reset! countlikemiss-stage "columns"))
      (= stage "columns")
        (do
          (swap! countlikemiss-columns conj (countlikemiss-column-name bytes))
          (if (= (count (deref countlikemiss-columns)) 1)
            (reset! countlikemiss-stage "columns-end") nil))
      (= stage "columns-end")
        (do
          (countlikemiss-check (and (= first-byte 254) (= (buf-len bytes) 5))
                       "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_MISS_COLUMN_EOF")
          (countlikemiss-check (> (count (get (deref countlikemiss-columns) 0)) 0)
                         "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_MISS_EXPRESSION_COLUMN")
          (reset! countlikemiss-stage "rows"))
      (= stage "rows")
        (if (and (= first-byte 254) (= (buf-len bytes) 5))
          (do
            (countlikemiss-check (= (count (deref countlikemiss-rows)) 1)
                           "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_MISS_EXACTLY_ONE_ROW")
            (countlikemiss-check (= (get (deref countlikemiss-rows) 0) "0")
                           "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_MISS_COUNT_ZERO")
            (reset! countlikemiss-stage "done")
            (reset! countlikemiss-done true))
          (do
            (countlikemiss-check (< (count (deref countlikemiss-rows)) 1)
                           "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_MISS_EXTRA_ROW")
            (let [field (countlikemiss-text bytes 0)]
              (countlikemiss-check (= (get field "next") (buf-len bytes))
                             "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_MISS_ROW_TRAILING_BYTES")
              (swap! countlikemiss-rows conj (get field "value")))))
      :else (throw "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_MISS_UNEXPECTED_STAGE"))))

(defn countlikemiss-drain []
  (if (>= (buf-len (deref countlikemiss-buffer)) 4)
    (let [bytes (deref countlikemiss-buffer)
          length (+ (buf-read-u8 bytes 0) (* 256 (buf-read-u8 bytes 1))
                     (* 65536 (buf-read-u8 bytes 2)))]
      (countlikemiss-check (<= length 65536) "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_MISS_PACKET_LIMIT")
      (if (>= (buf-len bytes) (+ 4 length))
        (do
          (reset! countlikemiss-buffer (buf-slice bytes (+ 4 length)
                                         (- (buf-len bytes) (+ 4 length))))
          (countlikemiss-frame (buf-slice bytes 4 length) (buf-read-u8 bytes 3))
          (countlikemiss-drain))
        nil))
    nil))

(defn native-shop-products-name-like-count-handler [event connection payload peer]
  (try
    (cond
      (or (= event "connect") (= event "accept"))
        (do (countlikemiss-check (nil? (deref countlikemiss-connection)) "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_MISS_SINGLE_CONNECTION")
            (reset! countlikemiss-connection connection))
      (= event "data")
        (do (reset! countlikemiss-buffer
              (buf-concat [(deref countlikemiss-buffer) (buf-from-binary payload)]))
            (countlikemiss-drain))
      (= event "close")
        (countlikemiss-check (deref countlikemiss-done) "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_MISS_PREMATURE_CLOSE")
      :else nil)
    (catch [error]
      (reset! countlikemiss-error (error_message error))
      (reset! countlikemiss-done true))))

(countlikemiss-check (not (nil? countlikemiss-control)) "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_MISS_HOST_ENV_REQUIRED")
(countlikemiss-check (not (file_exists (str countlikemiss-control "/ports.ready")))
             "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_MISS_CONTROL_NOT_FRESH")
(let [bridge-port (tcp-client-free-port) daemon-port (tcp-client-free-port)]
  (countlikemiss-check (and (number? bridge-port) (number? daemon-port)
                    (not (= bridge-port daemon-port))) "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_MISS_DISTINCT_PORTS")
  (countlikemiss-check (= (tcp-server-raw bridge-port "native-shop-products-name-like-count-handler" "127.0.0.1") "ok")
               "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_MISS_LISTENER_START")
  (try
    (do
      (file_write (str countlikemiss-control "/ports.json")
                  (json_str {"bridge" bridge-port "daemon" daemon-port}))
      (file_write (str countlikemiss-control "/ports.ready") "ready")
      (let [deadline (+ (now-ms) 30000)]
        (while (and (< (now-ms) deadline) (not (deref countlikemiss-done))) (fl-yield 10)))
      (countlikemiss-check (deref countlikemiss-done) "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_MISS_CONTRACT_TIMEOUT")
      (if (nil? (deref countlikemiss-error)) nil (throw (deref countlikemiss-error)))
      (countlikemiss-check (= (deref countlikemiss-stage) "done") "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_MISS_CONTRACT_INCOMPLETE")
      (countlikemiss-check (= (buf-len (deref countlikemiss-buffer)) 0) "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_MISS_TRAILING_PACKET_BYTES"))
    (finally (tcp-server-stop bridge-port))))
(println (str "NATIVE_SHOP_PRODUCTS_COUNT_LIKE_MISS_RESULT "
  (json_str {"ok" true "prepared_parameters" 1
             "query" "SELECT COUNT(*) FROM shop_products WHERE name LIKE ?"
             "bind" ["%NoSuch%"] "select_executions" 1 "rows" 1
             "columns" (deref countlikemiss-columns) "data" (deref countlikemiss-rows)
             "exact_count" true "client_computes_count" false})))
(println "afj-db95 Native shop COUNT LIKE miss prepared SELECT PASS")
