(load "/root/kilo-freelang/projects/afj-db95/src/tcp-server.fls")

(if (and (afj-tcp-rate-allowed? "conn-test")
         (afj-tcp-rate-allowed? "conn-test")
         (not (afj-tcp-rate-allowed? "conn-test"))
         (afj-tcp-rate-allowed? "other-connection"))
