;; Run write and read modes in separate OS processes with the same storage paths.
(load "../src/tcp-server.fls")
(defn verify-stored-checkpoint []
  (let [manifest (afj-tcp-read-page-set-value afj-tcp-catalog-page-path)
        page (afj-tcp-read-page-set-value (afj-tcp-table-page-path "independent_versions"))
        chain (get (get page "row-version-history") "1")
        wal (file_read afj-tcp-wal)]
    (if (and (= (get manifest "commit-revision") 3)
             (= (get manifest "wal-size") (count wal))
             (= (get manifest "wal-prefix") (sha256 wal))
             (= (count chain) 2)
             (= (get (get (first chain) "row") "value") "10")
             (= (get (get (last chain) "row") "value") "20"))
      true
      (throw "stored checkpoint history mismatch"))))
(defn verify-history []
  (let [chain (get (get (deref afj-tcp-row-versions) "independent_versions") "1")
        old (afj-tcp-versioned-rows "independent_versions" [] 2)
        current (afj-tcp-versioned-rows "independent_versions" [] 3)]
    (if (and (= (deref afj-tcp-commit-revision) 3)
             (= (get (deref afj-tcp-schema-revisions) "independent_versions") 1)
             (= (count chain) 2)
             (= (get (first chain) "created") 2)
             (= (get (first chain) "deleted") 3)
             (= (get (last chain) "created") 3)
             (nil? (get (last chain) "deleted"))
             (= (count old) 1) (= (get (first old) "value") "10")
             (= (count current) 1) (= (get (first current) "value") "20"))
      true
      (throw "independent checkpoint history mismatch"))))
(if (= (env_get "DB95_191_MODE") "read")
  (do
    (verify-stored-checkpoint)
    (afj-tcp-recover)
    (verify-history)
    (println "CHECKPOINT_FRESH_PROCESS_RECOVERY_PASS old=10 current=20 chain=2"))
  (do
    (reset! engine-catalog {})
    (reset! engine-indexes {})
    (reset! engine-databases {})
    (reset! afj-tcp-commit-revision 0)
    (reset! afj-tcp-table-revisions {})
    (reset! afj-tcp-schema-revisions {})
    (reset! afj-tcp-row-versions {})
    (afj-tcp-commit-ast
      {"type" "create-table" "table" "independent_versions"
       "schema" {"columns" [{"name" "id" "type" "INTEGER" "nullable" false "primary" true}
                             {"name" "value" "type" "INTEGER" "nullable" false}]
                 "primary-key" "id" "unique-columns" []}})
    (afj-tcp-commit-ast
      {"type" "insert" "table" "independent_versions" "row" {"id" "1" "value" "10"}})
    (afj-tcp-commit-ast
      {"type" "update" "table" "independent_versions"
       "where" {"column" "id" "equals" "1"} "changes" {"value" "20"}})
    (verify-history)
    (if (file_exists afj-tcp-catalog-page-path) nil (throw "checkpoint missing"))
    (verify-stored-checkpoint)
    (println "CHECKPOINT_WRITE_PASS old=10 current=20 chain=2")))
