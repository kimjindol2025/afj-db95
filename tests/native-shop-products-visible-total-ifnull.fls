;; Native visible product IFNULL SUM fixture agreed in msg_329080d295d9.
;; Product visible1 and visible0 are seeded; bind1 must return server total1500.
(load "../src/sha1.fls")
(define producttotal-control (env-get "AFJ_NATIVE_SHOP_PRODUCTS_VISIBLE_TOTAL_IFNULL_CONTROL"))
(define producttotal-connection (atom nil))
(define producttotal-buffer (atom ""))
(define producttotal-stage (atom "handshake"))
(define producttotal-sequence (atom 0))
(define producttotal-columns (atom []))
(define producttotal-rows (atom []))
(define producttotal-error (atom nil))
(define producttotal-done (atom false))
(define producttotal-statement (atom nil))

(defn producttotal-check [condition message]
  (if (= condition true) true (throw message)))

(defn producttotal-u32 [value]
  (buf-concat [(buf-u8 (rem value 256))
               (buf-u8 (rem (floor (/ value 256)) 256))
               (buf-u8 (rem (floor (/ value 65536)) 256))
               (buf-u8 (rem (floor (/ value 16777216)) 256))]))

(defn producttotal-read-u32 [bytes offset]
  (+ (buf-read-u8 bytes offset)
     (* 256 (buf-read-u8 bytes (+ offset 1)))
     (* 65536 (buf-read-u8 bytes (+ offset 2)))
     (* 16777216 (buf-read-u8 bytes (+ offset 3)))))

(defn producttotal-send [payload sequence next-stage response-sequence]
  (let [length (buf-len payload)
        frame (buf-concat [(buf-slice (producttotal-u32 length) 0 3)
                           (buf-u8 sequence) payload])]
    (reset! producttotal-stage next-stage)
    (reset! producttotal-sequence response-sequence)
    (producttotal-check (= (tcp-write (deref producttotal-connection) (buf-to-binary frame)) "ok")
                 "NATIVE_SHOP_PRODUCTS_VISIBLE_TOTAL_IFNULL_PACKET_WRITE")))

(defn producttotal-command [code text next-stage]
  (producttotal-send (buf-concat [(buf-u8 code) (buf-str text)])
              0 next-stage 1))

(defn producttotal-text [bytes offset]
  (producttotal-check (< offset (buf-len bytes)) "NATIVE_SHOP_PRODUCTS_VISIBLE_TOTAL_IFNULL_TEXT_PREFIX")
  (let [length (buf-read-u8 bytes offset) next (+ offset 1 length)]
    (producttotal-check (and (< length 251) (<= next (buf-len bytes)))
                 "NATIVE_SHOP_PRODUCTS_VISIBLE_TOTAL_IFNULL_TEXT_LENGTH")
    {"value" (buf-read-str bytes (+ offset 1) length)
     "next" next}))

(defn producttotal-column-name [bytes]
  (loop [index 0 offset 0]
    (let [field (producttotal-text bytes offset)]
      (if (= index 4) (get field "value")
        (recur (+ index 1) (get field "next"))))))

(defn producttotal-login [bytes]
  (producttotal-check (= (buf-read-u8 bytes 0) 10) "NATIVE_SHOP_PRODUCTS_VISIBLE_TOTAL_IFNULL_HANDSHAKE_VERSION")
  (let [version-end
          (loop [offset 1]
            (do
              (producttotal-check (< offset (buf-len bytes)) "NATIVE_SHOP_PRODUCTS_VISIBLE_TOTAL_IFNULL_HANDSHAKE_LENGTH")
              (if (= (buf-read-u8 bytes offset) 0) offset (recur (+ offset 1)))))
        first-offset (+ version-end 5)
        second-offset (+ first-offset 27)]
    (producttotal-check (<= (+ second-offset 12) (buf-len bytes))
                 "NATIVE_SHOP_PRODUCTS_VISIBLE_TOTAL_IFNULL_SCRAMBLE_LENGTH")
    (let [scramble (buf-concat [(buf-slice bytes first-offset 8)
                                (buf-slice bytes second-offset 12)])
          token (sha1-mysql-native-token "development-only" scramble)
          login (buf-concat [(producttotal-u32 172545) (producttotal-u32 1048576)
                             (buf-u8 33) (sha1-zero-bytes 23)
                             (buf-str "root") (buf-u8 0)
                             (buf-u8 20) token])]
      (producttotal-check (= (buf-len token) 20) "NATIVE_SHOP_PRODUCTS_VISIBLE_TOTAL_IFNULL_TOKEN_LENGTH")
      (producttotal-send login 1 "login" 2))))

(defn producttotal-frame [bytes sequence]
  (producttotal-check (> (buf-len bytes) 0) "NATIVE_SHOP_PRODUCTS_VISIBLE_TOTAL_IFNULL_EMPTY_PACKET")
  (producttotal-check (= sequence (deref producttotal-sequence)) "NATIVE_SHOP_PRODUCTS_VISIBLE_TOTAL_IFNULL_PACKET_SEQUENCE")
  (swap! producttotal-sequence + 1)
  (let [stage (deref producttotal-stage) first-byte (buf-read-u8 bytes 0)]
    (if (= first-byte 255)
      (if (>= (buf-len bytes) 9)
        (throw (str "NATIVE_SHOP_PRODUCTS_VISIBLE_TOTAL_IFNULL_SERVER_ERROR_" stage " code="
                    (+ (buf-read-u8 bytes 1) (* 256 (buf-read-u8 bytes 2)))
                    " message=" (buf-read-str bytes 9 (- (buf-len bytes) 9))))
        (throw (str "NATIVE_SHOP_PRODUCTS_VISIBLE_TOTAL_IFNULL_SHORT_SERVER_ERROR_" stage)))
      nil)
    (cond
      (= stage "handshake") (producttotal-login bytes)
      (= stage "login")
        (do
          (producttotal-check (= first-byte 0) "NATIVE_SHOP_PRODUCTS_VISIBLE_TOTAL_IFNULL_LOGIN_ACK")
          (producttotal-command 3 "CREATE TABLE shop_products (id INT PRIMARY KEY, sku TEXT, name TEXT, price INT, visible INT)"
                           "create"))
      (= stage "create")
        (do
          (producttotal-check (= first-byte 0) "NATIVE_SHOP_PRODUCTS_VISIBLE_TOTAL_IFNULL_CREATE_ACK")
          (producttotal-command 3 "INSERT INTO shop_products (id, sku, name, price, visible) VALUES (1, 'SKU-1', 'Demo Widget', 1500, 1)"
                           "seed"))
      (= stage "seed")
        (do
          (producttotal-check (= first-byte 0) "NATIVE_SHOP_PRODUCTS_VISIBLE_TOTAL_IFNULL_FIRST_SEED_ACK")
          (producttotal-command 3 "INSERT INTO shop_products (id, sku, name, price, visible) VALUES (2, 'SKU-2', 'Demo Gadget', 2200, 0)"
                            "second-seed"))
      (= stage "second-seed")
        (do
          (producttotal-check (= first-byte 0) "NATIVE_SHOP_PRODUCTS_VISIBLE_TOTAL_IFNULL_SECOND_PRODUCT_SEED_ACK")
          (producttotal-command 3 "CREATE TABLE shop_cart (id INT PRIMARY KEY, user_id INT, product_id INT, qty INT)" "cart-create"))
      (= stage "cart-create")
        (do
          (producttotal-check (= first-byte 0) "NATIVE_SHOP_PRODUCTS_VISIBLE_TOTAL_IFNULL_CART_CREATE_ACK")
          (producttotal-command 3 "INSERT INTO shop_cart (id, user_id, product_id, qty) VALUES (2, 20, 2, 1)" "second-cart-seed"))
      (= stage "second-cart-seed")
        (do
          (producttotal-check (= first-byte 0) "NATIVE_SHOP_PRODUCTS_VISIBLE_TOTAL_IFNULL_SINGLE_CART_SEED_ACK")
          (producttotal-command 22 "SELECT IFNULL(SUM(price), 0) FROM shop_products WHERE visible=?" "prepare"))
      (= stage "prepare")
        (do
          (producttotal-check (and (= first-byte 0) (>= (buf-len bytes) 12))
                       "NATIVE_SHOP_PRODUCTS_VISIBLE_TOTAL_IFNULL_PREPARE_ACK")
          (producttotal-check (and (= (buf-read-u8 bytes 7) 1)
                            (= (buf-read-u8 bytes 8) 0))
                       "NATIVE_SHOP_PRODUCTS_VISIBLE_TOTAL_IFNULL_PREPARE_ONE_PARAMETER")
          (reset! producttotal-statement (producttotal-read-u32 bytes 1))
          (let [execute (buf-concat [(buf-u8 23) (producttotal-u32 (deref producttotal-statement))
                                     (buf-u8 0) (producttotal-u32 1)
                                     (buf-u8 0) (buf-u8 1) (buf-u8 3) (buf-u8 0)
                                     (producttotal-u32 1)])]
            (producttotal-send execute 0 "select" 1)))
      (= stage "select")
        (do
          (producttotal-check (and (= first-byte 1) (= (buf-len bytes) 1))
                       "NATIVE_SHOP_PRODUCTS_VISIBLE_TOTAL_IFNULL_SELECT_ONE_COLUMN")
          (reset! producttotal-stage "columns"))
      (= stage "columns")
        (do
          (swap! producttotal-columns conj (producttotal-column-name bytes))
          (if (= (count (deref producttotal-columns)) 1)
            (reset! producttotal-stage "columns-end") nil))
      (= stage "columns-end")
        (do
          (producttotal-check (and (= first-byte 254) (= (buf-len bytes) 5))
                       "NATIVE_SHOP_PRODUCTS_VISIBLE_TOTAL_IFNULL_COLUMN_EOF")
          (producttotal-check (> (count (get (deref producttotal-columns) 0)) 0)
                         "NATIVE_SHOP_PRODUCTS_VISIBLE_TOTAL_IFNULL_EXPRESSION_COLUMN")
          (reset! producttotal-stage "rows"))
      (= stage "rows")
        (if (and (= first-byte 254) (= (buf-len bytes) 5))
          (do
            (producttotal-check (= (count (deref producttotal-rows)) 1)
                           "NATIVE_SHOP_PRODUCTS_VISIBLE_TOTAL_IFNULL_EXACTLY_ONE_ROW")
            (producttotal-check (= (get (deref producttotal-rows) 0) "1500")
                           "NATIVE_SHOP_PRODUCTS_VISIBLE_TOTAL_IFNULL_EXACT_SERVER_TOTAL")
            (reset! producttotal-stage "done")
            (reset! producttotal-done true))
          (do
            (producttotal-check (< (count (deref producttotal-rows)) 1)
                           "NATIVE_SHOP_PRODUCTS_VISIBLE_TOTAL_IFNULL_EXTRA_ROW")
            (let [field (producttotal-text bytes 0)]
              (producttotal-check (= (get field "next") (buf-len bytes))
                             "NATIVE_SHOP_PRODUCTS_VISIBLE_TOTAL_IFNULL_ROW_TRAILING_BYTES")
              (swap! producttotal-rows conj (get field "value")))))
      :else (throw "NATIVE_SHOP_PRODUCTS_VISIBLE_TOTAL_IFNULL_UNEXPECTED_STAGE"))))

(defn producttotal-drain []
  (if (>= (buf-len (deref producttotal-buffer)) 4)
    (let [bytes (deref producttotal-buffer)
          length (+ (buf-read-u8 bytes 0) (* 256 (buf-read-u8 bytes 1))
                     (* 65536 (buf-read-u8 bytes 2)))]
      (producttotal-check (<= length 65536) "NATIVE_SHOP_PRODUCTS_VISIBLE_TOTAL_IFNULL_PACKET_LIMIT")
      (if (>= (buf-len bytes) (+ 4 length))
        (do
          (reset! producttotal-buffer (buf-slice bytes (+ 4 length)
                                         (- (buf-len bytes) (+ 4 length))))
          (producttotal-frame (buf-slice bytes 4 length) (buf-read-u8 bytes 3))
          (producttotal-drain))
        nil))
    nil))

(defn native-shop-products-visible-total-ifnull-handler [event connection payload peer]
  (try
    (cond
      (or (= event "connect") (= event "accept"))
        (do (producttotal-check (nil? (deref producttotal-connection)) "NATIVE_SHOP_PRODUCTS_VISIBLE_TOTAL_IFNULL_SINGLE_CONNECTION")
            (reset! producttotal-connection connection))
      (= event "data")
        (do (reset! producttotal-buffer
              (buf-concat [(deref producttotal-buffer) (buf-from-binary payload)]))
            (producttotal-drain))
      (= event "close")
        (producttotal-check (deref producttotal-done) "NATIVE_SHOP_PRODUCTS_VISIBLE_TOTAL_IFNULL_PREMATURE_CLOSE")
      :else nil)
    (catch [error]
      (reset! producttotal-error (error_message error))
      (reset! producttotal-done true))))

(producttotal-check (not (nil? producttotal-control)) "NATIVE_SHOP_PRODUCTS_VISIBLE_TOTAL_IFNULL_HOST_ENV_REQUIRED")
(producttotal-check (not (file_exists (str producttotal-control "/ports.ready")))
             "NATIVE_SHOP_PRODUCTS_VISIBLE_TOTAL_IFNULL_CONTROL_NOT_FRESH")
(let [bridge-port (tcp-client-free-port) daemon-port (tcp-client-free-port)]
  (producttotal-check (and (number? bridge-port) (number? daemon-port)
                    (not (= bridge-port daemon-port))) "NATIVE_SHOP_PRODUCTS_VISIBLE_TOTAL_IFNULL_DISTINCT_PORTS")
  (producttotal-check (= (tcp-server-raw bridge-port "native-shop-products-visible-total-ifnull-handler" "127.0.0.1") "ok")
               "NATIVE_SHOP_PRODUCTS_VISIBLE_TOTAL_IFNULL_LISTENER_START")
  (try
    (do
      (file_write (str producttotal-control "/ports.json")
                  (json_str {"bridge" bridge-port "daemon" daemon-port}))
      (file_write (str producttotal-control "/ports.ready") "ready")
      (let [deadline (+ (now-ms) 30000)]
        (while (and (< (now-ms) deadline) (not (deref producttotal-done))) (fl-yield 10)))
      (producttotal-check (deref producttotal-done) "NATIVE_SHOP_PRODUCTS_VISIBLE_TOTAL_IFNULL_CONTRACT_TIMEOUT")
      (if (nil? (deref producttotal-error)) nil (throw (deref producttotal-error)))
      (producttotal-check (= (deref producttotal-stage) "done") "NATIVE_SHOP_PRODUCTS_VISIBLE_TOTAL_IFNULL_CONTRACT_INCOMPLETE")
      (producttotal-check (= (buf-len (deref producttotal-buffer)) 0) "NATIVE_SHOP_PRODUCTS_VISIBLE_TOTAL_IFNULL_TRAILING_PACKET_BYTES"))
    (finally (tcp-server-stop bridge-port))))
(println (str "NATIVE_SHOP_PRODUCTS_VISIBLE_TOTAL_IFNULL_RESULT "
  (json_str {"ok" true "prepared_parameters" 1
             "query" "SELECT IFNULL(SUM(price), 0) FROM shop_products WHERE visible=?"
             "bind" [1] "select_executions" 1 "rows" 1
             "columns" (deref producttotal-columns) "data" (deref producttotal-rows)
             "exact_total" true "client_computes_total" false})))
(println "afj-db95 Native shop visible products IFNULL SUM prepared SELECT PASS")
