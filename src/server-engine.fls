;; AFJ-DB authenticated protocol + authorization + SQL engine integration.

(load "/root/kilo-freelang/projects/afj-db95/src/engine.fls")
(load "/root/kilo-freelang/projects/afj-db95/src/sql-core.fls")
(load "/root/kilo-freelang/projects/afj-db95/src/protocol.fls")
(load "/root/kilo-freelang/projects/afj-db95/src/auth.fls")

(defn server-engine-permission [statement]
  (let [kind (get (parse-sql statement) "type")]
    (if (= kind "select")
      "db.read"
      "db.write")))

(defn server-engine-login [user password]
  (let [auth (authenticate user password)]
    (if (get auth "ok")
      (server-login user)
      {"ok" false "error" "AUTH_FAILED"})))

(defn server-engine-query [token statement]
  (if (not (valid-session? token))
    {"ok" false "error" "AUTH_REQUIRED"}
    (let [user (get (get (deref server-state) "sessions") token)
          permission (server-engine-permission statement)]
      (if (not (authorize user permission))
        {"ok" false "error" "PERMISSION_DENIED" "permission" permission}
        {"ok" true "result" (execute-ast (parse-sql statement))}))))

(defn server-engine-sql-literal [value]
  (if (nil? value)
    "NULL"
    (if (boolean? value)
      (if value "TRUE" "FALSE")
      (if (number? value)
        (str value)
        (str "'" (str-replace-in (str value) "'" "''") "'")))))

(defn server-engine-bind-parameters-at
  [statement index quoted parameter-index result parameters]
  (if (>= index (count statement))
    (if (= parameter-index (count parameters))
      result
      (throw "PARAMETER_COUNT_MISMATCH"))
    (let [character (str-slice statement index (+ index 1))]
      (if (= character "'")
        (server-engine-bind-parameters-at
          statement (+ index 1) (not quoted) parameter-index
          (str result character) parameters)
        (if (and (not quoted) (= character "?"))
          (if (>= parameter-index (count parameters))
            (throw "PARAMETER_COUNT_MISMATCH")
            (server-engine-bind-parameters-at
              statement (+ index 1) quoted (+ parameter-index 1)
              (str result (server-engine-sql-literal
                            (get parameters parameter-index)))
              parameters))
          (server-engine-bind-parameters-at
            statement (+ index 1) quoted parameter-index
            (str result character) parameters))))))

(defn server-engine-bind-parameters [statement parameters]
  (server-engine-bind-parameters-at statement 0 false 0 "" parameters))

(defn server-engine-execute-prepared [token statement-id]
  (let [prepared (get (get (deref server-state) "prepared") statement-id)]
    (if (or (nil? prepared)
            (not (= (get prepared "owner") token)))
      {"ok" false "error" "PREPARED_NOT_FOUND"}
      (server-engine-query token (get prepared "statement")))))

(defn server-engine-execute-prepared-params [token statement-id parameters]
  (let [prepared (get (get (deref server-state) "prepared") statement-id)]
    (if (or (nil? prepared)
            (not (= (get prepared "owner") token)))
      {"ok" false "error" "PREPARED_NOT_FOUND"}
      (server-engine-query
        token
        (server-engine-bind-parameters (get prepared "statement") parameters)))))

(server-start "afj-db95-engine")
(let [root-login (server-engine-login "root" "development-only")
      root-token (get root-login "token")
      unauthorized (server-engine-query "bad-token" "SELECT * FROM server_users")]
  (if (and (get root-login "ok")
           (= (get unauthorized "error") "AUTH_REQUIRED"))
    nil
    (throw "server authentication integration failure"))
  (server-engine-query root-token "CREATE TABLE server_users")
  (server-engine-query root-token "INSERT INTO server_users (id,name) VALUES (1,'Kim')")
  (let [selected (server-engine-query root-token "SELECT * FROM server_users")]
    (if (and (get selected "ok")
             (= (count (get (get selected "result") "rows")) 1))
      (println "afj-db95 authenticated engine query PASS")
      (throw "authenticated engine query failure"))))

;; Prepared statements execute through the same auth and permission path.
(let [login (server-engine-login "root" "development-only")
      token (get login "token")
      prepared (prepare token "SELECT * FROM server_users")
      executed (server-engine-execute-prepared token (get prepared "statement-id"))]
  (if (and (get prepared "ok") (get executed "ok"))
    (println "afj-db95 authenticated prepared query PASS")
    (throw "prepared query integration failure")))

(let [owner-login (server-engine-login "root" "development-only")
      owner-token (get owner-login "token")
      other-login (server-engine-login "root" "development-only")
      other-token (get other-login "token")
      owned (prepare owner-token "SELECT * FROM server_users")
      foreign-execution (server-engine-execute-prepared
                          other-token (get owned "statement-id"))]
  (if (= (get foreign-execution "error") "PREPARED_NOT_FOUND")
    (println "afj-db95 prepared statement ownership PASS")
    (throw "prepared statement ownership failure")))

(let [parameter-login (server-engine-login "root" "development-only")
      parameter-token (get parameter-login "token")
      parameter-prepared (prepare parameter-token
                                   "SELECT * FROM server_users WHERE id=?")
      parameter-result (server-engine-execute-prepared-params
                         parameter-token
                         (get parameter-prepared "statement-id")
                         [1])
      missing-parameter (try
                         (server-engine-execute-prepared-params
                           parameter-token
                           (get parameter-prepared "statement-id")
                           [])
                         (catch [error] {"error" (error_message error)}))]
  (if (and (get parameter-result "ok")
           (= (count (get (get parameter-result "result") "rows")) 1)
           (regex_match_i (get missing-parameter "error")
                          "PARAMETER_COUNT_MISMATCH")
           (= (server-engine-bind-parameters
                "SELECT '?' AS literal, ? AS bound" [7])
              "SELECT '?' AS literal, 7 AS bound"))
    (println "afj-db95 prepared parameter binding PASS")
    (throw "prepared parameter binding failure")))

;; A read-only role can query but cannot mutate.
(create-role "reader")
(grant "reader" "db.read")
(create-user "reader" "reader-password" "reader")
(let [reader-login (server-engine-login "reader" "reader-password")
      reader-token (get reader-login "token")
      read-result (server-engine-query reader-token "SELECT * FROM server_users")
      write-result (server-engine-query reader-token
                                        "INSERT INTO server_users (id,name) VALUES (2,'Nope')")]
  (if (and (get read-result "ok")
           (= (get write-result "error") "PERMISSION_DENIED"))
    (println "afj-db95 authenticated permission PASS")
    (throw "permission integration failure")))
