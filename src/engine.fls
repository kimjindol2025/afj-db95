;; AFJ-DB execution engine baseline.
;; SQL parser AST is deliberately kept separate from storage internals.

(define engine-catalog (atom {}))
(define engine-databases (atom {}))
(define engine-indexes (atom {}))

(defn engine-index-columns [table]
  (let [schema (get table "schema" {})
        primary (get schema "primary-key")
        unique-columns (get schema "unique-columns" [])]
    (if (nil? primary)
      unique-columns
      (conj unique-columns primary))))

(defn engine-composite-key-token [row columns]
  (if (= (count columns) 0)
    ""
    (if (= (count columns) 1)
      (str (get row (first columns)))
      (str (get row (first columns)) "|"
           (engine-composite-key-token row (rest columns))))))

(defn engine-index-group-name [columns]
  (str_join columns "|"))

(defn engine-index-groups [table]
  (get (get table "schema" {}) "unique-groups" []))

(defn engine-build-index [rows column row-id index]
  (if (>= row-id (count rows))
    index
    (let [row (get rows row-id)
          key (get row column)
          key-token (str key)
          existing-bucket (get index key-token)
          bucket (if (nil? existing-bucket) [] existing-bucket)]
      (engine-build-index rows column (+ row-id 1)
                          (assoc index key-token (conj bucket row-id))))))

(defn engine-build-composite-index [rows columns row-id index]
  (if (>= row-id (count rows))
    index
    (let [total (count rows)
          key-token (engine-composite-key-token (get rows row-id) columns)
          existing-bucket (get index key-token)
          bucket (if (nil? existing-bucket) [] existing-bucket)
          next-index (assoc index key-token (conj bucket row-id))]
      (if (= row-id (- total 1))
        next-index
        (engine-build-composite-index
          rows columns (+ row-id 1)
          next-index)))))

(defn engine-btree-node-first-key [node]
  (if (get node "leaf")
    (get (first (get node "entries" [])) "key")
    (engine-btree-node-first-key (first (get node "children" [])))))

(defn engine-btree-node-separators [children]
  (map (fn [child] (engine-btree-node-first-key child))
       (rest children)))

(defn engine-btree-child-index [separators key index]
  (if (>= index (count separators))
    index
    (if (< key (get separators index))
      index
      (engine-btree-child-index separators key (+ index 1)))))

(defn engine-btree-replace-at [items index value]
  (if (= index 0)
    (append [value] (rest items))
    (append [(first items)]
            (engine-btree-replace-at (rest items) (- index 1) value))))

(defn engine-btree-insert-at [items index value]
  (if (= index 0)
    (append [value] items)
    (append [(first items)]
            (engine-btree-insert-at (rest items) (- index 1) value))))

(defn engine-btree-key-before? [left right]
  (if (and (number? left) (number? right))
    (< left right)
    (< (str left) (str right))))

(defn engine-btree-insert-sorted [entries entry]
  (if (= (count entries) 0)
    [entry]
    (let [first-entry (first entries)]
      (if (engine-btree-key-before?
            (get entry "key") (get first-entry "key"))
        (append [entry] entries)
        (append [first-entry]
                (engine-btree-insert-sorted (rest entries) entry))))))

(defn engine-btree-split-leaf [entries]
  (let [middle (floor (/ (count entries) 2))
        left (take middle entries)
        right (drop middle entries)]
    {"left" left "right" right
     "separator" (get (first right) "key")}))

(defn engine-btree-split-children [children]
  (let [middle (floor (/ (count children) 2))
        left (take middle children)
        right (drop middle children)]
    {"left" {"leaf" false
              "separators" (engine-btree-node-separators left)
              "children" left}
     "right" {"leaf" false
               "separators" (engine-btree-node-separators right)
               "children" right}
     "separator" (engine-btree-node-first-key (first right))}))

(defn engine-btree-insert-node [node entry max-entries]
  (if (get node "leaf")
    (let [entries (engine-btree-insert-sorted
                    (get node "entries" []) entry)]
      (if (<= (count entries) max-entries)
        {"split" false "node" {"leaf" true "entries" entries}}
        (let [split (engine-btree-split-leaf entries)]
          {"split" true
           "left" {"leaf" true "entries" (get split "left")}
           "right" {"leaf" true "entries" (get split "right")}
           "separator" (get split "separator")})))
    (let [separators (get node "separators" [])
          children (get node "children" [])
          index (engine-btree-child-index separators (get entry "key") 0)
          child-result (engine-btree-insert-node
                         (get children index) entry max-entries)]
      (if (not (get child-result "split"))
        (let [updated (engine-btree-replace-at
                        children index (get child-result "node"))]
          {"split" false
           "node" {"leaf" false
                    "separators" (engine-btree-node-separators updated)
                    "children" updated}})
        (let [with-left (engine-btree-replace-at
                          children index (get child-result "left"))
              with-right (engine-btree-insert-at
                           with-left (+ index 1) (get child-result "right"))]
          (if (<= (count with-right) max-entries)
            {"split" false
             "node" {"leaf" false
                      "separators"
                        (engine-btree-node-separators with-right)
                      "children" with-right}}
            (let [split (engine-btree-split-children with-right)]
              {"split" true
               "left" (get split "left")
               "right" (get split "right")
               "separator" (get split "separator")})))))))

(defn engine-btree-root-insert [root entry max-entries]
  (let [result (engine-btree-insert-node root entry max-entries)]
    (if (not (get result "split"))
      (get result "node")
      {"leaf" false
       "separators" [(get result "separator")]
       "children" [(get result "left") (get result "right")]})))

(defn engine-btree-root-get [root key]
  (if (get root "leaf")
    (map (fn [entry] (get entry "row-id"))
         (filter (fn [entry] (= (get entry "key") key))
                 (get root "entries" [])))
    (let [index (engine-btree-child-index
                  (get root "separators" []) key 0)]
      (engine-btree-root-get
        (get (get root "children" []) index) key))))

(defn engine-btree-entries [node]
  (if (get node "leaf")
    (get node "entries" [])
    (arr_flatten (map engine-btree-entries (get node "children" [])))))

(defn engine-btree-node-last-key [node]
  (if (get node "leaf")
    (get (last (get node "entries" [])) "key")
    (engine-btree-node-last-key (last (get node "children" [])))))

(defn engine-btree-child-may-match? [child operator value]
  (if (or (= operator "!=") (= operator "<>"))
    true
    (let [first-key (engine-btree-node-first-key child)
          last-key (engine-btree-node-last-key child)]
      (if (= operator ">")
        (> last-key value)
        (if (= operator ">=")
          (>= last-key value)
          (if (= operator "<")
            (< first-key value)
            (if (= operator "<=")
              (<= first-key value)
              true)))))))

(defn engine-btree-range-entries [node operator value]
  (if (get node "leaf")
    (filter (fn [entry]
              (if (= operator ">")
                (> (get entry "key") value)
                (if (= operator ">=")
                  (>= (get entry "key") value)
                  (if (= operator "<")
                    (< (get entry "key") value)
                    (if (= operator "<=")
                      (<= (get entry "key") value)
                      (not (= (get entry "key") value)))))))
            (get node "entries" []))
    (arr_flatten
      (map (fn [child]
             (if (engine-btree-child-may-match? child operator value)
               (engine-btree-range-entries child operator value)
               []))
           (get node "children" [])))))

(defn engine-build-btree [rows column row-id root]
  (if (>= row-id (count rows))
    root
    (engine-build-btree
      rows column (+ row-id 1)
      (engine-btree-root-insert
        root {"key" (get (get rows row-id) column) "row-id" row-id} 32))))

(defn engine-build-btree-leaf [rows column row-id entries]
  (if (>= row-id (count rows))
    {"leaf" true "entries" entries}
    (engine-build-btree-leaf
      rows column (+ row-id 1)
      (conj entries
            {"key" (get (get rows row-id) column) "row-id" row-id}))))

(defn engine-build-btree-leaf-columns [rows columns row-id entries]
  (if (>= row-id (count rows))
    {"leaf" true "entries" entries}
    (engine-build-btree-leaf-columns
      rows columns (+ row-id 1)
      (conj entries
            {"key" (engine-composite-key-token (get rows row-id) columns)
             "row-id" row-id}))))

(defn engine-drop-table-indexes [name]
  (doseq [index-key (keys (deref engine-indexes))]
    (if (str_starts_with index-key (str name "."))
      (reset! engine-indexes (dissoc (deref engine-indexes) index-key))
      nil))
  true)

(defn engine-rebuild-table-indexes [name table]
  (do
    (engine-drop-table-indexes name)
    (doseq [column (engine-index-columns table)]
      (let [persisted (get (get table "page-indexes" {}) column)
            tree persisted]
        (reset! engine-indexes
                (assoc (deref engine-indexes) (str name "." column)
                       {"table" name
                        "column" column
                        "buckets" (engine-build-index (get table "rows")
                                                       column 0 {})
                        "btree" tree}))))
    (doseq [columns (engine-index-groups table)]
      (let [index-name (engine-index-group-name columns)
            persisted (get (get table "page-indexes" {}) index-name)
            tree persisted]
        (reset! engine-indexes
                (assoc (deref engine-indexes) (str name "." index-name)
                       {"table" name
                        "column" index-name
                        "columns" columns
                        "buckets" (engine-build-composite-index
                                     (get table "rows") columns 0 {})
                        "btree" tree}))))
    true))

(defn engine-index-add-row [name table row row-id]
  (doseq [column (engine-index-columns table)]
    (let [index-key (str name "." column)
          index (get (deref engine-indexes) index-key)]
      (if (nil? index)
        nil
        (let [buckets (get index "buckets")
              key-token (str (get row column))
              existing (get buckets key-token)
              bucket (if (nil? existing) [] existing)]
          (reset! engine-indexes
              (assoc (deref engine-indexes) index-key
                         (assoc index "buckets"
                                (assoc buckets key-token (conj bucket row-id))))))))
  (doseq [columns (engine-index-groups table)]
    (let [index-key (str name "." (engine-index-group-name columns))
          index (get (deref engine-indexes) index-key)]
      (if (nil? index)
        nil
        (let [buckets (get index "buckets")
              key-token (engine-composite-key-token row columns)
              existing (get buckets key-token)
              bucket (if (nil? existing) [] existing)]
          (reset! engine-indexes
                  (assoc (deref engine-indexes) index-key
                         (assoc index "buckets"
                                (assoc buckets key-token (conj bucket row-id)))))))))
  ))

(defn engine-index-add-rows [name table rows row-id]
  (if (>= row-id (count rows))
    true
    (do
      (engine-index-add-row name table (get rows row-id) row-id)
      (engine-index-add-rows name table rows (+ row-id 1)))))

(defn engine-index-rows [name table where]
  (let [column (get where "column")
        index (get (deref engine-indexes) (str name "." column))]
    (if (and (not (nil? index)) (has-key? where "equals"))
      (map (fn [row-id] (get (get table "rows") row-id))
           (if (not (nil? (get index "btree")))
             (engine-btree-root-get (get index "btree")
                                    (get where "equals"))
             (if (nil? (get (get index "buckets")
                            (str (get where "equals"))))
               []
               (get (get index "buckets")
                    (str (get where "equals"))))))
      (get table "rows"))))

;; Range predicates use the same persistent index buckets as equality
;; predicates, but inspect only bucket keys that satisfy the predicate. The
;; final engine-match? pass remains authoritative for row-level semantics.
(defn engine-index-range-rows [table index where keys-to-scan]
  (if (not (nil? (get index "btree")))
    (map (fn [entry] (get (get table "rows") (get entry "row-id")))
         (filter (fn [entry]
                   (engine-match?
                     (assoc {} (get where "column") (get entry "key"))
                     where))
                 (engine-btree-range-entries
                   (get index "btree")
                   (get where "operator")
                   (get where "value"))))
    (if (= (count keys-to-scan) 0)
      []
      (let [key-token (first keys-to-scan)
            key-row (assoc {} (get where "column") key-token)
            bucket (get (get index "buckets") key-token)
            matches? (engine-match? key-row where)
            rows (if (or (not matches?) (nil? bucket))
                   []
                   (map (fn [row-id] (get (get table "rows") row-id)) bucket))]
        (concat rows
                (engine-index-range-rows table index where
                                         (rest keys-to-scan)))))))

(defn execute-database [ast]
  (let [name (get ast "database")
        exists (has-key? (deref engine-databases) name)]
    (if (= (get ast "type") "create-database")
      (if exists
        (throw "DATABASE_EXISTS")
        (if (any? (fn [table] (str_starts_with table (str name ".")))
                  (keys (deref engine-catalog)))
          (throw "DATABASE_NAMESPACE_CONFLICT")
          (reset! engine-databases (assoc (deref engine-databases) name true))))
      (if (or exists (get ast "if-exists" false))
        (do
          (if exists
            (doseq [table (keys (deref engine-catalog))]
              (if (str_starts_with table (str name "."))
                (do
                  (reset! engine-catalog (dissoc (deref engine-catalog) table))
                  (engine-drop-table-indexes table))
                nil))
            nil)
          (reset! engine-databases (dissoc (deref engine-databases) name)))
        (throw "DATABASE_NOT_FOUND")))
    {"ok" true "type" (get ast "type") "database" name}))

;; Selected databases qualify new ASTs; legacy unqualified WAL entries retain
;; their existing catalog keys. Session selection itself is never persisted.
(defn engine-scope-ast [ast database]
  (if (or (nil? database) (nil? (get ast "table")))
    ast
    (if (not (has-key? (deref engine-databases) database))
      (throw "DATABASE_NOT_FOUND")
      (let [scoped (assoc ast "table" (str database "." (get ast "table")))
            join (get ast "join")
            schema (get ast "schema")
            joined (if (nil? join) scoped
                     (assoc scoped "join"
                            (assoc join "table" (str database "." (get join "table")))))]
        (if (nil? schema)
          joined
          (assoc joined "schema"
                 (assoc schema "foreign-keys"
                        (map (fn [fk]
                               (assoc fk "references-table"
                                      (str database "." (get fk "references-table"))))
                             (get schema "foreign-keys" [])))))))))

(defn engine-table [name]
  (let [table (get (deref engine-catalog) name)]
    (if (nil? table)
      (throw (str "table not found: " name))
      table)))

(defn engine-resolve-table-name [name]
  (if (has-key? (deref engine-catalog) name)
    name
    (let [match (first (filter (fn [candidate]
                                 (= (str_lower candidate) (str_lower name)))
                               (keys (deref engine-catalog))))]
      (if (nil? match)
        (throw (str "table not found: " name))
        match))))

(defn engine-key [qualified]
  (last (regex_split qualified "\\.")))

(defn engine-qualify-row [row alias]
  (if (nil? alias)
    row
    (let [qualified (atom row)]
      (doseq [column (keys row)]
        (reset! qualified
                (assoc (deref qualified) (str alias "." column) (get row column))))
      (deref qualified))))

(defn engine-match-basic? [row where]
  (if (nil? where)
    true
    (if (has-key? where "is-null")
      (if (get where "is-null")
        (nil? (get row (get where "column")))
        (not (nil? (get row (get where "column")))))
      (let [left (get row (get where "column"))
            right (if (has-key? where "value")
                    (get where "value")
                    (get where "equals"))
            operator (get where "operator" "=")
            left-number (if (and (string? left)
                                 (regex_match left "^-?[0-9]+$"))
                          (str-to-num left) left)
            right-number (if (and (string? right)
                                  (regex_match right "^-?[0-9]+$"))
                           (str-to-num right) right)]
        (if (= operator "=")
          (= left right)
          (if (or (= operator "!=") (= operator "<>"))
            (not (= left right))
            (if (= operator ">") (> left-number right-number)
              (if (= operator ">=") (>= left-number right-number)
                (if (= operator "<") (< left-number right-number)
                  (if (= operator "<=") (<= left-number right-number)
                    false))))))))))

(defn engine-all-predicates-match? [row predicates index]
  (if (>= index (count predicates))
    true
    (and (engine-match? row (get predicates index))
         (engine-all-predicates-match? row predicates (+ index 1)))))

(defn engine-match? [row where]
  (if (and (not (nil? where)) (has-key? where "and"))
    (engine-all-predicates-match? row (get where "and") 0)
    (engine-match-basic? row where)))

(defn engine-join [left right left-key right-key]
  (arr_flatten
    (map (fn [left-row]
           (map (fn [right-row] (obj-merge left-row right-row))
                (filter (fn [right-row]
                          (= (get left-row (engine-key left-key))
                             (get right-row (engine-key right-key))))
                        right))) left)))

(defn engine-left-join [left right left-key right-key]
  (arr_flatten
    (map (fn [left-row]
           (let [matches (filter (fn [right-row]
                                   (= (get left-row (engine-key left-key))
                                      (get right-row (engine-key right-key))))
                                 right)]
             (if (= (count matches) 0)
               [left-row]
               (map (fn [right-row] (obj-merge left-row right-row))
                    matches))))
         left)))

(defn engine-aggregate-count [rows aggregate group-by output-column]
  (let [groups (atom {})
        count-column (get aggregate "column")]
    (doseq [row rows]
      (let [key (if (= (count group-by) 0)
                  "__all__"
                  (get row (last group-by)))
            current (get (deref groups) key
                         {"group" key "count" 0})
            include (if (= count-column "*")
                      true
                      (not (nil? (get row count-column))))]
        (if include
          (reset! groups
                  (assoc (deref groups) key
                         (assoc current "count" (+ (get current "count") 1))))
          nil)))
    (map (fn [key]
           (let [group (get (deref groups) key)
                 row (if (= (count group-by) 0)
                       {}
                       (assoc {} (engine-key (last group-by))
                              (get group "group")))]
             (assoc row output-column (get group "count"))))
         (keys (deref groups)))))

(defn engine-project-row [row columns]
  (let [projected (atom {})]
    (doseq [column columns]
      (reset! projected
              (assoc (deref projected) (engine-key column) (get row column))))
    (deref projected)))

(defn engine-group-count [rows column]
  (let [counts (atom {})]
    (doseq [row rows]
      (let [key (str (get row column))]
        (reset! counts
                (assoc (deref counts) key (+ (get (deref counts) key 0) 1)))))
    (deref counts)))

(defn engine-type-valid? [value type]
  (if (nil? value)
    true
    (if (= type "INTEGER")
      (or (integer? value) (regex_match value "^-?[0-9]+$"))
      (if (= type "BOOLEAN")
        (boolean? value)
        (string? value)))))

(defn engine-check-valid? [row check]
  (if (has-key? check "any")
    (any? (fn [clause] (engine-check-valid? row clause)) (get check "any"))
  (let [left (get row (get check "column"))
        right (get check "value")
        operator (get check "operator")]
    (if (= operator "=")
      (= left right)
      (if (or (= operator "!=") (= operator "<>"))
        (not (= left right))
        (if (= operator ">")
          (> left right)
          (if (= operator "<")
            (< left right)
            (if (= operator ">=")
              (>= left right)
              (if (= operator "<=")
                (<= left right)
                false)))))))))

(defn engine-validate-foreign-key [row constraint]
  (let [local (get row (get constraint "column"))]
    (if (nil? local)
      true
      (let [table-name (engine-resolve-table-name (get constraint "references-table"))
            table (engine-table table-name)
            remote-column (get constraint "references-column")]
        (if (any? (fn [remote]
                    (= local (get remote remote-column)))
                  (get table "rows"))
          true
          (throw (str "FOREIGN_KEY_VIOLATION: " (get constraint "column"))))))))

(defn engine-row-matches-columns? [left right columns index]
  (if (>= index (count columns))
    true
    (and (= (get left (get columns index))
            (get right (get columns index)))
         (engine-row-matches-columns? left right columns (+ index 1)))))

(defn engine-any-row-matches-columns? [rows row columns index]
  (if (= (count rows) 0)
    false
    (if (engine-row-matches-columns? (first rows) row columns 0)
      true
      (engine-any-row-matches-columns? (rest rows) row columns index))))

(defn engine-validate-row [schema row existing]
  (doseq [column (get schema "columns" [])]
    (let [name (get column "name")
          value (get row name)]
      (if (and (not (get column "nullable" true)) (nil? value))
        (throw (str "NOT_NULL_VIOLATION: " name))
        (if (not (engine-type-valid? value (get column "type" "TEXT")))
          (throw (str "TYPE_VIOLATION: " name))
          nil))))
  (let [primary (get schema "primary-key")]
    (if (and (not (nil? primary))
             (not (nil? (get row primary)))
             (any? (fn [old] (= (get old primary) (get row primary))) existing))
      (throw "PRIMARY_KEY_VIOLATION")
      nil))
  (doseq [column (get schema "unique-columns" [])]
    (let [value (get row column)]
      (if (and (not (nil? value))
               (any? (fn [old] (= (get old column) value)) existing))
        (throw (str "UNIQUE_VIOLATION: " column))
        nil)))
  (doseq [columns (get schema "unique-groups" [])]
    (let [duplicate (engine-any-row-matches-columns?
                      existing row columns 0)]
      (if duplicate
        (throw (str "UNIQUE_VIOLATION: "
                    (engine-index-group-name columns)))
        nil)))
  (doseq [constraint (get schema "foreign-keys" [])]
    (engine-validate-foreign-key row constraint))
  (doseq [check (get schema "checks" [])]
    (if (engine-check-valid? row check)
      nil
      (throw (str "CHECK_VIOLATION: " (get check "column")))))
  true)

(defn execute-create [ast]
  (let [name (get ast "table")]
    (if (has-key? (deref engine-catalog) name)
      (throw (str "table already exists: " name))
      (reset! engine-catalog
              (assoc (deref engine-catalog) name
                     (assoc {"name" name "rows" [] "columns" []}
                            "schema" (get ast "schema" {})))))
    (engine-rebuild-table-indexes name (engine-table name))
    {"ok" true "type" "create-table" "table" name}))

(defn execute-alter [ast]
  (let [name (get ast "table")
        table (engine-table name)
        column (get ast "column")
        columns (concat (get table "columns" [])
                        (map (fn [item] (get item "name"))
                             (get (get table "schema" {}) "columns" [])))]
    (if (contains? columns column)
      (throw (str "column already exists: " column))
      (let [rows (map (fn [row] (assoc row column nil)) (get table "rows"))
            schema (if (has-key? ast "definition")
                     (assoc (get table "schema" {}) "columns"
                            (conj (get (get table "schema" {}) "columns" [])
                                  (get ast "definition")))
                     (get table "schema" {}))
            updated-table (dissoc
                            (assoc table "columns"
                                   (conj (get table "columns" []) column)
                                   "rows" rows "schema" schema)
                            "page-indexes")]
        (reset! engine-catalog
                (assoc (deref engine-catalog) name updated-table))
        (engine-rebuild-table-indexes name (engine-table name))
        {"ok" true "type" "alter-table" "table" name "column" column}))))

(defn execute-drop [ast]
  (let [name (get ast "table")]
    (engine-table name)
    (reset! engine-catalog (dissoc (deref engine-catalog) name))
    (engine-drop-table-indexes name)
    {"ok" true "type" "drop-table" "table" name}))

(defn engine-positional-row [table values]
  (let [columns (map (fn [column] (get column "name"))
                     (get (get table "schema" {}) "columns" []))]
    (if (or (= (count columns) 0) (not (= (count columns) (count values))))
      (throw "COLUMN_COUNT_MISMATCH")
      (let [row (atom {})]
        (doseq [index (range 0 (count columns))]
          (reset! row
                  (assoc (deref row) (get columns index) (get values index))))
        (deref row)))))

(defn execute-insert [ast]
  (let [name (get ast "table")
        table (engine-table name)
        new-rows (if (has-key? ast "values")
                   (map (fn [values] (engine-positional-row table values))
                        (get ast "values"))
                 (if (has-key? ast "rows")
                   (get ast "rows")
                   [(get ast "row")]))
        existing (get table "rows")
        candidate (atom existing)]
    (doseq [row new-rows]
      (engine-validate-row (get table "schema" {}) row (deref candidate))
      (reset! candidate (conj (deref candidate) row)))
    (let [rows (deref candidate)
          updated-table (dissoc (assoc table "rows" rows)
                                "page-indexes")]
    (reset! engine-catalog (assoc (deref engine-catalog) name updated-table))
    (engine-rebuild-table-indexes name updated-table)
    {"ok" true "type" "insert" "count" (count new-rows)})))

;; Keep the index lookup helper adjacent to the executor so the bootstrap
;; loader registers it before any self-test query invokes the planner.
(defn engine-index-and-rows [name table where]
  (let [predicates (get where "and")
        first-predicate (first predicates)
        second-predicate (last predicates)
        columns [(get first-predicate "column")
                 (get second-predicate "column")]
        index-name (engine-index-group-name columns)
        index (get (deref engine-indexes) (str name "." index-name))]
    (if (or (nil? index)
            (not (= (count predicates) 2))
            (not (has-key? first-predicate "equals"))
            (not (has-key? second-predicate "equals")))
      (get table "rows")
      (let [values-row (atom {})]
        (doseq [predicate predicates]
          (reset! values-row
                  (assoc (deref values-row)
                         (get predicate "column")
                         (get predicate "equals"))))
        (let [token (engine-composite-key-token
                      (deref values-row) columns)
              row-ids (if (not (nil? (get index "btree")))
                        (engine-btree-root-get (get index "btree") token)
                        (get (get index "buckets") token []))]
          (map (fn [row-id] (get (get table "rows") row-id)) row-ids))))))

(defn engine-index-rows-safe [name table where]
  (let [column (get where "column")
        index (get (deref engine-indexes) (str name "." column))
        operator (get where "operator")]
    (if (has-key? where "and")
      (engine-index-and-rows name table where)
      (if (nil? index)
      (get table "rows")
      (if (has-key? where "equals")
        (map (fn [row-id] (get (get table "rows") row-id))
             (if (not (nil? (get index "btree")))
               (engine-btree-root-get (get index "btree")
                                      (get where "equals"))
               (if (nil? (get (get index "buckets")
                              (str (get where "equals"))))
                 []
                 (get (get index "buckets")
                      (str (get where "equals"))))))
        (if (or (= operator ">") (= operator ">=")
                (= operator "<") (= operator "<=")
                (= operator "!=") (= operator "<>"))
          (engine-index-range-rows table index where
                                   (keys (get index "buckets")))
          (get table "rows")))))))

(defn execute-select [ast]
  (let [table (engine-table (get ast "table"))
        where (get ast "where")
        index-key (if (nil? where)
                    nil
                    (if (has-key? where "and")
                      (str (get ast "table") "."
                         (engine-index-group-name
                           [(get (first (get where "and")) "column")
                            (get (last (get where "and")) "column")]))
                      (str (get ast "table") "." (get where "column"))))
        source-rows (if (nil? where)
                      (get table "rows")
                      (engine-index-rows-safe (get ast "table") table where))
        rows (map (fn [row]
                    (engine-qualify-row row (get ast "table-alias")))
                  source-rows)
        filtered (if (nil? where)
                   rows
                   (filter (fn [row] (engine-match? row where)) rows))
        joined (if (nil? (get ast "join"))
                 filtered
                 (let [join (get ast "join")
                       right (map (fn [row]
                                    (engine-qualify-row
                                      row (get join "table-alias")))
                                  (get (engine-table (get join "table")) "rows"))]
                   (if (= (get join "type") "left")
                     (engine-left-join filtered right
                                        (get join "left") (get join "right"))
                     (engine-join filtered right
                                  (get join "left") (get join "right")))))
        ordered (if (nil? (get ast "order-by"))
                  joined
                  (arr_sort_by joined (engine-key (get ast "order-by"))))
        direction-ordered (if (= (get ast "order-direction") "desc")
                            (reverse ordered)
                            ordered)
        limited (if (nil? (get ast "limit"))
                  direction-ordered
                  (take (get ast "limit") direction-ordered))]
    (if (not (nil? (get ast "aggregate")))
      (let [aggregate-rows (engine-aggregate-count
                             joined
                             (get ast "aggregate")
                             (get ast "group-by" [])
                             (get (get ast "aggregate") "alias"))]
        {"ok" true "type" "select" "rows" aggregate-rows})
      (if (nil? (get ast "group-by"))
        {"ok" true "type" "select"
         "plan" (if (and (not (nil? where))
                         (not (nil? (get (deref engine-indexes)
                                        index-key)))
                    )
                    (if (or (has-key? where "equals")
                            (has-key? where "and"))
                      "index-scan"
                      "index-range-scan")
                    "full-scan")
         "rows" (if (or (nil? (get ast "columns"))
                        (= (get ast "columns") ["*"]))
                   limited
                   (map (fn [row]
                          (engine-project-row row (get ast "columns")))
                        limited))}
        (let [grouped (engine-group-count
                        limited (engine-key (get ast "group-by")))]
          {"ok" true "type" "select" "groups" grouped})))))

(defn execute-update [ast]
  (let [name (get ast "table")
        table (engine-table name)
        where (get ast "where")
        rows (map (fn [row]
                    (if (engine-match? row where)
                      (obj-merge row (get ast "changes"))
                      row))
                  (get table "rows"))]
    (let [updated-table (dissoc (assoc table "rows" rows)
                                "page-indexes")]
      (reset! engine-catalog (assoc (deref engine-catalog) name updated-table))
      (engine-rebuild-table-indexes name updated-table))
    {"ok" true "type" "update" "rows" rows}))

(defn execute-delete [ast]
  (let [name (get ast "table")
        table (engine-table name)
        where (get ast "where")
        rows (if (nil? where)
               []
               (filter (fn [row]
                         (not (engine-match? row where)))
                       (get table "rows")))]
    (let [updated-table (dissoc (assoc table "rows" rows)
                                "page-indexes")]
      (reset! engine-catalog (assoc (deref engine-catalog) name updated-table))
      (engine-rebuild-table-indexes name updated-table))
    {"ok" true "type" "delete" "rows" rows}))

(defn execute-ast [ast]
  (let [kind (get ast "type")]
    (if (or (= kind "create-database") (= kind "drop-database"))
      (execute-database ast)
    (if (= kind "create-table")
      (execute-create ast)
      (if (= kind "alter-table")
        (execute-alter ast)
        (if (= kind "drop-table")
          (execute-drop ast)
      (if (= kind "insert")
        (execute-insert ast)
        (if (= kind "select")
          (execute-select ast)
          (if (= kind "update")
            (execute-update ast)
            (if (= kind "delete")
              (execute-delete ast)
              (throw (str "unsupported AST type: " kind))))))))))))

(execute-ast {"type" "create-table" "table" "users"})
(execute-ast {"type" "insert" "table" "users" "row" {"id" 1 "name" "Kim"}})
(execute-ast {"type" "insert" "table" "users" "row" {"id" 2 "name" "Lee"}})
(execute-ast {"type" "create-table" "table" "teams"})
(execute-ast {"type" "insert" "table" "teams" "row" {"team_id" 10 "team" "core"}})
(execute-ast {"type" "update" "table" "users" "changes" {"team_id" 10}})
(let [result (execute-ast {"type" "select" "table" "users"})]
  (if (= (count (get result "rows")) 2)
    (println "afj-db95 executor PASS")
    (throw "executor result failure")))
(let [result (execute-ast {"type" "select" "table" "users"
                           "where" {"column" "name" "equals" "Kim"}})]
  (if (= (count (get result "rows")) 1)
    (println "afj-db95 WHERE executor PASS")
    (throw "WHERE executor failure")))

(execute-ast {"type" "create-table" "table" "indexed_plan_users"
              "schema" {"columns" [{"name" "id" "type" "INTEGER"
                                      "nullable" false "primary" true}
                                     {"name" "name" "type" "TEXT"
                                      "nullable" true}]
                         "primary-key" "id" "unique-columns" []}})
(execute-ast {"type" "insert" "table" "indexed_plan_users"
              "row" {"id" 1 "name" "Kim"}})
(execute-ast {"type" "insert" "table" "indexed_plan_users"
              "row" {"id" 2 "name" "Lee"}})
(let [indexed-result (execute-ast {"type" "select" "table" "indexed_plan_users"
                                   "where" {"column" "id" "equals" 2}})
      scan-result (execute-ast {"type" "select" "table" "indexed_plan_users"
                                "where" {"column" "name" "equals" "Lee"}})]
  (if (and (= (get indexed-result "plan") "index-scan")
           (= (get scan-result "plan") "full-scan")
           (= (get (first (get indexed-result "rows")) "name")
              (get (first (get scan-result "rows")) "name")))
    (println "afj-db95 index optimizer PASS")
    (throw (str "index and full scan results differ index-plan="
                (get indexed-result "plan")
                " scan-plan=" (get scan-result "plan")
                " index-rows=" (count (get indexed-result "rows"))
                " scan-rows=" (count (get scan-result "rows"))))))
(let [updated (execute-ast {"type" "update" "table" "indexed_plan_users"
                             "where" {"column" "id" "equals" 2}
                             "changes" {"name" "Lee-updated"}})
      after-update (execute-ast {"type" "select" "table" "indexed_plan_users"
                                 "where" {"column" "id" "equals" 2}})
      deleted (execute-ast {"type" "delete" "table" "indexed_plan_users"
                            "where" {"column" "id" "equals" 2}})
      after-delete (execute-ast {"type" "select" "table" "indexed_plan_users"
                                 "where" {"column" "id" "equals" 2}})]
  (if (and (= (get (first (filter (fn [row] (= (get row "id") 2))
                                  (get updated "rows"))) "name") "Lee-updated")
           (= (get after-update "plan") "index-scan")
           (= (get (first (get after-update "rows")) "name") "Lee-updated")
           (= (count (get deleted "rows")) 1)
           (= (get after-delete "plan") "index-scan")
           (= (count (get after-delete "rows")) 0))
    (println "afj-db95 index CRUD maintenance PASS")
    (throw "index CRUD maintenance failure")))
(let [result (execute-ast {"type" "update" "table" "users"
                           "where" {"column" "name" "equals" "Kim"}
                           "changes" {"age" 31}})]
  (if (= (get (first (get result "rows")) "age") 31)
    (println "afj-db95 WHERE update PASS")
    (throw "WHERE update failure")))
(let [joined (execute-ast {"type" "select" "table" "users"
                           "join" {"table" "teams" "left" "team_id"
                                   "right" "team_id"}})
      groups (execute-ast {"type" "select" "table" "users"
                           "group-by" "team_id"})
      ordered (execute-ast {"type" "select" "table" "users"
                            "order-by" "id"})]
  (if (and (= (count (get joined "rows")) 2)
           (= (get (get groups "groups") "10") 2)
           (= (get (first (get ordered "rows")) "id") 1))
    (println "afj-db95 JOIN/GROUP engine PASS")
    (if (= (count (get joined "rows")) 1)
      (println "afj-db95 JOIN engine PASS")
      (throw "JOIN engine failure"))))
(let [altered (execute-ast {"type" "alter-table" "table" "users"
                            "operation" "add-column" "column" "email"})
      row (first (get (execute-ast {"type" "select" "table" "users"}) "rows"))
      dropped (execute-ast {"type" "drop-table" "table" "teams"})
      nulls (execute-ast {"type" "select" "table" "users"
                          "where" {"column" "email" "is-null" true}})
      non-nulls (execute-ast {"type" "select" "table" "users"
                              "where" {"column" "email" "is-null" false}})
      limited (execute-ast {"type" "select" "table" "users" "limit" 1})]
  (if (and (= (get altered "column") "email")
           (has-key? row "email")
           (= (count (get nulls "rows")) 2)
           (= (count (get non-nulls "rows")) 0)
           (= (count (get limited "rows")) 1)
           (= (get dropped "type") "drop-table"))
    (if (not (has-key? (deref engine-catalog) "teams"))
      (println "afj-db95 DDL engine PASS")
      (throw "DROP TABLE did not remove catalog entry"))
    (throw "ALTER TABLE did not add column")))

;; Parser-to-engine smoke: literal SQL values must reach the real executor.
(load "/root/kilo-freelang/projects/afj-db95/src/sql-core.fls")
(execute-ast (parse-sql "CREATE TABLE literal_users"))
(execute-ast (parse-sql "INSERT INTO literal_users (id,name) VALUES (1,'Kim')"))
(execute-ast (parse-sql "UPDATE literal_users SET name='Lee' WHERE id=1"))
(let [literal-result (execute-ast (parse-sql "SELECT * FROM literal_users"))]
  (if (and (= (count (get literal-result "rows")) 1)
           (= (get (first (get literal-result "rows")) "name") "Lee"))
    (do
      (execute-ast (parse-sql "DELETE FROM literal_users WHERE id=1"))
      (let [deleted-result (execute-ast (parse-sql "SELECT * FROM literal_users"))]
        (if (= (count (get deleted-result "rows")) 0)
          (println "afj-db95 parser-to-engine INSERT/UPDATE/DELETE PASS")
          (throw "literal DELETE did not reach engine"))))
      (throw "literal INSERT/UPDATE did not reach engine")))
(execute-ast (parse-sql "INSERT INTO literal_users (id,name) VALUES (2,'Park'),(3,'Choi')"))
(let [multi-result (execute-ast (parse-sql "SELECT * FROM literal_users"))]
  (if (= (count (get multi-result "rows")) 2)
    (println "afj-db95 multi-row INSERT engine PASS")
    (throw "multi-row INSERT lost rows")))

;; MariaDB corpus execution: LEFT JOIN, aliases, grouped COUNT and COUNT(*).
(execute-ast {"type" "create-table" "table" "agg_teams"})
(execute-ast {"type" "create-table" "table" "agg_users"})
(execute-ast {"type" "insert" "table" "agg_teams"
              "rows" [{"id" 1 "name" "core"}
                      {"id" 2 "name" "ops"}]})
(execute-ast {"type" "insert" "table" "agg_users"
              "rows" [{"id" 1 "team_id" 1}
                      {"id" 2 "team_id" 2}
                      {"id" 3 "team_id" 1}]})
(execute-ast {"type" "create-table" "table" "project_users"})
(execute-ast {"type" "insert" "table" "project_users"
              "rows" [{"id" 1 "name" "Kim" "active" true}
                      {"id" 2 "name" "Lee" "active" true}
                      {"id" 3 "name" "Park" "active" false}]})
(let [grouped (execute-ast
                (parse-sql
                  "SELECT t.name, COUNT(u.id) AS n FROM agg_teams t LEFT JOIN agg_users u ON t.id=u.team_id GROUP BY t.id,t.name ORDER BY t.id"))
      all-count (execute-ast
                  (parse-sql "SELECT COUNT(*) AS remaining FROM agg_users"))
      projected (execute-ast
                  (parse-sql
                    "SELECT id,name FROM project_users WHERE active=TRUE ORDER BY id DESC"))
      core (first (filter (fn [row] (= (get row "name") "core"))
                          (get grouped "rows")))
      ops (first (filter (fn [row] (= (get row "name") "ops"))
                         (get grouped "rows")))]
  (if (and (= (get core "n") 2)
           (= (get ops "n") 1)
           (= (get (first (get all-count "rows")) "remaining") 3)
           (= (get (first (get projected "rows")) "id") 2)
           (= (get (first (get projected "rows")) "name") "Lee")
           (not (has-key? (first (get projected "rows")) "active")))
    (println "afj-db95 MariaDB aggregate/left-join engine PASS")
    (throw "MariaDB aggregate/left-join engine failure")))

;; DDL schema constraints: primary, unique, NOT NULL and type checks.
(let [created (execute-ast
                (parse-sql
                  "CREATE TABLE constrained_users(id INT PRIMARY KEY, name TEXT NOT NULL, email TEXT UNIQUE)"))
      valid (execute-ast
              (parse-sql "INSERT INTO constrained_users (id,name,email) VALUES (1,'Kim','k@example')"))
      duplicate (try
                  (do
                    (execute-ast
                      (parse-sql "INSERT INTO constrained_users (id,name,email) VALUES (1,'Lee','l@example')"))
                    "NO_ERROR")
                  (catch [error] (error_message error)))
      null-name (try
                  (do
                    (execute-ast
                      (parse-sql "INSERT INTO constrained_users (id,name,email) VALUES (2,NULL,'n@example')"))
                    "NO_ERROR")
                  (catch [error] (error_message error)))
      duplicate-email (try
                        (do
                          (execute-ast
                            (parse-sql "INSERT INTO constrained_users (id,name,email) VALUES (2,'Park','k@example')"))
                          "NO_ERROR")
                        (catch [error] (error_message error)))]
  (if (and (= (get created "type") "create-table")
           (= (get valid "count") 1)
           (= duplicate "[engine-validate-row] PRIMARY_KEY_VIOLATION")
           (= null-name "[engine-validate-row] NOT_NULL_VIOLATION: name")
           (= duplicate-email "[engine-validate-row] UNIQUE_VIOLATION: email"))
    (println "afj-db95 schema constraints engine PASS")
    (throw "schema constraint engine failure")))

;; Relational constraints: FK lookup and CHECK evaluation are on the INSERT path.
(let [parent (execute-ast (parse-sql "CREATE TABLE fk_teams(id INT PRIMARY KEY)"))
      parent-row (execute-ast
                   (parse-sql "INSERT INTO fk_teams (id) VALUES (10)"))
      child (execute-ast
              (parse-sql
                "CREATE TABLE fk_users(id INT PRIMARY KEY, team_id INT, active BOOLEAN, CONSTRAINT fk_team FOREIGN KEY(team_id) REFERENCES fk_teams(id), CHECK(active = TRUE))"))
      valid (execute-ast
              (parse-sql "INSERT INTO fk_users (id,team_id,active) VALUES (1,10,TRUE)"))
      missing-parent (try
                       (do
                         (execute-ast
                           (parse-sql "INSERT INTO fk_users (id,team_id,active) VALUES (2,99,TRUE)"))
                         "NO_ERROR")
                       (catch [error] (error_message error)))
      failed-check (try
                     (do
                       (execute-ast
                         (parse-sql "INSERT INTO fk_users (id,team_id,active) VALUES (3,10,FALSE)"))
                       "NO_ERROR")
                       (catch [error] (error_message error)))]
  (if (and (= (get parent "type") "create-table")
           (= (get parent-row "count") 1)
           (= (get child "type") "create-table")
           (= (get valid "count") 1)
           (= missing-parent "[engine-validate-row] [engine-validate-foreign-key] FOREIGN_KEY_VIOLATION: team_id")
           (= failed-check "[engine-validate-row] CHECK_VIOLATION: active"))
    (println "afj-db95 foreign-key/check engine PASS")
    (throw "foreign-key/check engine failure")))
