         "SELECT shop_cart.id, shop_products.id FROM shop_cart JOIN shop_products ON shop_cart.product_id = shop_products.id WHERE shop_cart.id=1"]]
  (let [rejected (try
                   (do (parse-sql query) false)
                   (catch [error]
                     (str-includes (error_message error) "unsupported SELECT form")))]
    (if (= rejected true) true
      (throw "qualified INNER JOIN scope guard failure"))))
