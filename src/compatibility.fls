;; MariaDB compatibility scorecard baseline.
;; A feature counts only when its runtime contract is marked passed.

(define compatibility-features [
  {"name" "CRUD" "area" "SQL" "weight" 12 "passed" true}
  {"name" "WHERE" "area" "SQL" "weight" 5 "passed" true}
  {"name" "JOIN" "area" "SQL" "weight" 5 "passed" true}
  {"name" "GROUP/ORDER" "area" "SQL" "weight" 4 "passed" true}
  {"name" "WAL/recovery" "area" "storage" "weight" 12 "passed" true}
  {"name" "page checksum" "area" "storage" "weight" 4 "passed" true}
  {"name" "COMMIT/ROLLBACK" "area" "transaction" "weight" 8 "passed" true}
  {"name" "MVCC" "area" "transaction" "weight" 6 "passed" false}
  {"name" "locks/isolation" "area" "transaction" "weight" 6 "passed" true}
  {"name" "B+Tree" "area" "index" "weight" 6 "passed" false}
  {"name" "TCP/auth" "area" "server" "weight" 8 "passed" true}
  {"name" "permissions" "area" "server" "weight" 4 "passed" true}
  {"name" "backup/restore" "area" "ops" "weight" 5 "passed" true}
  {"name" "health/metrics" "area" "ops" "weight" 3 "passed" true}
  {"name" "fsync/atomicity" "area" "storage" "weight" 5 "passed" true}
  {"name" "deadlock detection" "area" "transaction" "weight" 3 "passed" true}
  {"name" "MariaDB regression suite" "area" "compat" "weight" 4 "passed" true}
])

(defn compatibility-score [features]
  (let [passed (atom 0)
        total (atom 0)]
    (doseq [feature features]
      (swap! total + (get feature "weight"))
      (if (get feature "passed")
        (swap! passed + (get feature "weight"))
        nil))
    {"passed-weight" (deref passed)
     "total-weight" (deref total)
     "percent" (* 100 (/ (deref passed) (deref total)))}))

(let [score (compatibility-score compatibility-features)]
  (if (>= (get score "percent") 95)
    (println (str "afj-db95 compatibility target PASS=" (get score "percent") "%"))
    (if (> (get score "percent") 0)
      (println (str "afj-db95 compatibility baseline=" (get score "percent") "%"))
      (throw "compatibility scorecard failure"))))
