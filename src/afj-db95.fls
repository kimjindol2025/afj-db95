;; afj-db95 M0: FreeLang Script 관계형 코어
;; 현재 저장소는 메모리 기반이며, 영속성은 M1에서 추가한다.

(define catalog (atom {}))
(define wal (atom []))
(define replaying (atom false))
(define storage-path (atom nil))
(define afj-page-size 4096)
(define afj-wal-version 1)
(define afj-wal-record-limit 1048576)
(define afj-page-cache-max
  (let [raw (env-get "AFJ_DB_PAGE_CACHE_PAGES")]
    (if (nil? raw)
      64
      (let [parsed (str-to-num raw)]
        (if (and (number? parsed) (> parsed 0) (<= parsed 4096))
          parsed
          (throw "AFJ_DB_PAGE_CACHE_PAGES_INVALID"))))))
(define afj-page-cache (atom {}))
(define afj-page-cache-tick (atom 0))

(defn page-payload [page]
  (let [encoded (json_str page)]
    (let [envelope {"magic" "AFJPG"
                    "version" 1
                    "length" (count encoded)
                    "checksum" (sha256 encoded)
                    "payload" page}
          serialized (json_str envelope)]
      (if (> (count serialized) afj-page-size)
        (throw "PAGE_TOO_LARGE")
        serialized))))

(defn valid-page? [page]
  (and (= (get page "magic") "AFJPG")
       (= (get page "version") 1)
       (<= (count (json_str page)) afj-page-size)
       (= (get page "length") (count (json_str (get page "payload"))))
       (= (get page "checksum") (sha256 (json_str (get page "payload"))))))

(defn write-page [path page]
  (file_write path (page-payload page)))

(defn read-page [path]
    (let [page (json-parse (file_read path))]
    (if (valid-page? page)
      (get page "payload")
      (throw (str "invalid AFJ page: " path)))))

;; Bounded page cache for page-set reads. Entries are explicitly invalidated
;; when this module writes a page set; the LRU bound prevents page reads from
;; growing memory without limit.
(defn afj-page-cache-key [path index fingerprint]
  ;; Include the raw line fingerprint so an external file change or page
  ;; corruption cannot be hidden by a stale cached page.
  (str path "#" index "#" fingerprint))

(defn afj-page-cache-oldest [cache candidates oldest-key oldest-used]
  (if (= (count candidates) 0)
    oldest-key
    (let [key (first candidates)
          entry (get cache key)
          used (get entry "used")]
      (if (or (nil? oldest-key) (< used oldest-used))
        (afj-page-cache-oldest cache (rest candidates) key used)
        (afj-page-cache-oldest cache (rest candidates)
                                oldest-key oldest-used)))))

(defn afj-page-cache-clear [path]
  (doseq [key (keys (deref afj-page-cache))]
    (if (str_starts_with key (str path "#"))
      (swap! afj-page-cache dissoc key)
      nil))
  true)

(defn afj-page-cache-get [path index fingerprint]
  (let [key (afj-page-cache-key path index fingerprint)
        entry (get (deref afj-page-cache) key)]
    (if (nil? entry)
      nil
      (let [tick (swap! afj-page-cache-tick (fn [value] (+ value 1)))]
        (swap! afj-page-cache assoc key (assoc entry "used" tick))
        (get entry "page")))))

(defn afj-page-cache-put [path index fingerprint page]
  (let [key (afj-page-cache-key path index fingerprint)
        tick (swap! afj-page-cache-tick (fn [value] (+ value 1)))]
    (swap! afj-page-cache assoc key {"page" page "used" tick})
    (if (> (count (deref afj-page-cache)) afj-page-cache-max)
      (let [victim (afj-page-cache-oldest
                     (deref afj-page-cache)
                     (keys (deref afj-page-cache)) nil 0)]
        (if (nil? victim)
          nil
          (swap! afj-page-cache dissoc victim)))
      nil)
    page))

(defn afj-page-split-at [encoded index chunks]
  (if (>= index (count encoded))
    chunks
    (let [next-index (+ index 2048)
          end (if (> next-index (count encoded))
                (count encoded)
                next-index)]
      (afj-page-split-at encoded end
                         (conj chunks (str-slice encoded index end))))))

(defn write-page-set [path value]
  (let [encoded (json_str value)
        chunks (afj-page-split-at encoded 0 [])
        total (count chunks)]
    (if (= total 0)
      (throw "PAGE_SET_EMPTY")
      (do
        (afj-page-cache-clear path)
        (file_write path "")
        (doseq [index (range 0 total)]
          (let [page {"set-version" 1
                      "id" index
                      "total" total
                      "data" (get chunks index)}]
            (file_append path (str (page-payload page) "\n"))))
        total))))

(defn read-page-set-lines-cached [path lines index total encoded]
  (if (>= index (count lines))
    (if (= index total)
      (json-parse encoded)
      (throw "PAGE_SET_INCOMPLETE"))
    (let [raw-line (get lines index)
          fingerprint (sha256 raw-line)
          cached (afj-page-cache-get path index fingerprint)
          page (if (nil? cached)
                 (let [parsed (try
                                (json-parse raw-line)
                                (catch [error] nil))]
                   (if (nil? parsed)
                     nil
                     (afj-page-cache-put path index fingerprint parsed)))
                 cached)
          payload (if (nil? page) nil (get page "payload"))]
      (if (or (nil? page)
              (not (valid-page? page))
              (nil? payload)
              (not (= (get payload "set-version") 1))
              (not (= (get payload "id") index))
              (not (= (get payload "total") total)))
        (throw "PAGE_SET_CORRUPT")
        (read-page-set-lines-cached path lines (+ index 1) total
                                     (str encoded (get payload "data")))))))

(defn read-page-set-cached [path]
  (if (not (file_exists path))
    (throw "PAGE_SET_MISSING")
    (let [lines (filter (fn [line] (not (= (str_trim line) "")))
                        (str_lines (file_read path)))
          first-page (if (= (count lines) 0) nil
                       (try (json-parse (first lines)) (catch [error] nil)))
          first-payload (if (nil? first-page) nil (get first-page "payload"))
          total (if (nil? first-payload) 0 (get first-payload "total"))]
      (if (or (= total 0) (not (= total (count lines))))
        (throw "PAGE_SET_CORRUPT")
        (read-page-set-lines-cached path lines 0 total "")))))

(defn read-page-set-lines [lines index total encoded]
  (if (>= index (count lines))
    (if (= index total)
      (json-parse encoded)
      (throw "PAGE_SET_INCOMPLETE"))
    (let [page (try
                 (json-parse (get lines index))
                 (catch [error] nil))
          payload (if (nil? page) nil (get page "payload"))]
      (if (or (nil? page)
              (not (valid-page? page))
              (nil? payload)
              (not (= (get payload "set-version") 1))
              (not (= (get payload "id") index))
              (not (= (get payload "total") total)))
        (throw "PAGE_SET_CORRUPT")
        (read-page-set-lines lines (+ index 1) total
                             (str encoded (get payload "data")))))))

(defn read-page-set [path]
  (if (not (file_exists path))
    (throw "PAGE_SET_MISSING")
    (let [lines (filter (fn [line] (not (= (str_trim line) "")))
                        (str_lines (file_read path)))
          first-page (if (= (count lines) 0) nil
                       (try (json-parse (first lines)) (catch [error] nil)))
          first-payload (if (nil? first-page) nil (get first-page "payload"))
          total (if (nil? first-payload) 0 (get first-payload "total"))]
      (if (or (= total 0) (not (= total (count lines))))
        (throw "PAGE_SET_CORRUPT")
        (read-page-set-lines lines 0 total "")))))

(defn persist-wal-event [event]
  (let [path (deref storage-path)]
    (if (nil? path)
      true
      (let [encoded (json_str event)
            envelope {"version" afj-wal-version
                      "length" (count encoded)
                      "checksum" (sha256 encoded)
                      "body" event}
            line (json_str envelope)]
        (if (> (count line) afj-wal-record-limit)
          (throw "WAL_RECORD_TOO_LARGE")
          (file_append path (str line "\n")))))))

(defn append-wal [event]
  (if (not (deref replaying))
    (do
      (swap! wal conj event)
      (persist-wal-event event))
    nil))

(defn require-table [name]
  (let [table (get (deref catalog) name)]
    (if (nil? table)
      (throw (str "table not found: " name))
      table)))

(defn create-table [name columns]
  (if (has-key? (deref catalog) name)
    (throw (str "table already exists: " name))
    (do
      (swap! catalog assoc name {"name" name "columns" columns "rows" []})
      (append-wal {"op" "create-table" "name" name "columns" columns})
      name)))

(defn insert-row [name row]
  (let [table (require-table name)
        rows (get table "rows")
        updated (assoc table "rows" (conj rows row))]
    (swap! catalog assoc name updated)
    (append-wal {"op" "insert" "name" name "row" row})
    row))

(defn select-all [name]
  (get (require-table name) "rows"))

(defn select-where [name column expected]
  (filter (fn [row] (= (get row column) expected)) (select-all name)))

(defn update-where [name column expected changes]
  (let [table (require-table name)
        rows (map (fn [row]
                    (if (= (get row column) expected)
                      (obj-merge row changes)
                      row))
                  (get table "rows"))
        updated (assoc table "rows" rows)]
    (swap! catalog assoc name updated)
    (append-wal {"op" "update" "name" name "column" column
                 "expected" expected "changes" changes})
    rows))

(defn delete-where [name column expected]
  (let [table (require-table name)
        rows (filter (fn [row] (not (= (get row column) expected)))
                     (get table "rows"))
        updated (assoc table "rows" rows)]
    (swap! catalog assoc name updated)
    (append-wal {"op" "delete" "name" name "column" column "expected" expected})
    rows))

(defn apply-wal-event [event]
  (let [op (get event "op")]
    (if (= op "create-table")
      (create-table (get event "name") (get event "columns"))
      (if (= op "insert")
        (insert-row (get event "name") (get event "row"))
        (if (= op "update")
          (update-where (get event "name") (get event "column")
                        (get event "expected") (get event "changes"))
          (if (= op "delete")
            (delete-where (get event "name") (get event "column")
                          (get event "expected"))
            (throw (str "unknown WAL operation: " op))))))))

(defn replay-wal [events]
  (reset! catalog {})
  (reset! replaying true)
  (doseq [event events]
    (apply-wal-event event))
  (reset! replaying false)
  (reset! wal events)
  (count events))

(defn valid-wal-envelope? [record]
  (let [body (get record "body")
        encoded (if (nil? body) nil (json_str body))
        length (get record "length")]
    (and (= (get record "version") afj-wal-version)
         (not (nil? body))
         (number? length)
         (>= length 0)
         (<= length afj-wal-record-limit)
         (= length (count encoded))
         (= (get record "checksum") (sha256 encoded)))))

(defn load-wal-events-at [lines index final-newline events]
  (if (>= index (count lines))
    events
    (let [line (get lines index)
          last-line (= index (- (count lines) 1))
          parsed (try
                   (json-parse line)
                   (catch [error] nil))]
      (if (nil? parsed)
        (if (and last-line (not final-newline))
          events
          (throw "WAL_CORRUPT"))
        (if (not (valid-wal-envelope? parsed))
          (throw "WAL_CORRUPT")
          (load-wal-events-at lines (+ index 1) final-newline
                              (conj events (get parsed "body"))))))))

(defn load-wal-events [path]
  (if (not (file_exists path))
    []
    (let [raw (file_read path)
          lines (filter (fn [line] (not (= (str_trim line) "")))
                        (str_lines raw))]
      (load-wal-events-at lines 0 (str_ends_with raw "\n") []))))

(defn open-store [path]
  (if (not (file_exists path))
    (file_write path "")
    true)
  (reset! storage-path path)
  (replay-wal (load-wal-events path))
  path)

(defn close-store []
  (reset! storage-path nil)
  true)

(defn checkpoint [path]
  (file_write path
              (str_join_lines
                (map (fn [event]
                       (let [encoded (json_str event)]
                         (json_str {"version" afj-wal-version
                                   "length" (count encoded)
                                   "checksum" (sha256 encoded)
                                   "body" event})))
                     (deref wal))))
  true)

(defn page-smoke-test []
  (let [path "/tmp/afj-db95-page-test"
        expected {"table" "users" "rows" [{"id" 1 "name" "Kim"}]}]
    (write-page path expected)
    (assert-equal "page roundtrip" expected (read-page path))
    (file_delete path)
    (println "afj-db95 page PASS")))

(defn page-set-smoke-test []
  (let [path "/tmp/afj-db95-page-set-test"
        padding (str_join (repeat 3000 "payload") "")
        padded {"table" "large_users"
                "rows" [{"id" 1 "name"
                          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}
                         {"id" 2 "name"
                          "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"}]
                "padding" padding}]
    (write-page-set path padded)
    (reset! afj-page-cache {})
    (let [restored (read-page-set-cached path)]
      (if (and (= (get restored "table") "large_users")
               (= (count (get restored "rows")) 2)
               (= (get restored "padding") padding)
               (<= (count (deref afj-page-cache)) afj-page-cache-max))
        (println "PASS page set roundtrip")
        (throw "page set roundtrip mismatch")))
    (let [raw (file_read path)]
      (file_write path (str (str_slice raw 0 (- (count raw) 2)) "x\n")))
    (try
      (do
        (read-page-set-cached path)
        (throw "corrupt page set was accepted"))
      (catch [error]
        (if (= (error_message error) "PAGE_SET_CORRUPT")
          (println "afj-db95 page set corruption PASS")
          (throw error))))
    (file_delete path)
    (println "afj-db95 page set PASS")))

(defn durable-wal-smoke-test []
  (let [path "/tmp/afj-db95-wal-test"]
    (if (file_exists path) (file_delete path) true)
    (open-store path)
    (create-table "durable_users" {"id" "INTEGER" "name" "TEXT"})
    (insert-row "durable_users" {"id" 1 "name" "Kim"})
    (close-store)
    (open-store path)
    (assert-equal "durable WAL replay" 1
                  (count (select-all "durable_users")))
    (close-store)
    (file_delete path)
    (println "afj-db95 durable WAL PASS")))

(defn corrupt-wal-smoke-test []
  (let [path "/tmp/afj-db95-corrupt-wal"]
    (file_write path "{not-json}\n")
    (try
      (do
        (load-wal-events path)
        (throw "corrupt WAL was accepted"))
      (catch [error]
        (if (regex_match_i (error_message error) "WAL_CORRUPT")
          (println "afj-db95 corrupt WAL PASS")
          (throw error))))
    (file_delete path)))

(defn torn-wal-smoke-test []
  (let [path "/tmp/afj-db95-torn-wal"]
    (if (file_exists path) (file_delete path) true)
    (open-store path)
    (create-table "torn_users" {"id" "INTEGER"})
    (insert-row "torn_users" {"id" 1})
    (close-store)
    (file_append path "{\"version\":1,\"length\":")
    (open-store path)
    (assert-equal "torn WAL keeps committed rows" 1
                  (count (select-all "torn_users")))
    (close-store)
    (file_delete path)
    (println "afj-db95 torn WAL PASS")))

(defn oversized-wal-smoke-test []
  (let [path "/tmp/afj-db95-oversized-wal"
        padding (str_join (repeat (+ afj-wal-record-limit 1) "x") "")
        body {"op" "test" "padding" padding}
        encoded (json_str body)
        envelope {"version" afj-wal-version
                  "length" (count encoded)
                  "checksum" (sha256 encoded)
                  "body" body}]
    (file_write path (str (json_str envelope) "\n"))
    (try
      (do
        (load-wal-events path)
        (throw "oversized WAL was accepted"))
      (catch [error]
        (if (regex_match_i (error_message error) ".*WAL_CORRUPT.*")
          (println "afj-db95 oversized WAL PASS")
          (throw error))))
    (file_delete path)))

(defn assert-equal [label expected actual]
  (if (= expected actual)
    (println (str "PASS " label))
    (throw (str "FAIL " label " expected=" expected " actual=" actual))))

(defn smoke-test []
  (create-table "users" {"id" "INTEGER PRIMARY KEY" "name" "TEXT" "age" "INTEGER"})
  (insert-row "users" {"id" 1 "name" "Kim" "age" 30})
  (insert-row "users" {"id" 2 "name" "Lee" "age" 25})
  (assert-equal "insert count" 2 (count (select-all "users")))
  (assert-equal "where" 1 (count (select-where "users" "name" "Kim")))
  (update-where "users" "id" 1 {"age" 31})
  (assert-equal "update" 31 (get (first (select-where "users" "id" 1)) "age"))
  (delete-where "users" "id" 2)
  (assert-equal "delete" 1 (count (select-all "users")))
  (let [events (deref wal)]
    (replay-wal events)
    (assert-equal "wal replay" 1 (count (select-all "users")))
    (assert-equal "wal replay value" 31
                  (get (first (select-where "users" "id" 1)) "age")))
  (println "afj-db95 M0 PASS"))

(smoke-test)
(page-smoke-test)
(page-set-smoke-test)
(durable-wal-smoke-test)
(corrupt-wal-smoke-test)
(torn-wal-smoke-test)
(oversized-wal-smoke-test)
